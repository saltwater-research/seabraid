+#ifdef LLAMA_SEABRAID_GGML
+static bool seabraid_qwen3_experts(const llm_graph_context & graph, llm_ffn_op_type op, int il,
+                               std::initializer_list<ggml_tensor *> variants) {
+    // Start with one model and leave variant semantics in the stock graph.
+    if (graph.model.arch != LLM_ARCH_QWEN3MOE || op != LLM_FFN_SILU || il < 0) {
+        return false;
+    }
+    if (!graph.loras->empty() || graph.hparams.swiglu_clamp_exp[il] > 1e-6f) {
+        return false;
+    }
+    for (const auto * variant : variants) {
+        if (variant) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static ggml_tensor * seabraid_qwen3_ffn(const llm_graph_context & graph, seabraid_ggml_layer layer,
+                                    ggml_tensor * cur, ggml_tensor * ids, ggml_tensor * weights,
+                                    llm_ffn_op_type op, int il, std::initializer_list<ggml_tensor *> variants) {
+    if (!seabraid_qwen3_experts(graph, op, il, variants)) {
+        return nullptr;
+    }
+    const auto nodes = seabraid_ggml_append_swiglu(graph.ctx0, graph.gf, layer, cur, ids, weights,
+                                              graph.hparams.n_expert_used(il));
+    if (!nodes.output) {
+        return nullptr;
+    }
+    graph.cb(nodes.up, "ffn_moe_up", il);
+    graph.cb(nodes.gate, "ffn_moe_gate", il);
+    graph.cb(nodes.swiglu, "ffn_moe_swiglu", il);
+    graph.cb(nodes.down, "ffn_moe_down", il);
+    graph.cb(nodes.weighted, "ffn_moe_weighted", il);
+    graph.cb(nodes.output, "ffn_moe_out", il);
+    return nodes.output;
+}
+#endif
