 # External expert helpers (seabraid): an out-of-process helper serves the remote expert tier over a
 # shared-memory channel (include/strata/seabraid/channel.hpp), so a GPU of another vendor can hold experts.  The helper's own
 # sources live in the seabraid checkout; empty = not built.
+set(STRATA_SEABRAID_SOURCE_DIR "" CACHE PATH "Seabraid checkout for the optional private Qwen decode tier")
+if(STRATA_SEABRAID_SOURCE_DIR)
+  if(NOT TARGET strata_engine OR NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
+    message(FATAL_ERROR "STRATA_SEABRAID_SOURCE_DIR requires the Linux Strata GPU engine")
+  endif()
+  set(SEABRAID_EMBED_STRATA_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}")
+  set(SEABRAID_EMBED_STRATA_GEOMETRY "${_strata_geo_out}")
+  set(SEABRAID_EMBED_STRATA_TESTING "${STRATA_BUILD_TESTS}")
+  set(SEABRAID_EMBED_STRATA_WINDOW "${_strata_window_max_t}")
+  set(SEABRAID_BUILD_STRATA_ADAPTER ON)
+  add_subdirectory("${STRATA_SEABRAID_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/seabraid")
+  # generate.cpp (target strata) includes the placement driver and the private rung: it links them for their include paths too.
+  target_link_libraries(strata_engine PRIVATE seabraid_strata_runtime)
+  if(TARGET strata)
+    target_link_libraries(strata PRIVATE seabraid_strata_runtime seabraid_strata_placement_driver)
+  endif()
+  target_compile_definitions(strata_engine PUBLIC STRATA_HAVE_SEABRAID=1)
+endif()
+
 set(SEABRAID_STRATA_SOURCE_DIR "" CACHE PATH "seabraid checkout that provides the external expert helper (empty: none)")
