--- /dev/null
+++ b/include/strata/core/seabraid_checkpoint.hpp
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <filesystem>
+#include <string>
+#include <system_error>
+
+namespace strata::core {
+
+// Old environment settings may confirm the engine's checkpoint, but a second
+// checkpoint with the same geometry could silently supply different weights.
+inline bool seabraid_checkpoint_matches(const std::string& selected, const char* supplied,
+                                   const char* variable, std::string& error) {
+    if (!supplied) return true;
+    if (selected.empty() && *supplied == '\0') return true;
+
+    std::error_code fs_error;
+    if (std::filesystem::equivalent(selected, supplied, fs_error) && !fs_error) return true;
+
+    error = std::string("Seabraid Qwen ") + variable + " must identify the engine's checkpoint path";
+    if (!selected.empty()) error += " (" + selected + ")";
+    return false;
+}
+
+inline bool validate_seabraid_checkpoint(const std::string& pack, const std::string& native,
+                                     const char* pack_override, const char* native_override,
+                                     std::string& error) {
+    return seabraid_checkpoint_matches(pack, pack_override, "SEABRAID_QWEN_PACK", error) &&
+           seabraid_checkpoint_matches(native, native_override, "SEABRAID_QWEN_NATIVE", error);
+}
+
+}  // namespace strata::core
