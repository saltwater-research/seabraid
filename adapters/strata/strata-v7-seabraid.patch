+#include <string>
+#include <system_error>
+
+namespace fs = std::filesystem;
+
+namespace {
+
+class Fixture {
+public:
+    Fixture() : root(fs::temp_directory_path() /
+                     ("strata-seabraid-checkpoint-" + std::to_string(
+                         std::chrono::steady_clock::now().time_since_epoch().count()))) {
+        if (!fs::create_directory(root)) throw std::runtime_error("cannot create a unique checkpoint fixture");
+    }
+
+    ~Fixture() {
+        std::error_code ignored;
+        fs::remove_all(root, ignored);
+    }
+
+    const fs::path root;
+};
+
+bool expect_paths(const std::string& pack, const std::string& native, const char* pack_override,
+                  const char* native_override, const char* rejected_variable) {
+    std::string error;
+    const bool valid = strata::core::validate_seabraid_checkpoint(pack, native, pack_override, native_override, error);
+    if (rejected_variable ? !valid && error.find(rejected_variable) != std::string::npos : valid && error.empty()) {
+        return true;
+    }
+    std::fprintf(stderr, "checkpoint case expected %s, got %s\n",
+                 rejected_variable ? rejected_variable : "acceptance", valid ? "acceptance" : error.c_str());
+    return false;
+}
+
+}  // namespace
+
+int main() {
+    const Fixture fixture;
+    const auto& root = fixture.root;
+    const auto pack = (root / "engine-pack").string();
+    const auto other_pack = (root / "other-pack").string();
+    const auto pack_alias = (root / "alias-pack").string();
+    const auto native = (root / "engine.gguf").string();
+    const auto other_native = (root / "other.gguf").string();
+    const auto native_alias = (root / "alias.gguf").string();
+    const auto missing = (root / "missing").string();
+
+    fs::create_directory(pack);
+    fs::create_directory(other_pack);
+    // Identical file size is insufficient to distinguish two checkpoints.
+    std::ofstream(native) << 'A';
+    std::ofstream(other_native) << 'B';
+    fs::create_directory_symlink(pack, pack_alias);
+    fs::create_symlink(native, native_alias);
+
+    const struct {
+        const char* native;
+        const char* pack_override;
+        const char* native_override;
+        const char* rejected_variable;
+    } cases[] = {
+        {native.c_str(), nullptr, nullptr, nullptr},
+        {native.c_str(), pack.c_str(), native.c_str(), nullptr},
+        {native.c_str(), pack_alias.c_str(), native_alias.c_str(), nullptr},
+        {"", nullptr, "", nullptr},
+        {native.c_str(), other_pack.c_str(), nullptr, "SEABRAID_QWEN_PACK"},
+        {native.c_str(), missing.c_str(), nullptr, "SEABRAID_QWEN_PACK"},
+        {native.c_str(), "", nullptr, "SEABRAID_QWEN_PACK"},
+        {native.c_str(), nullptr, other_native.c_str(), "SEABRAID_QWEN_NATIVE"},
+        {native.c_str(), nullptr, missing.c_str(), "SEABRAID_QWEN_NATIVE"},
+        {"", nullptr, native.c_str(), "SEABRAID_QWEN_NATIVE"},
+    };
+    for (const auto& test : cases)
+        if (!expect_paths(pack, test.native, test.pack_override, test.native_override, test.rejected_variable))
