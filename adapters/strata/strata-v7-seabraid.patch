+
+IoStatus FallbackRung::replace(int32_t layer, int32_t old_e, int32_t new_e, const std::vector<uint8_t>& bytes, std::string& err) {
+    if (old_e == new_e || bytes.size() != (size_t) strata::kernels::cpu::expert_layout().blob_bytes(layer)) {
+        err = "the fallback takes one same-layer swap of a whole blob";
+        return IoStatus::kRefused;
+    }
+    if (src_.ram_queued(layer, old_e) || src_.ram_queued(layer, new_e)) {   // a RAM_ADAPT2 read owns that place this window
+        err = "a RAM read is queued for layer " + std::to_string(layer) + " expert " + std::to_string(old_e) + " or " + std::to_string(new_e);
+        return IoStatus::kRefused;
+    }
+    // WHY ACK without touching RAM otherwise: F serves every cell from the pack, so "F now serves new" is already true;
+    // a failed install below leaves the copy exactly as it was (install_resident is one copy into a 1:1 place, or nothing).
+    if (excludes_helper_ram_ && src_.has_resident(layer, old_e) && !src_.has_resident(layer, new_e) &&
+        src_.replace_resident_from(layer, new_e, old_e, bytes.data()))
+        ++ram_installs_;
+    return IoStatus::kOk;
+}
