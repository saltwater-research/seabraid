+#include "strata/core/remote_expert_opt.hpp"
+
+#include <algorithm>
+#include <cstdlib>
+#endif
+
+namespace strata::core {
+
+void RemoteExperts::SeabraidDelete::operator()(seabraid::strata_adapter::QwenDecodeTier* ptr) const noexcept {
+#if defined(STRATA_HAVE_SEABRAID)
+    delete ptr;
+#else
+    (void) ptr;
+#endif
+}
+
+#if defined(STRATA_HAVE_SEABRAID)
+namespace {
+
+bool valid_placement(int slots, int64_t layers, int64_t experts, size_t claimed_count) {
+    constexpr auto g = kCompiledGeometry;
+    return slots > 0 && layers == g.n_layers && experts == g.n_expert &&
+           claimed_count == size_t(g.n_layers) * g.n_expert;
+}
+
+seabraid::strata_adapter::PrivateQwenPlan select_plan(
+    int slots, const std::vector<std::pair<int32_t, int32_t>>& ranked,
+    const ExpertCache& primary, const std::vector<uint8_t>& claimed) {
+    constexpr auto g = kCompiledGeometry;
+    seabraid::strata_adapter::PrivateQwenPlan plan{};
+    auto seen = claimed;
+    for (const auto& [layer, expert] : ranked) {
+        if (layer < 0 || layer >= g.n_layers || expert < 0 || expert >= g.n_expert) continue;
+        const size_t index = size_t(layer) * g.n_expert + expert;
+        if (seen[index] || primary.slot_of(layer, expert) >= 0) continue;
+        seen[index] = 1;
+        plan.ranked.push_back({layer, expert});
+        if (plan.ranked.size() == size_t(slots)) break;
+    }
+    plan.slots = static_cast<int32_t>(plan.ranked.size());
+    return plan;
+}
+
+}  // namespace
+
+bool RemoteExperts::open_seabraid(const char* helper, const std::string& pack, const std::string& native,
+                              int slots, int64_t layers, int64_t experts,
+                              const std::vector<std::pair<int32_t, int32_t>>& ranked,
+                              const ExpertCache& primary, std::vector<uint8_t>& claimed, std::string& err) {
+    if (kCompiledGeometry.n_expert_used != RemoteExpertOpt::routing_width()) {
+        err = "Seabraid Qwen requires the compiled top-k to match Strata's weighted reducer";
+        return false;
+    }
+    if (pack.empty() || !valid_placement(slots, layers, experts, claimed.size())) {
+        err = "Seabraid Qwen needs an engine pack, explicit slots and matching compiled geometry";
+        return false;
+    }
+    if (!validate_seabraid_checkpoint(pack, native, std::getenv("SEABRAID_QWEN_PACK"),
+                                  std::getenv("SEABRAID_QWEN_NATIVE"), err)) return false;
+
+    const auto plan = select_plan(slots, ranked, primary, claimed);
+    // Keep the engine's spelling because relative native shard lookup depends on the first shard's directory.
+    const seabraid::strata_adapter::PrivateQwenLaunch launch{helper ? helper : "", pack, native, 0, 60000, 1800000};
+    auto tier = seabraid::strata_adapter::QwenDecodeTier::start(launch, plan, 30000, err);
+    if (!tier) return false;
+    bl_resident_ = 0;
+    for (const auto& [layer, expert] : plan.ranked) {
+        if (!tier->holds(layer, expert)) continue;
+        claimed[size_t(layer) * kCompiledGeometry.n_expert + expert] = 1;
+        ++bl_resident_;
+    }
+    seabraid_.reset(tier.release());
+    return true;
+}
+
+void RemoteExperts::disable_seabraid() noexcept {
+    if (seabraid_) seabraid_->disable();
+    bl_resident_ = 0;
+}
+
+bool RemoteExperts::seabraid_holds(int64_t layer, int32_t expert) const {
+    return seabraid_->holds(layer, expert);
+}
+
+bool RemoteExperts::seabraid_begin(int64_t layer, const float* x, const int32_t* ids, int64_t n_tok,
+                               int64_t k, const int32_t* kind, const int32_t* primary_res, std::string& err) {
+    const float* weights = remote_opt_ && remote_opt_->active() ? remote_opt_->weights_ : nullptr;
+    if (weights && remote_opt_->tokens_ != n_tok) {
+        err = "Seabraid Qwen window disagrees with Strata's weighted reducer";
+        return false;
+    }
+    return seabraid_->begin(layer, x, ids, weights, n_tok, k, kind, primary_res, err);
+}
+
+bool RemoteExperts::seabraid_finish(std::string& err) {
+    const float* weighted = nullptr;
+    if (!seabraid_->finish(weighted, err)) return false;
+    if (weighted) remote_opt_->accumulate(weighted, *this);
+    return true;
+}
+
+bool RemoteExperts::seabraid_owns(size_t index) const {
+    return seabraid_->owns(index);
+}
+#else
+bool RemoteExperts::open_seabraid(const char*, const std::string&, const std::string&, int, int64_t, int64_t,
+                              const std::vector<std::pair<int32_t, int32_t>>&, const ExpertCache&,
+                              std::vector<uint8_t>&, std::string& err) {
+    err = "SEABRAID_QWEN_HELPER requires a build with STRATA_SEABRAID_SOURCE_DIR";
+    return false;
+}
+void RemoteExperts::disable_seabraid() noexcept {}
+bool RemoteExperts::seabraid_holds(int64_t, int32_t) const { return false; }
+bool RemoteExperts::seabraid_begin(int64_t, const float*, const int32_t*, int64_t, int64_t,
+                               const int32_t*, const int32_t*, std::string&) { return false; }
+bool RemoteExperts::seabraid_finish(std::string&) { return false; }
+bool RemoteExperts::seabraid_owns(size_t) const { return false; }
+#endif
+
+// Placement routing (adapters/strata/executor_view.hpp), shared by both builds: a build without Seabraid never attaches a view.
+bool RemoteExperts::physically_holds(int64_t layer, int32_t expert) const {
+#if defined(STRATA_HAVE_SEABRAID)
+    if (seabraid_) return seabraid_->held(layer, expert);
+#endif
+    // A CLOSED card (fail closed: a tier round timed out or tore a slot) holds nothing as far as routing goes.
+    return bl_closed_.load(std::memory_order_relaxed) == 0 && layer >= 0 && expert >= 0 && expert < n_expert_ &&
+           (size_t) layer * (size_t) n_expert_ + (size_t) expert < bl_held_.size() &&
+           bl_held_[(size_t) layer * (size_t) n_expert_ + (size_t) expert] != 0;
+}
+
+void RemoteExperts::attach_view(const seabraid::strata_adapter::ExecutorView* view, uint8_t rung) noexcept {
+#if defined(STRATA_HAVE_SEABRAID)
+    if (seabraid_) { seabraid_->attach_view(view, rung); return; }   // the private tier gates its own holds()
+    exec_view_ = view;
+    exec_rung_ = rung;
+#else
+    (void) view; (void) rung;
+#endif
+}
+
+#if defined(STRATA_HAVE_SEABRAID)
+bool RemoteExperts::view_routes(int64_t layer, int32_t expert) const { return exec_view_->routes_to(layer, expert, exec_rung_); }
+bool RemoteExperts::view_open() const { return exec_view_->rung_open(exec_rung_); }
+#else
+bool RemoteExperts::view_routes(int64_t, int32_t) const { return true; }
+bool RemoteExperts::view_open() const { return true; }
+#endif
+
+}  // namespace strata::core
