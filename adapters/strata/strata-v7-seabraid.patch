+IoStatus FallbackRung::stage(int32_t layer, int32_t expert, std::vector<uint8_t>& out, std::string& err) {
+    out.resize((size_t) strata::kernels::cpu::expert_layout().blob_bytes(layer));
+    const bool ram = src_.has_resident(layer, expert);
+    if (!src_.copy_blob(layer, expert, out.data())) {   // a read touches nothing: refused
+        err = "the engine could not read layer " + std::to_string(layer) + " expert " + std::to_string(expert);
+        out.clear();
+        return IoStatus::kRefused;
+    }
+    ++(ram ? ram_hits_ : file_reads_);
+    return IoStatus::kOk;
