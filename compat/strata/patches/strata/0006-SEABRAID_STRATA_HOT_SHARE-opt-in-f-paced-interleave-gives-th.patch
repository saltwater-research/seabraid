diff --git a/tests/program/seabraid_hot_share_test.cpp b/tests/program/seabraid_hot_share_test.cpp
new file mode 100644
index 000000000..6fa1395fb
--- /dev/null
+++ b/tests/program/seabraid_hot_share_test.cpp
@@ -0,0 +1,188 @@
+// tests/program/seabraid_hot_share_test.cpp - SEABRAID_STRATA_HOT_SHARE: the f-paced interleave of the expert ranking
+// (include/strata/program/seabraid_hot_share.hpp).  Host only.  The two real consumers are re-enacted here as they are
+// written in the engine: the primary's sized-slot loop (walk the order, stop at the first pair over budget or at
+// n_primary) and RemoteExperts::seabraid_open (walk the ORIGINAL ranking, skip what the primary holds, stop at the
+// first pair over budget).  The checks: the two sides are disjoint, the helper's walk lands exactly on its planned
+// picks, f = 0 is today's fill, and the hot ranks are shared ~f.
+#include "strata/program/seabraid_hot_share.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+using strata::program::hot_share_parse;
+using strata::program::hot_share_split;
+using Pair = std::pair<int32_t, int32_t>;
+
+namespace {
+int g_fail = 0;
+void check(bool ok, const std::string& what) {
+    if (ok) return;
+    std::fprintf(stderr, "FAIL: %s\n", what.c_str());
+    ++g_fail;
+}
+
+// a ranking over every (layer, expert) of L x E, in a fixed shuffled order (layers interleaved, as a real profile's are)
+std::vector<Pair> make_ranking(int32_t L, int32_t E) {
+    std::vector<Pair> out;
+    for (int32_t l = 0; l < L; ++l)
+        for (int32_t e = 0; e < E; ++e) out.emplace_back(l, e);
+    uint64_t x = 0x9E3779B97F4A7C15ull;
+    for (size_t i = out.size(); i > 1; --i) {   // Fisher-Yates with a fixed xorshift
+        x ^= x << 13; x ^= x >> 7; x ^= x << 17;
+        std::swap(out[i - 1], out[(size_t) (x % i)]);
+    }
+    return out;
+}
+
+struct Sim {
+    std::set<Pair> primary, helper;
+};
+
+// primary: the engine's sized-slot loop over `order`, capped at n_primary; helper: seabraid_open over `ranked`
+template <class PC, class HC>
+Sim simulate(const std::vector<Pair>& ranked, const std::vector<Pair>& order, int64_t n_primary, PC pcost, uint64_t pcap,
+             HC hcost, uint64_t hcap) {
+    Sim s;
+    uint64_t used = 0;
+    for (const auto& p : order) {
+        if (used + pcost(p.first) > pcap) break;
+        if ((int64_t) s.primary.size() >= n_primary) break;
+        used += pcost(p.first);
+        s.primary.insert(p);
+    }
+    uint64_t need = 0;
+    for (const auto& p : ranked) {
+        if (s.primary.count(p) || s.helper.count(p)) continue;
+        if (need + hcost(p.first) > hcap) break;
+        s.helper.insert(p);
+        need += hcost(p.first);
+    }
+    return s;
+}
+
+void test_parse() {
+    double f;
+    bool a;
+    std::string why;
+    check(!hot_share_parse(nullptr, f, a, why), "unset is off");
+    check(!hot_share_parse("", f, a, why), "empty is off");
+    check(hot_share_parse("0.45", f, a, why) && !a && f == 0.45, "0.45 parses");
+    check(hot_share_parse("0", f, a, why) && f == 0.0, "0 parses");
+    check(hot_share_parse("1", f, a, why) && f == 1.0, "1 parses");
+    check(hot_share_parse("auto", f, a, why) && a, "auto parses");
+    check(!hot_share_parse("1.5", f, a, why), "1.5 refused");
+    check(!hot_share_parse("-0.1", f, a, why), "negative refused");
+    check(!hot_share_parse("0.4x", f, a, why), "trailing junk refused");
+    check(!hot_share_parse("nan", f, a, why), "nan refused");
+}
+
+void test_uniform(double f) {
+    const int32_t L = 48, E = 512;   // 24,576 pairs, the model's shape
+    const auto ranked = make_ranking(L, E);
+    auto cost = [](int32_t) -> uint64_t { return 100; };
+    const uint64_t pcap = 13466 * 100, hcap = 11110 * 100;   // the measured IQ3_S all-VRAM counts
+    const auto sp = hot_share_split(ranked, L, E, f, cost, pcap, INT64_MAX, cost, hcap, INT64_MAX);
+    const std::string tag = "f=" + std::to_string(f) + ": ";
+    check(sp.order.size() == ranked.size(), tag + "order keeps every pair");
+    check(sp.n_primary == 13466 && sp.n_helper == 11110, tag + "both sides filled to capacity (" +
+          std::to_string(sp.n_primary) + ", " + std::to_string(sp.n_helper) + ")");
+    const Sim s = simulate(ranked, sp.order, sp.n_primary, cost, pcap, cost, hcap);
+    int64_t both = 0;
+    for (const auto& p : s.primary) both += s.helper.count(p) ? 1 : 0;
+    check(both == 0, tag + "disjoint");
+    check((int64_t) s.primary.size() == sp.n_primary, tag + "primary fill lands on n_primary");
+    check((int64_t) s.helper.size() == sp.n_helper, tag + "helper walk lands on n_helper");
+    for (int64_t i = sp.n_primary; i < sp.n_primary + sp.n_helper; ++i)
+        if (!s.helper.count(sp.order[(size_t) i])) { check(false, tag + "a planned helper pick the helper did not take"); break; }
+    // the hot ranks: the first 2000 split ~f (exact pacing: |helper - f*2000| <= 1) while both sides are open
+    int64_t h_top = 0;
+    for (size_t i = 0; i < 2000; ++i) h_top += s.helper.count(ranked[i]) ? 1 : 0;
+    const double want = f * 2000.0;
+    check(h_top >= (int64_t) want - 1 && h_top <= (int64_t) want + 1,
+          tag + "top-2000 helper share " + std::to_string(h_top) + " vs " + std::to_string(want));
+}
+
+void test_f0_is_today() {
+    const int32_t L = 8, E = 64;
+    const auto ranked = make_ranking(L, E);
+    auto cost = [](int32_t l) -> uint64_t { return 100 + (uint64_t) (l % 3) * 30; };   // per-layer blob sizes
+    const uint64_t pcap = 250 * 110, hcap = 180 * 110;
+    const auto sp = hot_share_split(ranked, L, E, 0.0, cost, pcap, INT64_MAX, cost, hcap, INT64_MAX);
+    // today's primary: the ranking until the first pair over budget
+    uint64_t used = 0;
+    int64_t today = 0;
+    for (const auto& p : ranked) { if (used + cost(p.first) > pcap) break; used += cost(p.first); ++today; }
+    check(sp.n_primary == today, "f=0: the primary takes today's prefix (" + std::to_string(sp.n_primary) + " vs " +
+                                 std::to_string(today) + ")");
+    bool same = true;
+    for (int64_t i = 0; i < today; ++i) same = same && sp.order[(size_t) i] == ranked[(size_t) i];
+    check(same, "f=0: in today's order");
+}
+
+void test_helper_full_first() {
+    const int32_t L = 4, E = 50;
+    const auto ranked = make_ranking(L, E);
+    auto cost = [](int32_t) -> uint64_t { return 10; };
+    const auto sp = hot_share_split(ranked, L, E, 0.5, cost, 150 * 10, INT64_MAX, cost, 20 * 10, INT64_MAX);
+    check(sp.n_helper == 20 && sp.helper_full, "helper full first: 20 picks");
+    check(sp.n_primary == 150 && sp.primary_full, "then the primary keeps taking ranks to its 150");
+    const Sim s = simulate(ranked, sp.order, sp.n_primary, cost, 150 * 10, cost, 20 * 10);
+    check((int64_t) s.helper.size() == 20 && (int64_t) s.primary.size() == 150, "helper-full-first lands as planned");
+    for (const auto& p : s.primary) check(!s.helper.count(p), "helper-full-first disjoint");
+}
+
+void test_primary_full_first_and_slots() {
+    const int32_t L = 4, E = 50;
+    const auto ranked = make_ranking(L, E);
+    auto cost = [](int32_t) -> uint64_t { return 10; };
+    // helper count cap (a numeric --expert-cache-device1) honoured
+    const auto sp = hot_share_split(ranked, L, E, 0.5, cost, 30 * 10, INT64_MAX, cost, UINT64_MAX, 100);
+    check(sp.n_primary == 30 && sp.n_helper == 100, "primary full first, helper to its slot cap");
+    const auto sp2 = hot_share_split(ranked, L, E, 0.5, cost, UINT64_MAX, 40, cost, UINT64_MAX, 1000);
+    check(sp2.n_primary == 40, "primary slot cap honoured");
+}
+
+void test_varying_sizes_disjoint() {
+    const int32_t L = 48, E = 512;
+    const auto ranked = make_ranking(L, E);
+    auto pcost = [](int32_t l) -> uint64_t { return 2000 + (uint64_t) ((l * 37) % 5) * 300; };
+    auto hcost = [](int32_t l) -> uint64_t { return (2000 + (uint64_t) ((l * 37) % 5) * 300 + 255) / 256 * 256; };
+    for (double f : {0.1, 0.3, 0.45, 0.6, 0.9, 1.0}) {
+        const uint64_t pcap = 9000ull * 2400, hcap = 7000ull * 2400;
+        const auto sp = hot_share_split(ranked, L, E, f, pcost, pcap, INT64_MAX, hcost, hcap, INT64_MAX);
+        const Sim s = simulate(ranked, sp.order, sp.n_primary, pcost, pcap, hcost, hcap);
+        int64_t both = 0;
+        for (const auto& p : s.primary) both += s.helper.count(p) ? 1 : 0;
+        check(both == 0, "varying sizes f=" + std::to_string(f) + ": disjoint");
+        check((int64_t) s.primary.size() == sp.n_primary, "varying sizes f=" + std::to_string(f) + ": primary as planned");
+        // the helper may take MORE than planned (a smaller blob after its first non-fit), never fewer
+        check((int64_t) s.helper.size() >= sp.n_helper, "varying sizes f=" + std::to_string(f) + ": helper >= planned");
+        for (int64_t i = sp.n_primary; i < sp.n_primary + sp.n_helper; ++i)
+            if (!s.helper.count(sp.order[(size_t) i])) { check(false, "varying sizes: a planned helper pick missed"); break; }
+    }
+}
+
+void test_invalid_and_duplicates() {
+    std::vector<Pair> r = {{0, 0}, {0, 1}, {-1, 2}, {0, 1}, {9, 0}, {1, 1}, {1, 0}};
+    auto cost = [](int32_t) -> uint64_t { return 1; };
+    const auto sp = hot_share_split(r, 2, 2, 0.5, cost, 10, INT64_MAX, cost, 10, INT64_MAX);
+    check(sp.order.size() == r.size(), "invalid/duplicate pairs kept (as rest)");
+    check(sp.n_primary + sp.n_helper == 4, "only the 4 distinct valid pairs dealt");
+}
+}  // namespace
+
+int main() {
+    test_parse();
+    for (double f : {0.0, 0.25, 0.45, 0.5}) test_uniform(f);
+    test_f0_is_today();
+    test_helper_full_first();
+    test_primary_full_first_and_slots();
+    test_varying_sizes_disjoint();
+    test_invalid_and_duplicates();
+    if (g_fail == 0) std::printf("seabraid_hot_share_test: all passed\n");
+    return g_fail == 0 ? 0 : 1;
+}
