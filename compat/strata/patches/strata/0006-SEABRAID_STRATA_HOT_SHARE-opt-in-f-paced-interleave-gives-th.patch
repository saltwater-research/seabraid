@@ -0,0 +1,115 @@
+// seabraid hot share (opt-in, SEABRAID_STRATA_HOT_SHARE=<f>|auto): which ranked experts the primary cache fills, so the
+// helper GPU gets a share f of the HOT experts instead of only the ranks the primary leaves over.
+//
+// Today the primary takes the top of the expert profile and the helper (RemoteExperts::seabraid_open) takes "ranked
+// order, nothing the primary holds" - i.e. the colder tail.  Routing is skewed, so a helper holding 45% of the
+// experts measured 13.6% of the expert work.  This walks the ranking hottest-first and deals each pair to one side by
+// f-paced interleave (the helper gets pair n when floor((n+1)f) > helper picks so far), until a side is full; then
+// the other side takes the ranks that follow until it is full too.
+//
+// The result is a FILL ORDER for the primary: its own picks (rank order), then the helper's picks (rank order), then
+// everything neither takes (rank order).  The primary fills only its first `n_primary` entries; the helper is NOT
+// given this list - it keeps walking the original ranking and skipping what the primary holds, which visits exactly
+// its picks first.  So disjointness at load stays the helper's own check (primary.slot_of), not this function's.
+//
+// "Full" is the first pair that does not fit, as both real fills define it (the primary's sized-slot loop and
+// seabraid_open both stop at the first pair over budget).  Header-only and host-testable: no device code.
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace strata::program {
+
+struct HotShareSplit {
+    std::vector<std::pair<int32_t, int32_t>> order;   // primary picks, helper picks, rest (each in rank order)
+    int64_t n_primary = 0;
+    int64_t n_helper = 0;
+    int64_t walked = 0;                               // ranks dealt (n_primary + n_helper; invalid pairs skipped)
+    uint64_t primary_bytes = 0;
+    uint64_t helper_bytes = 0;
+    bool primary_full = false;
+    bool helper_full = false;
+};
+
+// SEABRAID_STRATA_HOT_SHARE's value.  Returns false (with `why`) for anything that is not a number in [0,1] or "auto".
+// `is_auto` set: the caller passes f = helper capacity / (primary + helper capacity).
+inline bool hot_share_parse(const char* v, double& f, bool& is_auto, std::string& why) {
+    f = -1.0;
+    is_auto = false;
+    if (v == nullptr || v[0] == '\0') { why = "unset"; return false; }
+    if (std::string(v) == "auto") { is_auto = true; return true; }
+    char* end = nullptr;
+    const double x = std::strtod(v, &end);
+    if (end == v || *end != '\0' || !std::isfinite(x) || x < 0.0 || x > 1.0) {
+        why = std::string("SEABRAID_STRATA_HOT_SHARE=") + v + ": expected a share in [0,1] or 'auto'";
+        return false;
+    }
+    f = x;
+    return true;
+}
+
+// primary_cost(layer) / helper_cost(layer): the bytes one expert of that layer takes on each side (each side's own
+// rounding).  *_cap: the byte budget.  *_slots: a count cap (INT64_MAX = none).
+template <class PrimaryCost, class HelperCost>
+HotShareSplit hot_share_split(const std::vector<std::pair<int32_t, int32_t>>& ranked, int64_t n_layers, int64_t n_expert,
+                              double f, PrimaryCost primary_cost, uint64_t primary_cap, int64_t primary_slots,
+                              HelperCost helper_cost, uint64_t helper_cap, int64_t helper_slots) {
+    HotShareSplit s;
+    std::vector<std::pair<int32_t, int32_t>> prim, help, rest;
+    prim.reserve(ranked.size());
+    help.reserve(ranked.size());
+    std::vector<uint8_t> seen((size_t) (n_layers > 0 && n_expert > 0 ? n_layers * n_expert : 0), 0);
+    if (f < 0.0) f = 0.0;
+    if (f > 1.0) f = 1.0;
+    bool p_open = primary_slots > 0, h_open = helper_slots > 0;
+    for (const auto& pr : ranked) {
+        const bool valid = pr.first >= 0 && pr.first < n_layers && pr.second >= 0 && pr.second < n_expert;
+        if (valid) {
+            const size_t at = (size_t) pr.first * (size_t) n_expert + (size_t) pr.second;
+            if (seen[at]) { rest.push_back(pr); continue; }   // a duplicate rank: the first one decides
+            seen[at] = 1;
+        }
+        if (!valid || (!p_open && !h_open)) { rest.push_back(pr); continue; }
+        const int64_t n = (int64_t) (prim.size() + help.size());
+        const bool want_helper = (int64_t) std::floor((double) (n + 1) * f) > (int64_t) help.size();
+        bool placed = false;
+        for (int attempt = 0; attempt < 2 && !placed; ++attempt) {
+            const bool to_helper = attempt == 0 ? want_helper : !want_helper;
+            if (to_helper) {
+                if (!h_open) continue;
+                const uint64_t b = (uint64_t) helper_cost(pr.first);
+                if (s.helper_bytes + b > helper_cap) { h_open = false; continue; }
+                help.push_back(pr);
+                s.helper_bytes += b;
+                if ((int64_t) help.size() >= helper_slots) h_open = false;
+                placed = true;
+            } else {
+                if (!p_open) continue;
+                const uint64_t b = (uint64_t) primary_cost(pr.first);
+                if (s.primary_bytes + b > primary_cap) { p_open = false; continue; }
+                prim.push_back(pr);
+                s.primary_bytes += b;
+                if ((int64_t) prim.size() >= primary_slots) p_open = false;
+                placed = true;
+            }
+        }
+        if (!placed) rest.push_back(pr);
+    }
+    s.n_primary = (int64_t) prim.size();
+    s.n_helper = (int64_t) help.size();
+    s.walked = s.n_primary + s.n_helper;
+    s.primary_full = !p_open;
+    s.helper_full = !h_open;
+    s.order.reserve(ranked.size());
+    s.order.insert(s.order.end(), prim.begin(), prim.end());
+    s.order.insert(s.order.end(), help.begin(), help.end());
+    s.order.insert(s.order.end(), rest.begin(), rest.end());
+    return s;
+}
+
+}  // namespace strata::program
