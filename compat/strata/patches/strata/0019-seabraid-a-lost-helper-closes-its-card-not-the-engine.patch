diff --git a/include/strata/core/lost_rows.hpp b/include/strata/core/lost_rows.hpp
new file mode 100644
index 0000000..e21a7c2
--- /dev/null
+++ b/include/strata/core/lost_rows.hpp
@@ -0,0 +1,47 @@
+#pragma once
+// lost_rows.hpp: the pure plan for computing, on the CPU, the rows an expert helper owned and then lost (its process exited,
+// missed the layer deadline or answered wrongly: RemoteExperts::rows_lost()).  No source, no pool, no kernels: only WHICH
+// (expert, token) pairs to compute and which tokens then need a quantised activation.
+//
+// OWNER: the dispatch in expert_source.cpp owns computing an expert on the CPU (source, pool, kernels); this header owns only
+// the grouping, so it can be tested without any of them (tests/core/lost_rows_test.cpp).
+// DEFENCE (D5): the plan lives beside the dispatch and not inside RemoteExperts because RemoteExperts has no source, pool or
+// kernel selection - computing there would be a second owner of CPU expert computation.
+#include <cstdint>
+#include <vector>
+
+namespace strata::core {
+
+struct LostRowsPlan {
+    /// One CPU job: `expert` over the picks in `entries` (entry = token * k + slot), at most `max_t` of them - the kernels and
+    /// the pool's scratch take that many tokens a job, so a longer run of one expert is a further job over the same blob.
+    struct Job { int32_t expert = -1; std::vector<int32_t> entries; };
+    std::vector<Job> jobs;
+    /// Per token: it has a lost pick, so its activation must be quantised (a token whose picks all ran on GPUs may have had
+    /// none quantised: the optimised decode skips it).
+    std::vector<uint8_t> need_act;
+};
+
+/// `lost[i]` (entry i = token * k + slot) marks a pick the helper owned and did not deliver.  Jobs come in first-seen expert
+/// order and entries in ascending order, so the plan is deterministic.  An id outside 0..n_expert-1 is skipped: the caller
+/// has already refused such a window.
+inline void plan_lost_rows(const int32_t* ids, const uint8_t* lost, int64_t n_tok, int64_t k, int64_t n_expert, int max_t,
+                           LostRowsPlan& plan) {
+    plan.jobs.clear();
+    plan.need_act.assign((size_t) n_tok, 0);
+    std::vector<int32_t> open((size_t) n_expert, -1);   // expert -> the job still taking tokens
+    for (int64_t i = 0; i < n_tok * k; ++i) {
+        const int32_t e = ids[i];
+        if (!lost[i] || e < 0 || e >= n_expert) continue;
+        plan.need_act[(size_t) (i / k)] = 1;
+        int32_t& j = open[(size_t) e];
+        if (j < 0 || (int) plan.jobs[(size_t) j].entries.size() >= max_t) {   // the MAXT split (SB5 removes it)
+            j = (int32_t) plan.jobs.size();
+            plan.jobs.emplace_back();
+            plan.jobs.back().expert = e;
+        }
+        plan.jobs[(size_t) j].entries.push_back((int32_t) i);
+    }
+}
+
+}  // namespace strata::core
