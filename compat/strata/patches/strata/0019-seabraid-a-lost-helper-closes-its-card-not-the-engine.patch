diff --git a/tests/core/seabraid_helper_loss_test.cpp b/tests/core/seabraid_helper_loss_test.cpp
new file mode 100644
index 0000000..4f96a44
--- /dev/null
+++ b/tests/core/seabraid_helper_loss_test.cpp
@@ -0,0 +1,341 @@
+// seabraid_helper_loss_test (L1-L9): a helper PROCESS that exits, goes mute or answers wrongly closes its card instead of
+// ending the engine, and a stale or recycled helper identity opens as a closed card (HL-FIX design, Piece B).
+//
+// REAL helpers: each card's helper is a forked child that runs the fake-helper serve loop on a real POSIX shm channel and dies
+// by raise(SIGKILL) when told to (a command word in anonymous shared memory).  The parent NEVER signals a pid: a test that
+// did would be a kill-by-number site of its own.  CPU only: no GPU is touched.
+// Lines tagged NEWAPI are the ones that need the HL-FIX API; the failure-first recipe removes exactly those with a sed and
+// runs the rest against the old engine, where every scenario times out or fails its timing check.
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <csignal>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <memory>
+#include <string>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <vector>
+
+#include "strata/seabraid/channel.hpp"
+#include "strata/seabraid/peer_watch.hpp"   // NEWAPI
+#include "strata/core/expert_cache.hpp"
+#include "strata/core/expert_source.hpp"
+#include "strata/core/remote_experts.hpp"
+#include "strata/kernels/cpu/expert.hpp"
+#include "strata/kernels/cpu/expert_layout.hpp"
+#include "strata/kernels/window_limits.hpp"
+
+namespace bl = seabraid;
+using strata::core::RemoteExperts;
+
+static int g_fail = 0;
+#define CHECK(c) do { if (!(c)) { std::printf("FAIL line %d: %s\n", __LINE__, #c); ++g_fail; } } while (0)
+
+constexpr int H = strata::kernels::cpu::H, K = 10, MAXT = strata::kernels::kWindowMaxT, NL = 3, NE = 16, LAYER = 1;
+constexpr int64_t PF_TOK = 8;
+enum Cmd : int { kRun = 0, kDieIdle, kDieOnRequest, kMute, kDieOnBlob, kDieOnPrefill };
+struct Ctl { std::atomic<int> cmd; };   // lives in MAP_SHARED anonymous memory: the parent talks to the child through it
+
+static double now_s() { return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+static float expert_val(int e, float xj) { return (float) (e + 1) * xj; }
+
+// The child: the fake helper of remote_experts_seabraid_opt_test (per-pick answers) plus the ways to die.  Never returns.
+[[noreturn]] static void child_main(bl::Channel& ch, Ctl* ctl, int announce_delay_ms, bool announce, bool exit_after_announce) {
+    bl::Header* hd = ch.header();
+    if (announce_delay_ms > 0) usleep((useconds_t) announce_delay_ms * 1000);
+    hd->free_gib = 8.0;
+    std::strcpy(hd->helper_name, "fake-helper");
+    if (announce) {
+        bl::announce_identity(*hd);   // NEWAPI: pid + start time BEFORE kHelperUp
+        hd->state.store(bl::kHelperUp, std::memory_order_release);
+    }
+    if (exit_after_announce) _exit(0);
+    while (hd->state.load(std::memory_order_acquire) != bl::kPlanReady) {
+        if (hd->state.load() == bl::kShutdown) _exit(0);
+        usleep(200);
+    }
+    for (int64_t i = 0; i < hd->plan_count; ++i) ch.held()[(size_t) ch.plan()[2 * i] * NE + (size_t) ch.plan()[2 * i + 1]] = 1;
+    hd->resident = hd->plan_count; hd->gib = 0.1;
+    hd->resp_seq.store(hd->req_seq.load(), std::memory_order_release);
+    hd->state.store(bl::kLoaded, std::memory_order_release);
+    uint64_t seen = hd->req_seq.load(), blob_seen = hd->blob_req_seq.load(), pf_done = 0;
+    while (hd->state.load(std::memory_order_acquire) != bl::kShutdown) {
+        const int cmd = ctl->cmd.load();
+        if (cmd == kDieIdle) raise(SIGKILL);
+        if (hd->blob_req_seq.load(std::memory_order_acquire) != blob_seen) {
+            if (cmd == kDieOnBlob) raise(SIGKILL);
+            blob_seen = hd->blob_req_seq.load();
+            hd->blob_ok = 1;
+            for (int i = 0; i < hd->blob_n; ++i) hd->blob_hit[i] = 0;
+            hd->blob_resp_seq.store(blob_seen, std::memory_order_release);
+        }
+        if (ch.pf_pending() != 0 && ch.pf_pending() != pf_done) {
+            if (cmd == kDieOnPrefill) raise(SIGKILL);
+            pf_done = ch.pf_pending();
+        }
+        if (hd->req_seq.load(std::memory_order_acquire) == seen) { usleep(50); continue; }
+        seen = hd->req_seq.load(std::memory_order_acquire);
+        if (cmd == kDieOnRequest) raise(SIGKILL);   // dies holding the request: no answer will ever come
+        if (cmd == kMute) continue;                 // alive, never answers
+        const int T = (int) hd->n_tok;
+        float* out = ch.out();
+        for (int p = 0; p < T * K; ++p) {
+            const int e = ch.ids()[p];
+            if (e < 0) continue;
+            for (int j = 0; j < H; ++j) out[(size_t) p * H + j] = expert_val(e, ch.x()[(p / K) * H + j]);
+        }
+        hd->ok = 1; hd->out_mode = bl::kOutPerPick; hd->out_rows = T * K;
+        hd->resp_seq.store(seen, std::memory_order_release);
+    }
+    _exit(0);
+}
+
+struct Opts { int announce_delay_ms = 0; bool announce = true, exit_after_announce = false, prefill = false; };
+
+// N cards, each with a channel made here and a forked helper.  Fork happens before any engine thread exists.
+struct Rig {
+    struct Card {
+        bl::Channel ch; pid_t pid = -1; Ctl* ctl = nullptr; RemoteExperts re;
+        strata::core::ExpertCache primary; strata::core::FileExpertSource src;
+    };
+    std::vector<std::unique_ptr<Card>> cards;
+    std::vector<uint8_t> claimed = std::vector<uint8_t>((size_t) NL * NE, 0);
+    std::string err;
+
+    Rig(int n, const char* tag, Opts o = {}) {
+        std::string list;
+        for (int c = 0; c < n; ++c) {
+            auto cd = std::make_unique<Card>();
+            const std::string name = "/hlt" + std::to_string(getpid()) + tag + std::to_string(c);
+            std::string e;
+            if (!cd->ch.create(name, H, (int64_t) MAXT * K, NL, NE, (uint32_t) MAXT, (int64_t) strata::kernels::cpu::expert_layout().max_blob, e,
+                               o.prefill ? PF_TOK : 0, o.prefill ? K : 0)) { std::printf("create failed: %s\n", e.c_str()); std::exit(2); }
+            cd->ctl = (Ctl*) mmap(nullptr, sizeof(Ctl), PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+            cd->ctl->cmd = kRun;
+            cd->pid = fork();
+            if (cd->pid == 0) child_main(cd->ch, cd->ctl, o.announce_delay_ms, o.announce, o.exit_after_announce);
+            list += (c ? "," : "") + name;
+            cards.push_back(std::move(cd));
+        }
+        setenv("SEABRAID_STRATA_SHM", list.c_str(), 1);
+    }
+    ~Rig() {
+        for (auto& c : cards) { c->re.close(); c->ch.header()->state.store(bl::kShutdown, std::memory_order_release); }
+        for (auto& c : cards) { if (c->pid > 0) waitpid(c->pid, nullptr, 0); munmap(c->ctl, sizeof(Ctl)); }
+    }
+    void reap(int c) { waitpid(cards[(size_t) c]->pid, nullptr, 0); cards[(size_t) c]->pid = -1; }   // the child is gone; its identity stays in the channel
+    bool wait_state(int c, uint32_t s) { for (int i = 0; i < 4000; ++i) { if (cards[(size_t) c]->ch.header()->state.load() == s) return true; usleep(1000); } return false; }
+    bool open(int c, std::vector<int> experts) {
+        std::vector<std::pair<int32_t, int32_t>> ranked;
+        for (int e : experts) ranked.emplace_back(LAYER, e);
+        Card& cd = *cards[(size_t) c];
+        return cd.re.open(bl::kDeviceBase + c, 5, NL, NE, ranked, cd.primary, cd.src, claimed, err, false);
+    }
+    RemoteExperts& re(int c) { return cards[(size_t) c]->re; }
+    void say(int c, Cmd cmd) { cards[(size_t) c]->ctl->cmd = cmd; }
+};
+
+struct Window {   // T tokens whose picks include experts 2 3 5 (card 0) and 7 9 (card 1) and some nobody holds
+    int T; std::vector<float> x; std::vector<int32_t> ids;
+    explicit Window(int t) : T(t), x((size_t) t * H), ids((size_t) t * K) {
+        for (size_t i = 0; i < x.size(); ++i) x[i] = 0.25f + (float) (i % 5) * 0.5f;
+        const int pool[K] = {2, 11, 3, 5, 12, 7, 9, 13, 14, 15};
+        for (int tk = 0; tk < t; ++tk) for (int i = 0; i < K; ++i) ids[(size_t) (tk * K + i)] = pool[(i + tk) % K];
+    }
+};
+
+static int owned_count(RemoteExperts& re, int n) { int c = 0; for (int i = 0; i < n; ++i) c += re.owns(i) ? 1 : 0; return c; }
+
+// Redirects stderr to a file for the life of the object: the WARN lines are part of the contract.
+struct Capture {
+    int saved, fd; char path[64] = "/tmp/hltXXXXXX";
+    Capture() { fflush(stderr); saved = dup(2); fd = mkstemp(path); dup2(fd, 2); }
+    std::string finish() {
+        fflush(stderr); dup2(saved, 2); close(saved);
+        std::string s; char b[4096]; ssize_t n; lseek(fd, 0, SEEK_SET);
+        while ((n = read(fd, b, sizeof b)) > 0) s.append(b, (size_t) n);
+        close(fd); unlink(path); return s;
+    }
+};
+static int count_of(const std::string& s, const char* needle) { int n = 0; for (size_t p = s.find(needle); p != std::string::npos; p = s.find(needle, p + 1)) ++n; return n; }
+
+// `seabraid_helper_loss_test L3` runs one scenario (the failure-first recipe runs them one by one: each old-engine hang is its own 30 s).
+int main(int argc, char** argv) {
+    auto want = [&](const char* name) { return argc < 2 || std::strcmp(argv[1], name) == 0; };
+    const Window win(4);
+    // ---- L1: the helper dies holding a layer request.  finish() is TRUE within 2 s, the rows are handed back, the card is
+    //      closed (3), and the next layer's begin owns nothing.  (Before: false after 30 s, then the engine exited with code 1.)
+    if (want("L1")) {
+        alarm(20);
+        Rig r(1, "a");
+        CHECK(r.open(0, {2, 3, 5, 7, 9}));
+        r.say(0, kDieOnRequest);
+        std::string err;
+        CHECK(r.re(0).begin(LAYER, win.x.data(), win.ids.data(), win.T, K, nullptr, nullptr, err));
+        CHECK(owned_count(r.re(0), win.T * K) > 0);
+        std::vector<float> rows((size_t) win.T * K * H, -7.0f);
+        const double t0 = now_s();
+        CHECK(r.re(0).finish(rows.data(), err));
+        CHECK(now_s() - t0 < 2.0);
+        CHECK(r.re(0).rows_lost());   // NEWAPI
+        CHECK(r.re(0).seabraid_closed() == 3);
+        CHECK(rows[0] == -7.0f);      // nothing the helper half-wrote reached the caller's rows
+        CHECK(r.re(0).begin(LAYER, win.x.data(), win.ids.data(), win.T, K, nullptr, nullptr, err));
+        CHECK(owned_count(r.re(0), win.T * K) == 0);
+        CHECK(!r.re(0).rows_lost());  // NEWAPI
+        alarm(0);
+    }
+    // ---- L2: the helper dies while IDLE.  The card reads closed within 2 s with no request ever made.  (Before: stays 0.)
+    if (want("L2")) {
+        alarm(20);
+        Rig r(1, "b");
+        CHECK(r.open(0, {2, 3, 5, 7, 9}));
+        CHECK(r.re(0).seabraid_closed() == 0);
+        const double t0 = now_s();
+        r.say(0, kDieIdle);
+        while (r.re(0).seabraid_closed() == 0 && now_s() - t0 < 4.0) usleep(10000);
+        CHECK(now_s() - t0 < 2.0);
+        CHECK(r.re(0).seabraid_closed() == 3);
+        std::string err;
+        CHECK(r.re(0).begin(LAYER, win.x.data(), win.ids.data(), win.T, K, nullptr, nullptr, err));
+        CHECK(owned_count(r.re(0), win.T * K) == 0 && !r.re(0).holds(LAYER, 2));
+        alarm(0);
+    }
+    // ---- L3: a mute helper (alive, never answers) and a 1 s deadline: finish() is true, closed (4), rows lost.
+    if (want("L3")) {
+        alarm(20);
+        Rig r(1, "c");
+        CHECK(r.open(0, {2, 3, 5, 7, 9}));
+        r.re(0).set_seabraid_deadline_for_test(1.0);   // NEWAPI
+        r.say(0, kMute);
+        std::string err;
+        CHECK(r.re(0).begin(LAYER, win.x.data(), win.ids.data(), win.T, K, nullptr, nullptr, err));
+        std::vector<float> rows((size_t) win.T * K * H, -7.0f);
+        const double t0 = now_s();
+        CHECK(r.re(0).finish(rows.data(), err));
+        CHECK(now_s() - t0 < 3.0);
+        CHECK(r.re(0).seabraid_closed() == 4);
+        CHECK(r.re(0).rows_lost());   // NEWAPI
+        alarm(0);
+    }
+    // ---- L4: a STALE channel (its helper already exited and was reaped) opens as a closed card with ONE warning: open()
+    //      is true within 1 s (code 6), holds nothing, publishes no plan.  (Before: it waited 1800 s for a load.)
+    if (want("L4")) {
+        alarm(10);
+        Opts o; o.exit_after_announce = true;
+        Rig r(1, "d", o);
+        r.wait_state(0, bl::kHelperUp);
+        r.reap(0);
+        Capture cap;
+        const double t0 = now_s();
+        const bool ok = r.open(0, {2, 3, 5});
+        const std::string log = cap.finish();
+        CHECK(ok);
+        CHECK(now_s() - t0 < 1.0);
+        CHECK(r.re(0).seabraid_closed() == 6);
+        CHECK(!r.re(0).holds(LAYER, 2) && r.re(0).resident() == 0);
+        CHECK(r.cards[0]->ch.header()->state.load() != bl::kPlanReady);   // nothing was published
+        CHECK(count_of(log, "is gone") == 1);
+        alarm(0);
+    }
+    // ---- L5: a LIVE pid whose start time does not match the published identity (a recycled pid): closed at open.
+    if (want("L5")) {
+        alarm(10);
+        Rig r(1, "e");
+        r.wait_state(0, bl::kHelperUp);
+        r.cards[0]->ch.header()->helper_start ^= 0x5555;   // the pid is alive and is not the process the channel named
+        Capture cap;
+        const bool ok = r.open(0, {2, 3, 5});
+        const std::string log = cap.finish();
+        CHECK(ok);
+        CHECK(r.re(0).seabraid_closed() == 6);
+        CHECK(count_of(log, "pid reused") == 1);
+        alarm(0);
+    }
+    // ---- L6: two cards, two successive losses: card 1 dies mid-request, then card 0 dies idle; both end closed and the
+    //      next layer is all fallback.  Card 0 serves its own picks normally in between.
+    if (want("L6")) {
+        alarm(30);
+        Rig r(2, "f");
+        CHECK(r.open(0, {2, 3, 5}));
+        CHECK(r.open(1, {7, 9}));
+        r.say(1, kDieOnRequest);
+        std::string err;
+        CHECK(r.re(0).begin(LAYER, win.x.data(), win.ids.data(), win.T, K, nullptr, nullptr, err));
+        CHECK(r.re(1).begin(LAYER, win.x.data(), win.ids.data(), win.T, K, nullptr, nullptr, err));
+        std::vector<float> rows0((size_t) win.T * K * H, -7.0f), rows1((size_t) win.T * K * H, -7.0f);
+        double t0 = now_s();
+        CHECK(r.re(0).finish(rows0.data(), err));
+        CHECK(!r.re(0).rows_lost() && r.re(0).seabraid_closed() == 0);   // NEWAPI (rows_lost)
+        CHECK(r.re(1).finish(rows1.data(), err));
+        CHECK(now_s() - t0 < 2.0);
+        CHECK(r.re(1).rows_lost() && r.re(1).seabraid_closed() == 3);    // NEWAPI
+        r.say(0, kDieIdle);
+        t0 = now_s();
+        while (r.re(0).seabraid_closed() == 0 && now_s() - t0 < 4.0) usleep(10000);
+        CHECK(now_s() - t0 < 2.0 && r.re(0).seabraid_closed() == 3);
+        CHECK(r.re(0).begin(LAYER, win.x.data(), win.ids.data(), win.T, K, nullptr, nullptr, err));
+        CHECK(r.re(1).begin(LAYER, win.x.data(), win.ids.data(), win.T, K, nullptr, nullptr, err));
+        CHECK(owned_count(r.re(0), win.T * K) == 0 && owned_count(r.re(1), win.T * K) == 0);
+        alarm(0);
+    }
+    // ---- L7: copy_cached_blobs against a helper that dies on the cache read: true, all misses, closed (3).  (Before: false after 30 s.)
+    if (want("L7")) {
+        alarm(20);
+        Rig r(1, "g");
+        CHECK(r.open(0, {2, 3, 5, 7, 9}));
+        r.say(0, kDieOnBlob);
+        const int32_t layer = LAYER, expert = 2;
+        std::vector<uint8_t> buf((size_t) strata::kernels::cpu::expert_layout().max_blob);
+        uint8_t* dst = buf.data();
+        uint8_t hit = 1;
+        std::string err;
+        const double t0 = now_s();
+        CHECK(r.re(0).copy_cached_blobs(&layer, &expert, &dst, 1, &hit, err));
+        CHECK(now_s() - t0 < 2.5);
+        CHECK(hit == 0);
+        CHECK(r.re(0).seabraid_closed() == 3);
+        alarm(0);
+    }
+    // ---- L8: the channel is visible (kNone) one second BEFORE the helper's identity and kHelperUp: open() waits, then succeeds.
+    if (want("L8")) {
+        alarm(20);
+        Opts o; o.announce_delay_ms = 1000;
+        Rig r(1, "h", o);
+        const double t0 = now_s();
+        CHECK(r.open(0, {2, 3, 5, 7, 9}));
+        CHECK(now_s() - t0 >= 0.9);
+        CHECK(r.re(0).seabraid_closed() == 0 && r.re(0).holds(LAYER, 2));
+        alarm(0);
+    }
+    // ---- L9: D4 prefill_end with a helper that dies on the prefill request: false within 1 s, through the watch, never a 60 s wait.
+    if (want("L9")) {
+        alarm(20);
+        Opts o; o.prefill = true;
+        Rig r(1, "i", o);
+        CHECK(r.open(0, {2, 3, 5, 7, 9}));
+        std::string err;
+        CHECK(r.re(0).prefill_open(K, err));
+        const int T = 4;
+        std::vector<uint16_t> x16((size_t) T * H, 0x3C00);   // fp16 1.0
+        std::vector<float> w((size_t) T * K, 0.1f);
+        std::vector<uint8_t> mask(NE, 0);
+        for (int e = 0; e < NE; ++e) mask[(size_t) e] = r.re(0).holds(LAYER, e) ? 1 : 0;
+        r.say(0, kDieOnPrefill);
+        CHECK(r.re(0).prefill_begin(LAYER, x16.data(), bl::kPfRowsF16, w.data(), win.ids.data(), T, K, mask.data(), err));
+        std::vector<uint16_t> sums((size_t) T * H);
+        const double t0 = now_s();
+        CHECK(!r.re(0).prefill_end(sums.data(), err));
+        CHECK(now_s() - t0 < 1.0);
+        CHECK(!r.re(0).prefill_usable());
+        alarm(0);
+    }
+    if (g_fail == 0) { std::printf("ALL OK\n"); return 0; }
+    std::printf("FAILED: %d\n", g_fail);
+    return 1;
+}
