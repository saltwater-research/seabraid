+namespace {
+// A helper that was lost while it held this layer's request (RemoteExperts::rows_lost()) delivered none of the rows it owned.
+// DEFENCE (D5): computed HERE, not inside RemoteExperts, because this dispatch already owns how an expert runs on the CPU
+// (source, pool, kernels) and a second owner of that would drift; D4 prefill does the same ("card 1 computes the handed-over
+// picks itself").  The rows are the plain per-pick expert outputs, exactly what a CPU pick yields, so the combine weights them
+// with the router's own weights whether or not --remote-expert-opt was on (h_mask_ stays 0 for these picks).
+// A null blob fails like the main loop's "could not produce a blob" path.
+bool lost_blob_missing(ExpertDispatch& d, int64_t expert) {
+    d.failed = true;
+    d.fail = "the expert source could not produce a blob";
+    d.fail_layer = d.layers;
+    d.fail_expert = expert;
+    ++d.missing;
+    return false;
+}
+
+bool redo_lost_rows_single(ExpertDispatch& d, const int32_t* ids, int64_t k, float* out, int64_t n_embd, int r) {
+    using namespace strata::kernels::cpu;
+    int64_t njobs = 0;
+    for (int64_t i = 0; i < k; ++i) {
+        if (!d.remote[r]->owns(i)) continue;
+        const uint8_t* b = d.src->blob(d.layers, ids[i]);
+        if (b == nullptr) return lost_blob_missing(d, ids[i]);
+        ExpertJob& j = d.jobs[(size_t) njobs++];   // d.jobs holds k entries (resized at the top of the dispatch)
+        j.blob = b; j.act = &d.act; j.out = out + (size_t) i * (size_t) n_embd; j.weight = 1.0f; j.slot = (int) i;
+    }
+    if (njobs == 0) return true;
+    if (d.split_rows) d.pool->run_split(d.jobs.data(), (int) njobs);
+    else d.pool->run(d.jobs.data(), (int) njobs);
+    return true;
+}
+}  // namespace
