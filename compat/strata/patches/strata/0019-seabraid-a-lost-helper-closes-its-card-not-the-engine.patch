+namespace {
+// One token's activation, quantised the way this pack's kernels read it.  WHY a function: the window loop and the lost-rows
+// redo below both need the same three-way choice, and a copy of it is how the two would one day disagree (a lost helper's rows
+// would then be computed from a different activation than the CPU rows beside them).
+void quantize_window_act(ExpertDispatch& d, const strata::kernels::cpu::ExpertLayout& lay, bool native, const float* x_f, int64_t t) {
+    using namespace strata::kernels::cpu;
+    if (native && q2_native_kernels(lay.fmt[(size_t) d.layers].gu_type))   // a native Q2_0 pack: the Q2_0 kernels' activations
+        act_quant_any(x_f + (size_t) t * H, H, d.act_multi[(size_t) t]);
+    else if (native)
+        native_quant_act(lay.fmt[(size_t) d.layers], x_f + (size_t) t * H, d.nact_multi.data() + (size_t) t * kNativeActBytes);
+    else
+        act_quant_q8_1(x_f + (size_t) t * H, H, d.act_multi[(size_t) t]);
+}
+
+// The window's twin of redo_lost_rows_single (see its note for why this is computed here).  Same job type, kernels, pool call
+// and MAXT split as the main loop; the plan (which expert over which token rows) is lost_rows.hpp's.
+bool redo_lost_rows_multi(ExpertDispatch& d, const float* x_f, const int32_t* ids, int64_t n_tok, int64_t k, float* out, int r,
+                          strata::kernels::cpu::NativeArithmetic arithmetic) {
+    using namespace strata::kernels::cpu;
+    const ExpertLayout& lay = expert_layout();
+    const bool native = lay.native;
+    static thread_local std::vector<uint8_t> lost;
+    static thread_local LostRowsPlan plan;
+    static thread_local std::vector<ExpertJobMulti> jobs;
+    lost.assign((size_t) (n_tok * k), 0);
+    for (int64_t i = 0; i < n_tok * k; ++i) lost[(size_t) i] = d.remote[r]->owns(i) ? 1 : 0;
+    plan_lost_rows(ids, lost.data(), n_tok, k, d.n_expert, MAXT, plan);
+    for (int64_t t = 0; t < n_tok; ++t)
+        if (plan.need_act[(size_t) t]) quantize_window_act(d, lay, native, x_f, t);   // the optimised decode may have skipped it
+    jobs.assign(plan.jobs.size(), ExpertJobMulti{});
+    for (size_t q = 0; q < plan.jobs.size(); ++q) {
+        const uint8_t* b = d.src->blob(d.layers, plan.jobs[q].expert);
+        if (b == nullptr) return lost_blob_missing(d, plan.jobs[q].expert);
+        ExpertJobMulti& jb = jobs[q];
+        jb.blob = b;
+        for (const int32_t i : plan.jobs[q].entries) {
+            const size_t t = (size_t) (i / k);
+            jb.act[jb.nt] = &d.act_multi[t];
+            jb.nact[jb.nt] = native ? d.nact_multi.data() + t * kNativeActBytes : nullptr;
+            jb.out[jb.nt] = out + (size_t) i * H;
+            ++jb.nt;
+            ++d.multi_entries;
+        }
+    }
+    if (jobs.empty()) return true;
+    if (native) d.pool->run_split_multi_native(lay.fmt[(size_t) d.layers], jobs.data(), (int) jobs.size(), arithmetic);
+    else d.pool->run_split_multi(jobs.data(), (int) jobs.size());
+    if (d.plan != nullptr) d.plan->cpu_jobs += (int) jobs.size();   // a statistic only (verify.cpp reads it for the trace)
+    return true;
+}
