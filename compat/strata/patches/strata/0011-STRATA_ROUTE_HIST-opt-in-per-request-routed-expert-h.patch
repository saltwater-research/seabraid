diff --git a/include/strata/core/route_hist.hpp b/include/strata/core/route_hist.hpp
new file mode 100644
index 000000000..36063d172
--- /dev/null
+++ b/include/strata/core/route_hist.hpp
@@ -0,0 +1,131 @@
+#pragma once
+// STRATA_ROUTE_HIST=<dir> (opt-in; unset = every call below is one load of a const bool and nothing else).
+//
+// Per request, one file `<dir>/req-NNNNNN.json`: how many routed (token, expert) pairs each (layer, expert) took, split
+// into the PROMPT phase (everything routed before the first decode window of the request) and the DECODE phase, plus
+// which tier held each expert when the request ended.  tools/route_hist_report.py (seabraid) reads the directory.
+//
+// OWNER / WHY a second table beside ExpertDispatch::usage: `usage` is the existing routed-count owner and is counted at
+// the same site (expert_pool_dispatch_multi), but it is decayed every adaptive round and exists only when the adaptive
+// tier is on.  A per-request histogram needs raw, undecayed counts that exist whether or not re-tiering runs, so it is
+// the undecayed twin, fed from the SAME loop; nothing else counts routing.
+//
+// WHERE the phase boundary is: the driver flips the phase at the moment a request's decode clock starts, not by code
+// path.  A prompt read through batched prefill and a prompt read through verify windows are both "prompt" because both
+// happen before that moment; "decode" is exactly the windows that produce the answer.
+//
+// WHY JSON: the reader is a stdlib Python tool and a human debugging at 2 a.m.; json.load needs no schema code, the
+// file is greppable, and a request is ~50 KB (sparse [expert, count] pairs, not a dense 48 x 512 matrix).  Size is
+// irrelevant against the seconds a request takes; a binary format would buy nothing and cost a reader.
+//
+// FAILURE: observability, fail-open-loud.  Any write error warns once on stderr and turns the whole facility off for
+// the rest of the run; counting itself cannot fail and never blocks.  Single writer: the counting sites run on the
+// request's own thread (the decode loop, the prompt's compute thread), one phase at a time, so there is no locking.
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace strata::core {
+
+class RouteHist {
+public:
+    enum Phase { kPrompt = 0, kDecode = 1 };
+
+    static RouteHist& get() {
+        static RouteHist h;
+        return h;
+    }
+    bool on() const { return on_; }
+
+    /// A request starts: zero both phases, sized for the model, phase = prompt.
+    void begin(int64_t layers, int64_t experts) {
+        if (!on_) return;
+        layers_ = layers;
+        experts_ = experts;
+        for (auto& c : cnt_) c.assign((size_t) (layers * experts), 0u);
+        phase_ = kPrompt;
+    }
+    void set_phase(Phase p) { phase_ = p; }
+
+    /// `n` routed expert ids of one layer (token-major, k per token) in the current phase.
+    void note(int64_t layer, const int32_t* ids, int64_t n) {
+        if (!on_ || layer < 0 || layer >= layers_) return;
+        uint32_t* row = cnt_[phase_].data() + (size_t) layer * (size_t) experts_;
+        for (int64_t i = 0; i < n; ++i)
+            if (ids[i] >= 0 && ids[i] < experts_) ++row[ids[i]];
+    }
+
+    /// Write the request.  `holder(layer, expert)` returns '1' (card 1's VRAM), '2' (card 2), 'p' (peer), '0' (neither:
+    /// host memory).  Called once, after the last decode window, so it sees the tiers as they ended.
+    template <class Holder>
+    void dump(int64_t prompt_tokens, int64_t decode_tokens, Holder holder) {
+        if (!on_ || layers_ <= 0) return;
+        std::error_code ec;
+        std::filesystem::create_directories(dir_, ec);
+        char name[64];
+        std::snprintf(name, sizeof name, "req-%06u.json", ++request_);
+        const std::string path = (std::filesystem::path(dir_) / name).string();
+        std::FILE* f = ec ? nullptr : std::fopen(path.c_str(), "w");
+        bool ok = f != nullptr;
+        if (ok) {
+            ok = std::fprintf(f, "{\"format\":\"strata-route-hist\",\"version\":1,\"request\":%u,\"layers\":%lld,\"experts\":%lld,"
+                                 "\"prompt_tokens\":%lld,\"decode_tokens\":%lld",
+                              request_, (long long) layers_, (long long) experts_, (long long) prompt_tokens,
+                              (long long) decode_tokens) > 0;
+            static const char* const kName[2] = {"prompt", "decode"};
+            for (int p = 0; ok && p < 2; ++p) {
+                std::fprintf(f, ",\n\"%s\":[", kName[p]);
+                for (int64_t l = 0; l < layers_; ++l) {
+                    std::fputs(l ? ",\n[" : "\n[", f);
+                    bool first = true;
+                    const uint32_t* row = cnt_[p].data() + (size_t) l * (size_t) experts_;
+                    for (int64_t e = 0; e < experts_; ++e)
+                        if (row[e]) { std::fprintf(f, first ? "[%lld,%u]" : ",[%lld,%u]", (long long) e, row[e]); first = false; }
+                    std::fputc(']', f);
+                }
+                std::fputc(']', f);
+            }
+            std::fputs(",\n\"holder\":[", f);
+            std::string s((size_t) experts_, '0');
+            for (int64_t l = 0; l < layers_; ++l) {
+                for (int64_t e = 0; e < experts_; ++e) s[(size_t) e] = holder(l, e);
+                std::fprintf(f, l ? ",\n\"%s\"" : "\n\"%s\"", s.c_str());
+            }
+            ok = std::fputs("]}\n", f) >= 0;
+            ok = std::fclose(f) == 0 && ok;
+        }
+        if (!ok) {
+            std::fprintf(stderr, "strata route-hist: cannot write %s: the histogram is off for the rest of this run\n", path.c_str());
+            on_ = false;
+        }
+    }
+
+private:
+    RouteHist() {
+        const char* d = std::getenv("STRATA_ROUTE_HIST");
+        if (d != nullptr && d[0] != '\0') { dir_ = d; on_ = true; }
+    }
+    bool on_ = false;
+    std::string dir_;
+    int64_t layers_ = 0, experts_ = 0;
+    uint32_t request_ = 0;
+    Phase phase_ = kPrompt;
+    std::vector<uint32_t> cnt_[2];
+};
+
+/// The decode timing line's suffix for card `card` (1-based): card 1's own expert work per layer request, between
+/// handing card `card` its rows and needing its answer, and the time it then waited past that.  own + wait is what the
+/// request cost the layer; own is the part that overlapped card 1's work, wait the part that was pure stall.
+/// Empty when STRATA_ROUTE_HIST is unset (the line is then byte-identical to a build without this) or nothing was asked.
+inline std::string route_hist_card_split(bool on, int card, int64_t requests, double own_ms, double wait_ms) {
+    if (!on || requests <= 0) return std::string();
+    char b[200];
+    std::snprintf(b, sizeof b, "; card %d: %lld layer requests, own expert work %.1f us + waited past it %.1f us each",
+                  card, (long long) requests, 1000.0 * own_ms / (double) requests, 1000.0 * wait_ms / (double) requests);
+    return b;
+}
+
+}  // namespace strata::core
