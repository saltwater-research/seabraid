+// route_hist_test: the STRATA_ROUTE_HIST counter and writer (CPU only).  Two registrations of this one binary:
+//   "on"  (env STRATA_ROUTE_HIST=<dir>): the counts land in the right phase/layer/expert and the file says so;
+//   "off" (env unset): nothing is allocated, nothing is written, the timing suffix is exactly the empty string.
+#include "strata/core/route_hist.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <string>
+
+using strata::core::RouteHist;
+using strata::core::route_hist_card_split;
+
+static int fails = 0;
+#define CHECK(c)                                                              \
+    do {                                                                      \
+        if (!(c)) { std::fprintf(stderr, "FAILED: %s (line %d)\n", #c, __LINE__); ++fails; } \
+    } while (0)
+
+static std::string slurp(const std::string& p) {
+    std::ifstream f(p);
+    std::stringstream s;
+    s << f.rdbuf();
+    return s.str();
+}
+
+int main(int argc, char** argv) {
+    const bool want_on = argc > 1 && std::strcmp(argv[1], "on") == 0;
+    RouteHist& h = RouteHist::get();
+    CHECK(h.on() == want_on);
+    CHECK(route_hist_card_split(false, 2, 100, 1.0, 1.0).empty());     // unset: the timing line gains nothing
+    CHECK(route_hist_card_split(true, 2, 0, 1.0, 1.0).empty());        // no request was made: nothing to say
+    // 2000 requests, 100 ms of own work and 50 ms of waiting: 50 us own, 25 us waited, each
+    CHECK(route_hist_card_split(true, 2, 2000, 100.0, 50.0) ==
+          "; card 2: 2000 layer requests, own expert work 50.0 us + waited past it 25.0 us each");
+
+    const char* dir = std::getenv("STRATA_ROUTE_HIST");
+    if (!want_on) {
+        h.begin(2, 8);
+        const int32_t ids[3] = {1, 2, 3};
+        h.note(0, ids, 3);
+        h.dump(5, 5, [](int64_t, int64_t) { return '0'; });
+        CHECK(dir == nullptr || dir[0] == 0);   // ctest sets it to the empty string
+        return fails == 0 ? 0 : 1;
+    }
+    CHECK(dir != nullptr);
+    std::filesystem::remove_all(dir);
+
+    h.begin(2, 8);   // 2 layers, 8 experts
+    const int32_t p0[6] = {1, 1, 2, 7, -1, 99};   // -1 and 99 are out of range: not counted
+    h.note(0, p0, 6);
+    h.note(5, p0, 6);                              // layer out of range: not counted
+    h.set_phase(RouteHist::kDecode);
+    const int32_t d1[4] = {3, 3, 3, 0};
+    h.note(1, d1, 4);
+    h.dump(7, 9, [](int64_t l, int64_t e) { return e == 3 ? (l == 1 ? '2' : '1') : '0'; });
+
+    const std::string j = slurp(std::string(dir) + "/req-000001.json");
+    CHECK(j.find("\"version\":1") != std::string::npos);
+    CHECK(j.find("\"prompt_tokens\":7,\"decode_tokens\":9") != std::string::npos);
+    CHECK(j.find("\"prompt\":[\n[[1,2],[2,1],[7,1]],\n[]]") != std::string::npos);
+    CHECK(j.find("\"decode\":[\n[],\n[[0,1],[3,3]]]") != std::string::npos);
+    CHECK(j.find("\"holder\":[\n\"00010000\",\n\"00020000\"]") != std::string::npos);
+
+    // a second request starts from zero and gets the next file number
+    h.begin(2, 8);
+    h.dump(0, 0, [](int64_t, int64_t) { return '0'; });
+    const std::string j2 = slurp(std::string(dir) + "/req-000002.json");
+    CHECK(j2.find("\"prompt\":[\n[],\n[]]") != std::string::npos);
+
+    // a write error turns it off for good, loudly, and does not throw
+    std::filesystem::remove_all(dir);
+    { std::ofstream blocker(dir); blocker << "a file where the directory should be"; }
+    h.begin(2, 8);
+    h.dump(0, 0, [](int64_t, int64_t) { return '0'; });
+    CHECK(!h.on());
+    std::filesystem::remove(dir);
+    return fails == 0 ? 0 : 1;
+}
