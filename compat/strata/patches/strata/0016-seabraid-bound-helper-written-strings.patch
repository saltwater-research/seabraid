diff --git a/tests/core/seabraid_bounded_text_test.cpp b/tests/core/seabraid_bounded_text_test.cpp
new file mode 100644
index 000000000..cd99f935b
--- /dev/null
+++ b/tests/core/seabraid_bounded_text_test.cpp
@@ -0,0 +1,76 @@
+// seabraid_bounded_text_test: the engine reads helper-written text only through seabraid::bounded_text, CPU only.
+//
+// The helper is a separate process the engine does not trust.  A compromised one can fill msg / helper_name / err /
+// tier_err / pf_err to the last byte without a NUL; reading that with %s or std::string(const char*) runs past the field.
+//
+//   1 unterminated : each field width filled with no NUL comes back as exactly width-1 bytes.  The input is an EXACT-width
+//                    heap buffer, so under ASan any read past it (the bug) aborts the test.
+//   2 real header  : the same, on the fields of a real shm channel header (what the engine actually reads).
+//   3 terminated   : a normal short string, an embedded NUL (stops there), an empty field, a null pointer, cap 0 and 1.
+//   4 control bytes: ESC sequences, BEL, CR/LF, DEL and bytes >= 0x80 are dropped (no terminal-escape injection); TAB is kept.
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <unistd.h>
+
+#include "strata/seabraid/channel.hpp"
+
+namespace bl = seabraid;
+
+static int g_fail = 0;
+#define CHECK(c) do { if (!(c)) { std::printf("FAIL line %d: %s\n", __LINE__, #c); ++g_fail; } } while (0)
+
+static void check_unterminated(size_t width) {
+    std::unique_ptr<char[]> f(new char[width]);   // exact width: a read of byte `width` is a heap-buffer-overflow under ASan
+    std::memset(f.get(), 'A', width);
+    const std::string s = bl::bounded_text(f.get(), width);
+    CHECK(s.size() == width - 1);
+    CHECK(s == std::string(width - 1, 'A'));
+}
+
+static void check_header() {
+    const std::string name = "/blbt" + std::to_string(getpid());
+    bl::Channel ch;
+    std::string e;
+    if (!ch.create(name, 64, 64, 2, 4, 16, 4096, e)) { std::printf("create failed: %s\n", e.c_str()); std::exit(2); }
+    bl::Header* h = ch.header();
+    std::memset(h->msg, 'M', sizeof h->msg);
+    std::memset(h->helper_name, 'N', sizeof h->helper_name);
+    std::memset(h->err, 'E', sizeof h->err);
+    std::memset(h->tier_err, 'T', sizeof h->tier_err);
+    std::memset(h->pf_err, 'P', sizeof h->pf_err);
+    CHECK(bl::bounded_text(h->msg, sizeof h->msg) == std::string(sizeof h->msg - 1, 'M'));
+    CHECK(bl::bounded_text(h->helper_name, sizeof h->helper_name) == std::string(sizeof h->helper_name - 1, 'N'));
+    CHECK(bl::bounded_text(h->err, sizeof h->err) == std::string(sizeof h->err - 1, 'E'));
+    CHECK(bl::bounded_text(h->tier_err, sizeof h->tier_err) == std::string(sizeof h->tier_err - 1, 'T'));
+    CHECK(bl::bounded_text(h->pf_err, sizeof h->pf_err) == std::string(sizeof h->pf_err - 1, 'P'));
+}
+
+static void check_terminated() {
+    char a[16] = "boom: failed";
+    CHECK(bl::bounded_text(a, sizeof a) == "boom: failed");
+    char b[16] = {'a', 'b', '\0', 'c', 'd', 'e'};
+    CHECK(bl::bounded_text(b, sizeof b) == "ab");        // stops at the first NUL
+    char c[8] = {0};
+    CHECK(bl::bounded_text(c, sizeof c).empty());
+    CHECK(bl::bounded_text(nullptr, 8).empty());
+    CHECK(bl::bounded_text(a, 0).empty());
+    CHECK(bl::bounded_text(a, 1).empty());                // cap 1 leaves room for the NUL only
+    CHECK(bl::bounded_text(a, 5) == "boom");              // cap-1 bytes at most
+}
+
+static void check_control() {
+    const char in[] = "ok\x1b[31mred\x1b]0;title\x07 a\tb\r\nc\x7f" "d\x9b" "e\xc3\xa9";
+    CHECK(bl::bounded_text(in, sizeof in) == "ok[31mred]0;title a\tbcde");   // ESC, BEL, CR, LF, DEL, >=0x80 gone; TAB kept
+}
+
+int main() {
+    for (const size_t w : {size_t(128), size_t(256), size_t(512)}) check_unterminated(w);
+    check_header();
+    check_terminated();
+    check_control();
+    std::printf("%s\n", g_fail ? "FAILED" : "OK");
+    return g_fail ? 1 : 0;
+}
