     bool owns(int64_t index) const { return owned_[(size_t) index] != 0; }
     /// This helper's cache holds (layer, expert): begin() will take its rows unless the plan gave them away.
     bool holds(int64_t layer, int32_t expert) const {
-        if (bl_) return layer >= 0 && expert >= 0 && expert < n_expert_ &&
+        // A CLOSED card (fail closed: a tier round timed out or tore a slot) holds nothing as far as routing goes.
+        if (bl_) return bl_closed_.load(std::memory_order_relaxed) == 0 && layer >= 0 && expert >= 0 && expert < n_expert_ &&
                         (size_t) layer * (size_t) n_expert_ + (size_t) expert < bl_held_.size() &&
                         bl_held_[(size_t) layer * (size_t) n_expert_ + (size_t) expert] != 0;
-        return cache_.slot_of(layer, expert) >= 0;
+        // Helper side: a quarantined slot (its tier copy started and did not finish) is published as holding nothing.
+        return cache_.slot_of(layer, expert) >= 0 && !tier_suspect(layer, expert);
     }
+    /// HELPER SIDE: (layer, expert)'s slot was written by a tier round whose copy did not complete, so it may hold
+    /// neither expert whole.  ExpertCache has no eviction, so the slot stays mapped and is QUARANTINED instead:
+    /// holds() and the cache reads say no, held[] publishes 0, and no tier op may write it again.
+    bool tier_suspect(int64_t layer, int64_t expert) const {
+        const size_t i = (size_t) layer * (size_t) n_expert_ + (size_t) expert;
+        return layer >= 0 && expert >= 0 && expert < n_expert_ && i < tier_suspect_.size() && tier_suspect_[i] != 0;
+    }
+    /// MAIN SIDE: 0 = open; 1 = closed after a tier round timed out; 2 = closed after a torn slot or a stale
+    /// residency report.  Closed is for the rest of the session: nothing is routed to the card and its experts come
+    /// from RAM / the drive (N-card ladder, fail closed on unknown residency).
+    int seabraid_closed() const { return bl_closed_.load(std::memory_order_relaxed); }
     /// seabraid: this tier is served by a helper process of another GPU vendor over shared memory.
     bool seabraid() const { return bl_ != nullptr; }
     bool optimized_decode() const { return remote_opt_ != nullptr; }
@@ -145,8 +158,13 @@ private:
     bool seabraid_helper_begin(int64_t layer, const float* x, const int32_t* ids, int64_t n_tok, int64_t k,
                        const int32_t* kind, const int32_t* primary_res, std::string& err);
     bool seabraid_helper_finish(float* out, std::string& err);
+    void seabraid_close(int why, const std::string& msg);
+    void tier_quarantine(int64_t layer, int64_t expert);
     std::unique_ptr<seabraid::Channel> bl_;
     std::vector<uint8_t> bl_held_;
+    std::atomic<int> bl_closed_{0};        ///< see seabraid_closed(); atomic: the prompt path's stager reads holds() off-thread
+    std::vector<uint8_t> tier_suspect_;    ///< HELPER SIDE: quarantined cells, see tier_suspect()
+    std::vector<std::pair<int32_t, int32_t>> tier_written_;   ///< HELPER SIDE: cells this round's fills wrote
     /// Swaps whose replace() is waiting on tier_sync().  Residency must not move until the copy
     /// lands, or a lookup in between reads the slot while it still holds the old expert's bytes.
     std::vector<seabraid::TierWireOp> tier_queued_;
diff --git a/src/core/ownership_map.cpp b/src/core/ownership_map.cpp
new file mode 100644
index 000000000..a3b12799b
--- /dev/null
+++ b/src/core/ownership_map.cpp
@@ -0,0 +1,186 @@
+// The ownership map and its transition: see include/strata/core/ownership_map.hpp for the contract and the design gate.
+//
+// ORDER OF A PROMOTION (prepare), and why each failure ends where it does:
+//   0. checks           : shape, epoch, both rungs open cards, up owned by hi + 1, down by hi     -> kRejected, untouched
+//   1. stage up, down   : both blobs into host memory before ANY slot is written                 -> kRejected (a timeout: kClosed)
+//   2. hi <- up         : the upper card first.  If it tears, down's staged blob rewrites it      -> kRolledBack, or kClosed
+//   3. lo <- down       : then the lower card.  Refused: hi gets down back                        -> kRolledBack
+//                         Failed sync / timeout: lo is closed, hi gets down back                  -> kClosed
+//   4. commit           : the map flips both cells and the epoch moves (abort instead if it moved since step 0)
+// Upper card first because the moving-up expert is then whole on the upper card before the lower card's slot is touched:
+// whatever the lower card does next, the bytes `up` needs exist on a card AND in blob_up, and `down` exists in blob_down.
+#include "strata/core/ownership_map.hpp"
+
+namespace strata::core {
+
+std::string rung_name(int rung, int rungs) {
+    if (rung < 0 || rung >= rungs) return "rung " + std::to_string(rung) + "?";
+    return rung == rungs - 1 ? std::string("fallback") : "card " + std::to_string(rung + 1);
+}
+
+const char* move_state_name(MoveState s) {
+    switch (s) {
+        case MoveState::kEmpty: return "empty";
+        case MoveState::kPrepared: return "prepared";
+        case MoveState::kCommitted: return "committed";
+        case MoveState::kRejected: return "rejected";
+        case MoveState::kRolledBack: return "rolled back";
+        case MoveState::kClosed: return "CLOSED";
+    }
+    return "?";
+}
+
+static const char* io_name(IoStatus s) {
+    switch (s) {
+        case IoStatus::kOk: return "ok";
+        case IoStatus::kRefused: return "refused";
+        case IoStatus::kFailed: return "FAILED (slot may be torn)";
+        case IoStatus::kTimeout: return "TIMEOUT (state unknown)";
+    }
+    return "?";
+}
+
+bool OwnershipMap::init(int64_t layers, int64_t experts, int rungs, const std::vector<int8_t>& rung_of, std::string& err) {
+    // int8_t rungs and the cascade's one-rung moves: more than 64 rungs is not a machine, it is a bug in the caller.
+    if (layers <= 0 || experts <= 0 || rungs < 2 || rungs > 64 || layers > (int64_t(1) << 26) / experts) {
+        err = "ownership map: bad shape (" + std::to_string(layers) + " layers, " + std::to_string(experts) +
+              " experts, " + std::to_string(rungs) + " rungs)";
+        return false;
+    }
+    if (rung_of.size() != (size_t) (layers * experts)) { err = "ownership map: rung_of has the wrong size"; return false; }
+    for (int8_t r : rung_of)
+        if (r < 0 || r >= rungs) { err = "ownership map: a cell names rung " + std::to_string(r); return false; }
+    layers_ = layers; experts_ = experts; rungs_ = rungs;
+    rung_of_ = rung_of;
+    closed_.assign((size_t) rungs, 0);
+    ++epoch_;   // a new map is a new placement: a plan made against the old one must not commit
+    return true;
+}
+
+int64_t OwnershipMap::adopt(const std::vector<int8_t>& rung_of, std::string& err, std::vector<int64_t>* changed_by) {
+    if (rungs_ < 2) { err = "ownership map: adopt before init"; return -1; }
+    if (rung_of.size() != rung_of_.size()) { err = "ownership map: adopt with the wrong size"; return -1; }
+    for (int8_t r : rung_of)
+        if (r < 0 || r >= rungs_) { err = "ownership map: adopt names rung " + std::to_string(r); return -1; }
+    if (changed_by) changed_by->assign((size_t) rungs_, 0);
+    int64_t n = 0;
+    for (size_t i = 0; i < rung_of.size(); ++i) {
+        if (rung_of[i] == rung_of_[i]) continue;
+        ++n;
+        if (changed_by) { ++(*changed_by)[(size_t) rung_of_[i]]; ++(*changed_by)[(size_t) rung_of[i]]; }
+        rung_of_[i] = rung_of[i];
+    }
+    if (n > 0) ++epoch_;   // closed_ is untouched: only a new init() reopens a rung
+    return n;
+}
+
+OwnershipSnapshot OwnershipMap::snapshot() const { return OwnershipSnapshot{rung_of_, closed_, epoch_}; }
+
+int8_t OwnershipMap::owner(int64_t layer, int64_t expert) const {
+    if (layer < 0 || expert < 0 || layer >= layers_ || expert >= experts_) return -1;
+    return rung_of_[at(layer, expert)];
+}
+
+int8_t OwnershipMap::executor(int64_t layer, int64_t expert) const {
+    const int8_t o = owner(layer, expert);
+    if (o < 0) return o;
+    // Fail closed: a closed rung's state is unknown or torn, so its cells go to the one rung that is always whole.
+    return closed(o) ? (int8_t) fallback() : o;
+}
+
+void OwnershipMap::close(int rung) {
+    if (rung < 0 || rung >= fallback() || closed_[(size_t) rung]) return;   // the fallback has no slots to tear
+    closed_[(size_t) rung] = 1;
+    ++epoch_;   // routing changed for every cell this rung owned
+}
+
+bool OwnershipMap::restore(Prepared& p, RungIO* const* io, int rung, int32_t holds_now, const std::vector<uint8_t>& blob,
+                           int32_t want) {
+    if (closed(rung)) return false;
+    std::string err;
+    const IoStatus s = io[rung]->replace(p.m.layer, holds_now, want, blob, err);
+    if (s == IoStatus::kOk) return true;
+    // A slot that cannot be rewritten from a blob we hold is a slot nobody can vouch for: close the whole rung.
+    close(rung);
+    p.why += "; restoring " + rung_name(rung, rungs_) + " " + io_name(s) + (err.empty() ? "" : ": " + err) + ", rung closed";
+    return false;
+}
+
+Prepared OwnershipMap::prepare(const Promotion& m, uint64_t expected_epoch, RungIO* const* io) {
+    Prepared p;
+    p.m = m;
+    p.epoch = epoch_;
+    auto end = [&](MoveState s, const std::string& why) { p.state = s; p.why = why + p.why; return p; };
+    const int hi = m.hi, lo = m.hi + 1;
+    if (rungs_ < 2) return end(MoveState::kRejected, "the map is not initialised");
+    if (hi < 0 || lo >= fallback()) return end(MoveState::kRejected, "both rungs of a move must be cards (hi " + std::to_string(hi) + ")");
+    if (m.layer < 0 || m.layer >= layers_ || m.up < 0 || m.up >= experts_ || m.down < 0 || m.down >= experts_ || m.up == m.down)
+        return end(MoveState::kRejected, "layer or expert out of range");
+    // The epoch guards against a second TRANSITION (or a close) since the caller looked; the two owner checks below
+    // guard the cells themselves, so a plan made before the engine's own adapt moved other cells still applies.
+    if (expected_epoch != epoch_)
+        return end(MoveState::kRejected, "planned against epoch " + std::to_string(expected_epoch) + ", the map is at " + std::to_string(epoch_));
+    if (io == nullptr || io[hi] == nullptr || io[lo] == nullptr) return end(MoveState::kRejected, "no I/O for one of the rungs");
+    if (closed(hi) || closed(lo)) return end(MoveState::kRejected, "a rung of the move is closed");
+    if (owner(m.layer, m.up) != lo) return end(MoveState::kRejected, "the expert to promote is not on " + rung_name(lo, rungs_));
+    if (owner(m.layer, m.down) != hi) return end(MoveState::kRejected, "the expert to drop is not on " + rung_name(hi, rungs_));
+
+    std::string err;
+    // (1) Both displaced blobs, before either slot is overwritten.
+    IoStatus s = io[lo]->stage(m.layer, m.up, p.blob_up, err);
+    if (s == IoStatus::kTimeout) { close(lo); return end(MoveState::kClosed, "staging the promoted expert: " + std::string(io_name(s)) + " " + err); }
+    if (s != IoStatus::kOk) return end(MoveState::kRejected, "staging the promoted expert: " + std::string(io_name(s)) + " " + err);
+    s = io[hi]->stage(m.layer, m.down, p.blob_down, err);
+    if (s == IoStatus::kTimeout) { close(hi); return end(MoveState::kClosed, "staging the dropped expert: " + std::string(io_name(s)) + " " + err); }
+    if (s != IoStatus::kOk) return end(MoveState::kRejected, "staging the dropped expert: " + std::string(io_name(s)) + " " + err);
+    if (p.blob_up.empty() || p.blob_down.empty()) return end(MoveState::kRejected, "a staged blob is empty");
+
+    // (2) The upper card takes `up` into `down`'s slot.
+    s = io[hi]->replace(m.layer, m.down, m.up, p.blob_up, err);
+    if (s == IoStatus::kRefused) return end(MoveState::kRejected, "upper card refused: " + err);
+    if (s == IoStatus::kTimeout) {   // unknown state: never written to again, not even to restore
+        close(hi);
+        return end(MoveState::kClosed, "upper card " + std::string(io_name(s)) + ": " + err);
+    }
+    if (s == IoStatus::kFailed) {    // torn: its view still says `down`, so rewrite down's bytes in place
+        const std::string why = "upper card " + std::string(io_name(s)) + ": " + err;
+        return end(restore(p, io, hi, m.down, p.blob_down, m.down) ? MoveState::kRolledBack : MoveState::kClosed, why);
+    }
+    p.hi_written = true;
+
+    // (3) The lower card takes `down` into `up`'s slot.
+    s = io[lo]->replace(m.layer, m.up, m.down, p.blob_down, err);
+    if (s == IoStatus::kOk) { p.lo_written = true; p.state = MoveState::kPrepared; return p; }
+    const std::string why = "lower card " + std::string(io_name(s)) + ": " + err;
+    // A failed sync or a timeout leaves the lower slot torn or unknown: close the lower card (its cells, `up` among them,
+    // now execute on the fallback).  Either way the upper card gets `down` back, so down's owner stays whole.
+    if (s != IoStatus::kRefused) close(lo);
+    const bool back = restore(p, io, hi, m.up, p.blob_down, m.down);
+    return end(s == IoStatus::kRefused && back ? MoveState::kRolledBack : MoveState::kClosed, why);
+}
+
+bool OwnershipMap::commit(Prepared& p, RungIO* const* io) {
+    if (p.state != MoveState::kPrepared) { p.why = "commit of a move that is not prepared; " + p.why; return false; }
+    if (p.epoch != epoch_) {   // something else changed routing between prepare and commit: do not publish over it
+        p.why = "the map moved from epoch " + std::to_string(p.epoch) + " to " + std::to_string(epoch_) + " before commit";
+        abort(p, io);
+        return false;
+    }
+    rung_of_[at(p.m.layer, p.m.up)] = (int8_t) p.m.hi;
+    rung_of_[at(p.m.layer, p.m.down)] = (int8_t) (p.m.hi + 1);
+    ++epoch_;
+    p.state = MoveState::kCommitted;
+    return true;
+}
+
+void OwnershipMap::abort(Prepared& p, RungIO* const* io) {
+    if (p.state != MoveState::kPrepared) return;
+    bool whole = true;
+    // Reverse order of the writes: the lower card gets `up` back first, then the upper card `down`.
+    if (p.lo_written) whole &= restore(p, io, p.m.hi + 1, p.m.down, p.blob_up, p.m.up);
+    if (p.hi_written) whole &= restore(p, io, p.m.hi, p.m.up, p.blob_down, p.m.down);
+    p.lo_written = p.hi_written = false;
+    p.state = whole ? MoveState::kRolledBack : MoveState::kClosed;
+}
+
+}  // namespace strata::core
