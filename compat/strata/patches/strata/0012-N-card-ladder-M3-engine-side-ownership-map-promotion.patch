diff --git a/include/strata/core/ownership_map.hpp b/include/strata/core/ownership_map.hpp
new file mode 100644
index 000000000..305acc5bc
--- /dev/null
+++ b/include/strata/core/ownership_map.hpp
@@ -0,0 +1,140 @@
+#pragma once
+// Who EXECUTES each routed expert: one answer per (layer, expert), and the only way that answer changes, a
+// prepare -> commit | abort transition.  N-card ladder design (seabraid docs/design/N-CARD-LADDER.md), section 4
+// "One owner for who executes (layer, expert)", module M3.
+//
+// DESIGN GATE
+//   Owner    : this file + src/core/ownership_map.cpp own "which rung executes (layer, expert)" and the epoch of that
+//              answer.  A rung is an index: 0 = the card that runs the engine, then the other cards in rank order; the
+//              LAST rung is the fallback below the cards (host RAM, then the drive), which needs no slot and is never
+//              closed.  Nothing here names a card, a vendor, a process or a path.
+//   Contract : OwnershipMap::{init, adopt, snapshot, owner, executor, close} and the transition prepare -> commit|abort.
+//              The bytes of a move go through RungIO, which the caller implements once per card rung (the engine's own
+//              cache, a card behind a channel, fake cards in the host test).  A planner reads snapshots and submits
+//              Promotions; it never writes the map.  Imports: <cstdint>, <string>, <vector> only.
+//   Size     : header <= 150 lines, cpp <= 350 (split before 400).
+//   Failure  : a move refused before any slot is touched fails OPEN, loudly (kRejected: map and cards unchanged).  A
+//              timeout, or a torn slot that cannot be rewritten from its staged blob, fails CLOSED for that rung: close()
+//              sends every cell it owns to the fallback rung (executor()), and the rung stays closed until the caller
+//              builds a new map.  Both displaced blobs are staged in host memory before either slot is overwritten, so
+//              every failure boundary has a defined recovery and nothing depends on re-reading a torn slot.
+//   Checker  : tests/core/ownership_map_test.cpp injects a failure at every boundary (stage, fill on the upper rung, the
+//              lower rung's refusal / failed sync / timeout, a lost race at commit, an explicit abort) on fake cards, and
+//              after each checks: every cell has exactly one executor, no executor is a closed rung, and the bytes
+//              behind every card executor equal the source's.  Each guard sabotaged once (see the test's header).
+//   Finish   : the host test passes; live, the round line reports zero STALE cells and zero closed-card routes.
+//
+// THE INVARIANT.  "Exactly one execution owner per cell at every window boundary."  The map stores one rung per cell,
+// so "one owner" is structural; what can break is the BYTES behind an owner (a torn slot) and routing to a rung whose
+// state is unknown (a timeout).  Those are what the transition and close() guard.  A temporary second physical copy
+// during a round is allowed (the promoted expert sits on both cards between the two writes); a second owner is not.
+//
+// THREADING.  Not synchronised.  The caller drives it from ONE thread at a window boundary with layer requests
+// drained and admission closed (in the engine: the engine thread, where every RungIO write already has to happen).
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace strata::core {
+
+// The outcome of one RungIO step.  The four cases are the four recoveries the transition needs, so they stay distinct.
+enum class IoStatus : uint8_t {
+    kOk = 0,        // done (for a write: the copy completed, was checked where the rung can, and the rung's view moved)
+    kRefused = 1,   // nothing was touched (an argument the rung cannot take, an expert it does not hold)
+    kFailed = 2,    // a write started and did not complete: the slot may hold neither expert whole
+    kTimeout = 3,   // no answer in time: the rung's state is unknown
+};
+
+// One card rung's I/O, implemented by the caller.  Two operations are all a same-layer exchange needs.
+class RungIO {
+public:
+    virtual ~RungIO() = default;
+    // Copy (layer, expert)'s bytes, as this rung holds them, into `out` (resized by the callee).  Touches no slot.
+    virtual IoStatus stage(int32_t layer, int32_t expert, std::vector<uint8_t>& out, std::string& err) = 0;
+    // Overwrite the slot that holds (layer, old_e) with new_e's bytes and switch this rung's own residency view from
+    // old_e to new_e once the copy has completed.  `bytes` is new_e's staged blob; a rung that can only read its own
+    // source (a card behind a channel with no blob-load op) ignores it.  old_e == new_e rewrites the slot in place,
+    // which is how a torn slot is restored.  The view moves ONLY on kOk.
+    virtual IoStatus replace(int32_t layer, int32_t old_e, int32_t new_e, const std::vector<uint8_t>& bytes,
+                             std::string& err) = 0;
+};
+
+// A same-layer exchange across ONE rung boundary: `up` moves from rung hi + 1 to rung hi, `down` from hi to hi + 1.
+// One rung per move is the cascade rule (design section 3, rule P1); same layer because a same-layer swap is the only
+// cross-card primitive until a relocate exists, and it keeps the freed slot the right size for what drops into it.
+struct Promotion {
+    int32_t layer = -1, up = -1, down = -1;
+    int8_t hi = 0;
+};
+
+enum class MoveState : uint8_t {
+    kEmpty = 0,
+    kPrepared,     // both writes completed; commit() may publish it
+    kCommitted,    // the map says up -> hi, down -> hi + 1; the epoch moved
+    kRejected,     // refused before any slot was touched (fail open, loud)
+    kRolledBack,   // a slot was touched and restored from its staged blob; the map is unchanged
+    kClosed,       // a rung could not be restored or did not answer: it is closed (fail closed); the map is unchanged
+};
+
+struct Prepared {
+    Promotion m;
+    uint64_t epoch = 0;                         // the epoch prepare() saw; commit() refuses if the map moved since
+    MoveState state = MoveState::kEmpty;
+    bool hi_written = false, lo_written = false;
+    std::vector<uint8_t> blob_up, blob_down;    // both displaced blobs, staged BEFORE either slot is overwritten
+    std::string why;                            // the reason for any state but kPrepared / kCommitted
+};
+
+struct OwnershipSnapshot {
+    std::vector<int8_t> rung_of;   // n_layers * n_expert, layer-major
+    std::vector<uint8_t> closed;   // per rung
+    uint64_t epoch = 0;
+};
+
+class OwnershipMap {
+public:
+    // `rungs` >= 2 (at least one card and the fallback).  rung_of[cell] in [0, rungs).  False + err on a bad shape.
+    bool init(int64_t layers, int64_t experts, int rungs, const std::vector<int8_t>& rung_of, std::string& err);
+    // Fold in residency that moved by a route this map does not own (the engine's own card-1 <-> RAM adapt) at a
+    // quiet boundary.  Returns the cells that changed (-1 + err on a bad shape); `changed_by` (optional, per rung) counts
+    // the cells that left or joined each rung.  Moves the epoch when anything changed.  Never reopens a closed rung.
+    int64_t adopt(const std::vector<int8_t>& rung_of, std::string& err, std::vector<int64_t>* changed_by = nullptr);
+    OwnershipSnapshot snapshot() const;
+
+    int8_t owner(int64_t layer, int64_t expert) const;      // what the map says (-1 out of range)
+    int8_t executor(int64_t layer, int64_t expert) const;   // the owner, or the fallback when the owner is closed
+    bool closed(int rung) const { return rung >= 0 && rung < rungs_ && closed_[(size_t) rung] != 0; }
+    int rungs() const { return rungs_; }
+    int fallback() const { return rungs_ - 1; }
+    uint64_t epoch() const { return epoch_; }
+    int64_t layers() const { return layers_; }
+    int64_t experts() const { return experts_; }
+    // Fail closed: from now on executor() sends every cell this rung owns to the fallback.  The fallback cannot close.
+    void close(int rung);
+
+    // Stage both blobs, write `up` into `down`'s slot on rung hi, then `down` into `up`'s slot on rung hi + 1.  `io` is
+    // indexed by rung; io[hi] and io[hi + 1] must be non-null.  Every failure path ends in kRejected, kRolledBack or
+    // kClosed with the map unchanged; only kPrepared may be committed.
+    Prepared prepare(const Promotion& m, uint64_t expected_epoch, RungIO* const* io);
+    // Publish a prepared move: the map changes and the epoch moves.  If the epoch moved since prepare() (another
+    // transition or a close won the race), the move is aborted instead and false is returned.
+    bool commit(Prepared& p, RungIO* const* io);
+    // Undo a prepared move: each written slot gets its staged blob back.  A rung that cannot be restored is closed.
+    void abort(Prepared& p, RungIO* const* io);
+
+private:
+    size_t at(int64_t l, int64_t e) const { return (size_t) l * (size_t) experts_ + (size_t) e; }
+    bool restore(Prepared& p, RungIO* const* io, int rung, int32_t holds_now, const std::vector<uint8_t>& blob,
+                 int32_t want);
+    int64_t layers_ = 0, experts_ = 0;
+    int rungs_ = 0;
+    uint64_t epoch_ = 0;
+    std::vector<int8_t> rung_of_;
+    std::vector<uint8_t> closed_;
+};
+
+// For log lines: "card 1", "card 2", ..., "fallback".
+std::string rung_name(int rung, int rungs);
+const char* move_state_name(MoveState s);
+
+}  // namespace strata::core
diff --git a/include/strata/core/ownership_rungs.hpp b/include/strata/core/ownership_rungs.hpp
new file mode 100644
index 000000000..5c6f4687f
--- /dev/null
+++ b/include/strata/core/ownership_rungs.hpp
@@ -0,0 +1,67 @@
+#pragma once
+// The live RungIO implementations behind the ownership map (ownership_map.hpp): the engine's own expert cache (card 1)
+// and a card reached through RemoteExperts over a seabraid channel.  The map decides the order and the recovery; these
+// only move bytes and report which of the four IoStatus cases happened.
+//
+// DESIGN GATE
+//   Owner    : "how a slot of THIS kind of rung is read, written and checked".  The residency tables stay with their
+//              owners (host_res and the device tables: the engine; held[]: RemoteExperts); these adapters only call them.
+//   Contract : PrimaryRung, RemoteRung below.  ENGINE THREAD ONLY, at a quiet window boundary: no layer request in flight
+//              (RemoteExperts' fence drains its own), no adapt copy in flight (the caller checks), no other writer.
+//   Size     : header <= 100, cpp <= 200.
+//   Failure  : never throws, never aborts.  A write that started and did not complete is kFailed with the rung's view
+//              unchanged (the map then rewrites the staged blob or closes the rung); a channel timeout is kTimeout (the
+//              card is already closed by RemoteExperts).
+//   Checker  : the map's own test drives fake rungs through every status (tests/core/ownership_map_test.cpp); these two
+//              need a GPU and are exercised by the live A/B (round line, card-closed line).  NOT host-tested.
+//   Finish   : a live --retier-promote round line with committed pairs and zero STALE.
+#include "strata/core/ownership_map.hpp"
+
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace strata::core {
+class ExpertCache;
+class RemoteExperts;
+
+// Card 1: the engine's own cache.  `host_res` is the table the engine routes from (slot index or kNotResident per cell,
+// layer-major); `publish(err)` pushes it to the device tables (the engine's res_upload).  Each write drains the device
+// first and verifies the slot by read-back, so kOk means the bytes behind the new owner are the staged blob's.
+class PrimaryRung : public RungIO {
+public:
+    PrimaryRung(ExpertCache& cache, std::vector<int32_t>& host_res, int64_t n_expert, std::function<bool(std::string&)> publish)
+        : cache_(cache), res_(host_res), n_expert_(n_expert), publish_(std::move(publish)) {}
+    IoStatus stage(int32_t layer, int32_t expert, std::vector<uint8_t>& out, std::string& err) override;
+    IoStatus replace(int32_t layer, int32_t old_e, int32_t new_e, const std::vector<uint8_t>& bytes, std::string& err) override;
+
+private:
+    ExpertCache& cache_;
+    std::vector<int32_t>& res_;
+    int64_t n_expert_;
+    std::function<bool(std::string&)> publish_;
+};
+
+// A card behind a seabraid channel.  stage() borrows the blob through the prompt path's cache read (copy_cached_blobs);
+// replace() is ONE same-layer kTierSwap through seabraid_retier (drain, fence, ack, held[] adopted and checked).  The
+// staged bytes are not sent: the channel has no blob-load op yet (channel v7's kTierLoadFromBlob, design M4), so the
+// card reads the new expert from its own copy of the same pack.
+class RemoteRung : public RungIO {
+public:
+    explicit RemoteRung(RemoteExperts& re) : re_(re) {}
+    IoStatus stage(int32_t layer, int32_t expert, std::vector<uint8_t>& out, std::string& err) override;
+    IoStatus replace(int32_t layer, int32_t old_e, int32_t new_e, const std::vector<uint8_t>& bytes, std::string& err) override;
+
+private:
+    RemoteExperts& re_;
+};
+
+// The ownership snapshot of a two-card engine as routing really resolves it today: card 1 (rung 0) if the engine's own
+// table has the cell (seabraid_helper_begin skips anything card 1 holds, so card 1 wins a duplicate), else card 2 (rung 1) if
+// the channel card holds it, else the fallback (rung 2).  `both` (optional) counts cells held by both cards: a wasted
+// slot, not a second owner.  Engine thread (it reads the card's held[] view).
+std::vector<int8_t> derive_rungs(const std::vector<int32_t>& host_res, const RemoteExperts& card2, int64_t layers, int64_t experts,
+                                 int64_t* both);
+
+}  // namespace strata::core
