+// Live RungIO adapters for the ownership map: see include/strata/core/ownership_rungs.hpp for the contract and gate.
+#include "strata/core/ownership_rungs.hpp"
+
+#include "strata/core/expert_cache.hpp"
+#include "strata/core/expert_nibble.hpp"
+#include "strata/core/remote_experts.hpp"
+#include "strata/kernels/cpu/expert_layout.hpp"
+
+#include <cuda_runtime.h>
+
+namespace strata::core {
+
+namespace {
+bool cuda_ok(cudaError_t e, const char* what, std::string& err) {
+    if (e == cudaSuccess) return true;
+    err = std::string(what) + ": " + cudaGetErrorString(e);
+    return false;
+}
+}  // namespace
+
+IoStatus PrimaryRung::stage(int32_t layer, int32_t expert, std::vector<uint8_t>& out, std::string& err) {
+    const size_t i = (size_t) layer * (size_t) n_expert_ + (size_t) expert;
+    if (layer < 0 || expert < 0 || expert >= n_expert_ || i >= res_.size() || res_[i] < 0) {
+        err = "card 1 does not hold layer " + std::to_string(layer) + " expert " + std::to_string(expert);
+        return IoStatus::kRefused;
+    }
+    const size_t bytes = (size_t) strata::kernels::cpu::expert_layout().blob_bytes(layer);
+    out.resize(bytes);
+    // A read: blocking on the legacy stream is enough, nothing at a quiet boundary writes this slot.
+    if (!cuda_ok(cudaMemcpy(out.data(), cache_.device_slot(res_[i]), bytes, cudaMemcpyDeviceToHost), "card 1 slot read", err)) {
+        out.clear();
+        return IoStatus::kRefused;   // nothing was written: the map rejects the move and nothing moves
+    }
+    return IoStatus::kOk;
+}
+
+IoStatus PrimaryRung::replace(int32_t layer, int32_t old_e, int32_t new_e, const std::vector<uint8_t>& bytes, std::string& err) {
+    const size_t io = (size_t) layer * (size_t) n_expert_ + (size_t) old_e;
+    const size_t in = (size_t) layer * (size_t) n_expert_ + (size_t) new_e;
+    if (layer < 0 || old_e < 0 || new_e < 0 || old_e >= n_expert_ || new_e >= n_expert_ || io >= res_.size() || in >= res_.size()) {
+        err = "card 1: layer or expert out of range"; return IoStatus::kRefused;
+    }
+    const int32_t slot = res_[io];
+    if (slot < 0) { err = "card 1 does not hold the expert whose slot was named"; return IoStatus::kRefused; }
+    if (old_e != new_e && res_[in] >= 0) { err = "card 1 already holds the incoming expert"; return IoStatus::kRefused; }
+    // A 4-bit (STRATA_EXPERT_NIBBLE) layer's slots are not GGUF blobs: a raw copy would be silently wrong.  Refused here
+    // rather than through nibble::guard_raw, which aborts: a refused promotion is a skipped move, not a dead engine.
+    if (nibble::layer(layer).on) { err = "card 1: layer " + std::to_string(layer) + " has 4-bit slots; raw copies refused"; return IoStatus::kRefused; }
+    const int64_t need = (int64_t) strata::kernels::cpu::expert_layout().blob_bytes(layer);
+    if ((int64_t) bytes.size() < need || (int64_t) cache_.slot_room(slot) < need) {
+        err = "card 1: the staged blob or the slot is smaller than layer " + std::to_string(layer) + "'s blob";
+        return IoStatus::kRefused;
+    }
+    // Every stream that may read this slot (the verifier, the adapt and prefetch streams) goes idle first.  A round is
+    // rare (every --retier-every windows) and a device-wide drain is the one ordering that holds against all of them.
+    if (!cuda_ok(cudaDeviceSynchronize(), "card 1 drain before a slot write", err)) return IoStatus::kRefused;
+    auto undo = [&] { res_[io] = slot; if (old_e != new_e) res_[in] = kNotResident; };
+    // The old expert stops being card 1's before its slot changes, so nothing can route to a half-written slot.
+    res_[io] = kNotResident;
+    if (!cuda_ok(cudaMemcpy(cache_.device_slot(slot), bytes.data(), (size_t) need, cudaMemcpyHostToDevice), "card 1 slot write", err)) {
+        undo();   // the view stays the old expert's (the IoStatus contract); the map rewrites the slot or closes the rung
+        return IoStatus::kFailed;
+    }
+    // THE ONLY THING THAT SAYS THE CACHE HOLDS THE EXPERT IT CLAIMS TO (expert_cache.hpp): read it back, byte for byte.
+    if (!cache_.verify_slot(slot, bytes.data(), err, need)) { undo(); return IoStatus::kFailed; }
+    res_[in] = slot;
+    if (!publish_ || !publish_(err)) {   // the device tables could not follow: they may be half-updated
+        undo();
+        std::string e2;
+        if (publish_) publish_(e2);      // best effort to put the old view back on the device
+        err = "card 1: residency table upload failed: " + err;
+        return IoStatus::kFailed;
+    }
+    return IoStatus::kOk;
+}
+
+IoStatus RemoteRung::stage(int32_t layer, int32_t expert, std::vector<uint8_t>& out, std::string& err) {
+    if (re_.seabraid_closed() != 0) { err = "the card is closed"; return IoStatus::kRefused; }
+    out.resize((size_t) strata::kernels::cpu::expert_layout().blob_bytes(layer));
+    uint8_t* dst = out.data();
+    uint8_t hit = 0;
+    const bool ok = re_.copy_cached_blobs(&layer, &expert, &dst, 1, &hit, err);
+    if (!ok || !hit) {   // a read touches no slot: refused either way (a hung card fails its next layer request loudly)
+        if (err.empty()) err = "the card does not hold layer " + std::to_string(layer) + " expert " + std::to_string(expert);
+        out.clear();
+        return IoStatus::kRefused;
+    }
+    return IoStatus::kOk;
+}
+
+IoStatus RemoteRung::replace(int32_t layer, int32_t old_e, int32_t new_e, const std::vector<uint8_t>& bytes, std::string& err) {
+    (void) bytes;   // no blob-load op on the wire yet: the card reads new_e from its own source (same pack, same bytes)
+    // An in-place rewrite would be SWAP(old, old), which ExpertCache::replace turns into "not resident"; the map never
+    // asks a channel card for one (it closes a torn channel card instead), and this refuses it in case that changes.
+    if (old_e == new_e) { err = "an in-place slot rewrite has no wire form"; return IoStatus::kRefused; }
+    seabraid::TierWireOp op{};
+    op.kind = seabraid::kTierSwap;
+    op.helper = 0;
+    op.layer_old = layer; op.expert_old = old_e;
+    op.layer_new = layer; op.expert_new = new_e;
+    uint8_t res = (uint8_t) seabraid::kTierPending;
+    const bool ok = re_.seabraid_retier(&op, 1, &res, nullptr, err);
+    switch (re_.seabraid_closed()) {   // seabraid_retier closes the card itself on a timeout or a torn slot
+        case 1: return IoStatus::kTimeout;
+        case 2: return IoStatus::kFailed;
+        default: break;
+    }
+    if (ok && res == (uint8_t) seabraid::kTierApplied) return IoStatus::kOk;
+    return IoStatus::kRefused;   // kTierRejected: the helper refused before touching the slot
+}
+
+std::vector<int8_t> derive_rungs(const std::vector<int32_t>& host_res, const RemoteExperts& card2, int64_t layers, int64_t experts,
+                                 int64_t* both) {
+    std::vector<int8_t> r((size_t) (layers * experts), 2);
+    int64_t dup = 0;
+    for (int64_t l = 0; l < layers; ++l)
+        for (int64_t e = 0; e < experts; ++e) {
+            const size_t i = (size_t) (l * experts + e);
+            const bool c1 = i < host_res.size() && host_res[i] >= 0, c2 = card2.holds(l, (int32_t) e);
+            r[i] = c1 ? 0 : c2 ? 1 : 2;
+            dup += c1 && c2;
+        }
+    if (both) *both = dup;
+    return r;
+}
+
+}  // namespace strata::core
