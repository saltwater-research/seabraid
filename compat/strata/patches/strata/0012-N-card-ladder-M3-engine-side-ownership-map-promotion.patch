--- /dev/null
+++ b/tests/core/ownership_map_test.cpp
@@ -0,0 +1,283 @@
+// M3: the ownership map and its transition (include/strata/core/ownership_map.hpp) on FAKE cards.  Host only, no GPU:
+//   g++ -std=c++17 -O1 -Wall -Wextra -Iinclude tests/core/ownership_map_test.cpp src/core/ownership_map.cpp -o ownership_map_test
+//
+// A fake card has slots of real bytes and its own residency view, and can be told to refuse, tear (kFailed) or time
+// out on its next stage/replace.  The source is a deterministic blob per (layer, expert).  After EVERY scenario
+// world_ok() checks the three things M3's gate names, on every cell:
+//   - exactly one executor, and it is never a closed rung;
+//   - the bytes behind every card executor equal the source's (a torn slot routed to fails here);
+//   - an open card's view and the map agree (no cell held by an open card that the map gives to someone else).
+// Sabotage runs (each edited into a copy of src/core/ownership_map.cpp, rebuilt, the named check seen to FAIL, restored)
+// are recorded in seabraid tests/SABOTAGE.md under "ownership_map_test".
+#include "strata/core/ownership_map.hpp"
+
+#include <cstdio>
+#include <deque>
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+using namespace strata::core;
+
+static int g_fail = 0;
+static const char* g_test = "?";
+#define CHECK(c) do { if (!(c)) { ++g_fail; std::printf("  FAIL [%s] %s:%d  %s\n", g_test, __FILE__, __LINE__, #c); } } while (0)
+
+static constexpr int L = 3, E = 8, kBlob = 48;
+
+static std::vector<uint8_t> source(int l, int e) {
+    std::vector<uint8_t> b(kBlob);
+    for (int i = 0; i < kBlob; ++i) b[(size_t) i] = (uint8_t) (l * 131 + e * 29 + i * 7 + 1);
+    return b;
+}
+
+struct FakeCard : RungIO {
+    bool takes_blob = true;                          // false = a card behind a channel: reads its own source
+    std::vector<std::vector<uint8_t>> slot;          // the bytes
+    std::map<std::pair<int, int>, int> view;         // its own residency: (layer, expert) -> slot
+    std::deque<IoStatus> stage_faults, replace_faults;
+    int replaces = 0;
+
+    void put(int l, int e) { view[{l, e}] = (int) slot.size(); slot.push_back(source(l, e)); }
+    bool holds(int l, int e) const { return view.count({l, e}) != 0; }
+    static IoStatus pop(std::deque<IoStatus>& q) { if (q.empty()) return IoStatus::kOk; IoStatus s = q.front(); q.pop_front(); return s; }
+
+    IoStatus stage(int32_t l, int32_t e, std::vector<uint8_t>& out, std::string& err) override {
+        const IoStatus f = pop(stage_faults);
+        if (f != IoStatus::kOk) { err = "injected"; return f; }
+        auto it = view.find({l, e});
+        if (it == view.end()) { err = "not held"; return IoStatus::kRefused; }
+        out = slot[(size_t) it->second];
+        return IoStatus::kOk;
+    }
+    IoStatus replace(int32_t l, int32_t old_e, int32_t new_e, const std::vector<uint8_t>& bytes, std::string& err) override {
+        ++replaces;
+        auto it = view.find({l, old_e});
+        if (it == view.end()) { err = "old not held"; return IoStatus::kRefused; }
+        const IoStatus f = pop(replace_faults);
+        if (f == IoStatus::kRefused) { err = "injected refusal"; return f; }
+        const int s = it->second;
+        const std::vector<uint8_t> want = takes_blob ? bytes : source(l, new_e);
+        if (f != IoStatus::kOk) {                    // a copy that started and did not finish: the slot is torn, the view stays
+            for (size_t i = 0; i < want.size() / 2; ++i) slot[(size_t) s][i] = want[i];
+            err = "injected tear";
+            return f;
+        }
+        slot[(size_t) s] = want;
+        view.erase(it);
+        view[{l, new_e}] = s;
+        return IoStatus::kOk;
+    }
+};
+
+// cards[0..n-1] + the fallback.  Layout per layer: card 1 holds experts 0,1; card 2 holds 2,3; card 3 (if any) 4,5;
+// the rest are on the fallback.
+struct World {
+    int n_cards;
+    std::vector<FakeCard> card;
+    std::vector<RungIO*> io;
+    OwnershipMap map;
+    explicit World(int cards, bool channel_lower = true) : n_cards(cards), card((size_t) cards) {
+        std::vector<int8_t> rung((size_t) (L * E), (int8_t) cards);
+        for (int l = 0; l < L; ++l)
+            for (int c = 0; c < cards; ++c)
+                for (int e = 2 * c; e < 2 * c + 2; ++e) { card[(size_t) c].put(l, e); rung[(size_t) (l * E + e)] = (int8_t) c; }
+        for (int c = 1; c < cards; ++c) card[(size_t) c].takes_blob = !channel_lower;
+        for (auto& c : card) io.push_back(&c);
+        io.push_back(nullptr);                       // the fallback has no I/O
+        std::string err;
+        if (!map.init(L, E, cards + 1, rung, err)) std::printf("init: %s\n", err.c_str());
+    }
+    // The gate's three checks over every cell.
+    bool world_ok() {
+        bool ok = true;
+        for (int l = 0; l < L; ++l)
+            for (int e = 0; e < E; ++e) {
+                const int ex = map.executor(l, e);
+                if (ex < 0 || ex >= map.rungs() || map.closed(ex)) { ok = false; std::printf("    cell (%d,%d): executor %d is closed or invalid\n", l, e, ex); continue; }
+                if (ex == map.fallback()) continue;   // the fallback reads the source: always whole
+                const FakeCard& c = card[(size_t) ex];
+                auto it = c.view.find({l, e});
+                if (it == c.view.end()) { ok = false; std::printf("    cell (%d,%d): executor card %d does not hold it\n", l, e, ex + 1); continue; }
+                if (c.slot[(size_t) it->second] != source(l, e)) { ok = false; std::printf("    cell (%d,%d): card %d's bytes are not the source's\n", l, e, ex + 1); }
+            }
+        for (int r = 0; r < n_cards; ++r) {
+            if (map.closed(r)) continue;
+            for (const auto& kv : card[(size_t) r].view)
+                if (map.owner(kv.first.first, kv.first.second) != r) {
+                    ok = false; std::printf("    card %d holds (%d,%d) but the map gives it to rung %d\n", r + 1, kv.first.first, kv.first.second,
+                                            map.owner(kv.first.first, kv.first.second));
+                }
+        }
+        return ok;
+    }
+    Prepared promote(int layer, int up, int down, int hi = 0) { return map.prepare(Promotion{layer, up, down, (int8_t) hi}, map.epoch(), io.data()); }
+};
+
+static void t_commit() {
+    g_test = "prepare + commit";
+    World w(2);
+    const uint64_t e0 = w.map.epoch();
+    Prepared p = w.promote(1, 2, 0);                 // card 2's expert 2 up, card 1's expert 0 down, layer 1
+    CHECK(p.state == MoveState::kPrepared);
+    CHECK(w.map.owner(1, 2) == 1 && w.map.owner(1, 0) == 0);   // nothing published before commit
+    CHECK(w.map.commit(p, w.io.data()) && p.state == MoveState::kCommitted);
+    CHECK(w.map.owner(1, 2) == 0 && w.map.owner(1, 0) == 1 && w.map.epoch() > e0);
+    CHECK(w.card[0].holds(1, 2) && w.card[1].holds(1, 0) && !w.card[0].holds(1, 0) && !w.card[1].holds(1, 2));
+    CHECK(w.world_ok());
+}
+
+static void t_rejected_untouched() {
+    g_test = "rejected before any write";
+    World w(2);
+    w.card[1].stage_faults.push_back(IoStatus::kRefused);
+    Prepared p = w.promote(0, 3, 1);
+    CHECK(p.state == MoveState::kRejected && w.card[0].replaces == 0 && w.card[1].replaces == 0);
+    Prepared q = w.promote(0, 0, 1);                 // up is not on the lower rung
+    CHECK(q.state == MoveState::kRejected);
+    Prepared r = w.map.prepare(Promotion{0, 3, 1, 0}, w.map.epoch() - 1, w.io.data());   // a stale snapshot
+    CHECK(r.state == MoveState::kRejected && r.why.find("epoch") != std::string::npos);
+    Prepared s = w.promote(0, 3, 1, 1);              // hi + 1 would be the fallback: no slot to write
+    CHECK(s.state == MoveState::kRejected);
+    CHECK(!w.map.commit(q, w.io.data()));            // only a prepared move commits
+    CHECK(w.world_ok());
+}
+
+static void t_upper_tears_then_restored() {
+    g_test = "upper card tears, restored";
+    World w(2);
+    w.card[0].replace_faults.push_back(IoStatus::kFailed);
+    Prepared p = w.promote(2, 3, 1);
+    CHECK(p.state == MoveState::kRolledBack && !w.map.closed(0));
+    CHECK(w.map.owner(2, 1) == 0 && w.card[0].holds(2, 1));
+    CHECK(p.blob_up == source(2, 3) && p.blob_down == source(2, 1));   // both blobs recoverable
+    CHECK(w.world_ok());
+}
+
+static void t_upper_tears_unrestorable() {
+    g_test = "upper card tears, restore fails";
+    World w(2);
+    w.card[0].replace_faults = {IoStatus::kFailed, IoStatus::kFailed};
+    Prepared p = w.promote(2, 3, 1);
+    CHECK(p.state == MoveState::kClosed && w.map.closed(0));
+    CHECK(w.map.executor(2, 1) == w.map.fallback());
+    CHECK(w.world_ok());
+}
+
+static void t_upper_timeout() {
+    g_test = "upper card times out";
+    World w(2);
+    w.card[0].replace_faults.push_back(IoStatus::kTimeout);
+    Prepared p = w.promote(0, 2, 0);
+    CHECK(p.state == MoveState::kClosed && w.map.closed(0) && w.card[0].replaces == 1);   // never written to again
+    CHECK(w.world_ok());
+}
+
+static void t_lower_refused() {
+    g_test = "lower card refuses";
+    World w(2);
+    w.card[1].replace_faults.push_back(IoStatus::kRefused);
+    Prepared p = w.promote(1, 3, 0);
+    CHECK(p.state == MoveState::kRolledBack && !w.map.closed(0) && !w.map.closed(1));
+    CHECK(w.card[0].holds(1, 0) && !w.card[0].holds(1, 3) && w.card[1].holds(1, 3));
+    CHECK(w.world_ok());
+}
+
+static void t_lower_failed_sync() {
+    g_test = "lower card's sync fails";
+    World w(2);
+    w.card[1].replace_faults.push_back(IoStatus::kFailed);
+    Prepared p = w.promote(1, 3, 0);
+    CHECK(p.state == MoveState::kClosed && w.map.closed(1) && !w.map.closed(0));
+    CHECK(w.map.owner(1, 3) == 1 && w.map.owner(1, 0) == 0);           // the old owners are intact
+    CHECK(w.map.executor(1, 3) == w.map.fallback());                    // ... and the closed one is not routed to
+    CHECK(w.card[0].holds(1, 0) && w.card[0].slot[(size_t) w.card[0].view[std::make_pair(1, 0)]] == source(1, 0));
+    CHECK(p.blob_up == source(1, 3) && p.blob_down == source(1, 0));   // both blobs recoverable
+    CHECK(w.world_ok());
+}
+
+static void t_lower_timeout_fails_closed() {
+    g_test = "lower card times out: fail closed";
+    World w(2);
+    w.card[1].replace_faults.push_back(IoStatus::kTimeout);
+    const uint64_t e0 = w.map.epoch();
+    Prepared p = w.promote(0, 2, 1);
+    CHECK(p.state == MoveState::kClosed && w.map.closed(1) && w.map.epoch() > e0);
+    for (int l = 0; l < L; ++l)
+        for (int e = 0; e < E; ++e) CHECK(w.map.executor(l, e) != 1);  // no cell is routed to the closed card
+    CHECK(w.world_ok());
+    Prepared q = w.promote(1, 2, 0);                                     // and nothing new is planned onto it
+    CHECK(q.state == MoveState::kRejected);
+}
+
+static void t_commit_lost_race() {
+    g_test = "the map moved before commit";
+    World w(3);
+    Prepared p = w.promote(0, 2, 0);
+    CHECK(p.state == MoveState::kPrepared);
+    w.map.close(2);                                  // a close elsewhere moves the epoch
+    CHECK(!w.map.commit(p, w.io.data()) && p.state == MoveState::kRolledBack);
+    CHECK(w.map.owner(0, 2) == 1 && w.card[1].holds(0, 2) && w.card[0].holds(0, 0));
+    CHECK(w.world_ok());
+}
+
+static void t_abort() {
+    g_test = "abort after prepare";
+    World w(2);
+    Prepared p = w.promote(2, 2, 1);
+    CHECK(p.state == MoveState::kPrepared);
+    w.map.abort(p, w.io.data());
+    CHECK(p.state == MoveState::kRolledBack && w.card[0].holds(2, 1) && w.card[1].holds(2, 2));
+    CHECK(w.world_ok());
+    Prepared q = w.promote(2, 2, 1);
+    w.card[1].replace_faults.push_back(IoStatus::kFailed);              // the lower card cannot take `up` back
+    w.map.abort(q, w.io.data());
+    CHECK(q.state == MoveState::kClosed && w.map.closed(1) && !w.map.closed(0));
+    CHECK(w.world_ok());
+}
+
+static void t_three_cards_one_rung() {
+    g_test = "three cards: card 3 -> card 2";
+    World w(3);
+    Prepared p = w.promote(1, 4, 2, 1);
+    CHECK(p.state == MoveState::kPrepared && w.map.commit(p, w.io.data()));
+    CHECK(w.map.owner(1, 4) == 1 && w.map.owner(1, 2) == 2 && w.card[0].replaces == 0);
+    Prepared q = w.promote(1, 4, 0, 0);              // and on up to card 1 in a later move, one rung at a time
+    CHECK(q.state == MoveState::kPrepared && w.map.commit(q, w.io.data()) && w.map.owner(1, 4) == 0);
+    CHECK(w.world_ok());
+}
+
+static void t_adopt() {
+    g_test = "adopt";
+    World w(2);
+    std::vector<int8_t> r = w.map.snapshot().rung_of;
+    std::string err;
+    std::vector<int64_t> by;
+    const uint64_t e0 = w.map.epoch();
+    CHECK(w.map.adopt(r, err, &by) == 0 && w.map.epoch() == e0);
+    r[(size_t) (0 * E + 6)] = 0; r[(size_t) (0 * E + 1)] = 2;            // the engine's own adapt swapped a card-1 expert with RAM
+    CHECK(w.map.adopt(r, err, &by) == 2 && by[0] == 2 && by[1] == 0 && by[2] == 2 && w.map.epoch() > e0);
+    r.pop_back();
+    CHECK(w.map.adopt(r, err) == -1 && !err.empty());
+    w.map.close(1);
+    std::vector<int8_t> s = w.map.snapshot().rung_of;
+    CHECK(w.map.adopt(s, err) == 0 && w.map.closed(1));                 // adopt never reopens a closed rung
+}
+
+int main() {
+    t_commit();
+    t_rejected_untouched();
+    t_upper_tears_then_restored();
+    t_upper_tears_unrestorable();
+    t_upper_timeout();
+    t_lower_refused();
+    t_lower_failed_sync();
+    t_lower_timeout_fails_closed();
+    t_commit_lost_race();
+    t_abort();
+    t_three_cards_one_rung();
+    t_adopt();
+    std::printf("ownership_map_test: %s (%d failures)\n", g_fail ? "FAIL" : "all checks passed", g_fail);
+    return g_fail ? 1 : 0;
+}
