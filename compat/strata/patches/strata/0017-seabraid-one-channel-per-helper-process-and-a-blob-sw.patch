+bool RemoteExperts::seabraid_retier_blob(const seabraid::TierWireOp& op, const uint8_t* bytes, size_t n, uint8_t& res, std::string& err) {
+    if (!bl_) { err = "seabraid retier: no helper channel is open"; return false; }
+    if (op.kind != seabraid::kTierSwap && op.kind != seabraid::kTierSwapBlob) { err = "seabraid retier: a blob round carries one swap"; return false; }
+    if (op.layer_old != op.layer_new || op.layer_new < 0 || (size_t) op.layer_new >= layers_present_.size()) {
+        err = "seabraid retier: a blob swap is same-layer and inside the model"; return false;
+    }
+    const size_t need = (size_t) strata::kernels::cpu::expert_layout().blob_bytes(op.layer_new);
+    if (bytes == nullptr || n != need || (int64_t) need > bl_->limits().blob_max) {
+        err = "seabraid retier: the blob is " + std::to_string((unsigned long long) n) + " bytes; layer " + std::to_string(op.layer_new) +
+              " needs " + std::to_string((unsigned long long) need) + " and a channel slot holds " + std::to_string((long long) bl_->limits().blob_max);
+        return false;
+    }
+    // Slot 0 is also the prompt path's (copy_cached_blobs): read_mu_ keeps a stager from overwriting it until the round is acked.
+    std::lock_guard<std::mutex> lock(read_mu_);
+    seabraid::TierWireOp wire = op, plain = op;
+    wire.kind = seabraid::kTierSwapBlob; wire.blob_slot = 0; wire.helper = 0;
+    plain.kind = seabraid::kTierSwap; plain.blob_slot = 0;
+    uint8_t r = seabraid::kTierPending;
+    // A closed card is refused before the slot is written (seabraid_round refuses it too, after the write, so this one saves the copy).
+    if (bl_closed_.load(std::memory_order_relaxed) != 0) { err = "seabraid retier: this card is CLOSED (an earlier round timed out or tore a slot)"; return false; }
+    std::memcpy(bl_->blob(0), bytes, need);
+    const bool ok = seabraid_round(&wire, &plain, 1, &r, nullptr, err);
+    res = r;
+    return ok;
+}
