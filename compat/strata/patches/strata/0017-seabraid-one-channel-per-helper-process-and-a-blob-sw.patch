+bool RemoteExperts::tier_verify(int layer, int expert, const uint8_t* blob, std::string& err) {
+    if (bl_ != nullptr || blob == nullptr) { err = "tier_verify: the HELPER side reads its own slot, with the bytes to compare"; return false; }
+    DeviceScope scope(device_);
+    if (!scope.ok) { err = scope.error(device_); return false; }
+    const int32_t slot = cache_.slot_of(layer, expert);
+    if (slot < 0) { err = "tier_verify: layer " + std::to_string(layer) + " expert " + std::to_string(expert) + " is not resident"; return false; }
+    const int64_t need = (int64_t) strata::kernels::cpu::expert_layout().blob_bytes(layer);
+    if (cache_.verify_slot(slot, blob, err, need)) return true;
+    tier_quarantine(layer, expert);   // the slot is torn: published as holding nothing, never written again (fail closed)
+    return false;
+}
