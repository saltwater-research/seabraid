+namespace seabraid {
+bool channel_name(int card, std::string& name, std::string& err) {
+    const char* env = std::getenv("SEABRAID_STRATA_SHM");
+    if (env == nullptr) {   // the one-helper default
+        if (card != 0) { err = "seabraid: helper " + std::to_string(card) + " needs SEABRAID_STRATA_SHM to list its channel; it is unset"; return false; }
+        name = "/seabraid0";
+        return true;
+    }
+    std::vector<std::string> list;
+    if (!parse_channel_list(env, list, err)) return false;
+    if (card < 0 || (size_t) card >= list.size()) {
+        err = "seabraid: helper " + std::to_string(card) + " has no channel; SEABRAID_STRATA_SHM lists " + std::to_string(list.size());
+        return false;
+    }
+    name = list[(size_t) card];
+    return true;
+}
+}  // namespace seabraid
