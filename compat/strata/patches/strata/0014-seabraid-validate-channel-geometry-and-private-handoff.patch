                        usleep(100000); continue; }
             ok = seabraid::Channel::wait([&] { return ch.header()->state.load(std::memory_order_acquire) >= seabraid::kHelperUp; }, 60);
+            if (!ok) { err = "seabraid helper did not publish readiness within 60 s"; return false; }
         }
         if (!ok) { if (err.empty()) err = "seabraid helper did not come up"; return false; }
         free_gib = ch.header()->free_gib;
@@ -611,7 +612,7 @@ bool RemoteExperts::seabraid_open(int slots, int64_t layers, int64_t experts,
     {   // the channel's blob slots must hold this engine's largest blob
         int64_t need = 0;
         for (int64_t l = 0; l < layers; ++l) need = std::max<int64_t>(need, (int64_t) lay.blob_bytes(l));
-        if (hd->blob_max < need) { err = "seabraid: the helper's blob slots are smaller than this model's blobs"; device_ = -1; return false; }
+        if (ch->limits().blob_max < need) { err = "seabraid: the helper's blob slots are smaller than this model's blobs"; device_ = -1; return false; }
     }
     bl_thread_ = std::this_thread::get_id();   // the fence asserts against this
     bl_ = std::move(ch);
@@ -757,11 +758,13 @@ bool RemoteExperts::seabraid_retier(const seabraid::TierWireOp* ops, int32_t n,
 
     // (3) Per-op results first, before anything is believed about residency.
     seabraid::Header* hd = bl_->header();
-    const int32_t got = hd->tier_n < n ? hd->tier_n : n;
-    if (res != nullptr) {
-        for (int32_t i = 0; i < got; ++i) res[i] = hd->tier_res[i];
-        for (int32_t i = got; i < n; ++i) res[i] = (uint8_t) seabraid::kTierPending;
+    if (hd->tier_n != n) {
+        if (res != nullptr) std::fill_n(res, n, (uint8_t) seabraid::kTierPending);
+        err = "seabraid retier: helper echoed a different operation count";
+        seabraid_close(1, err);
+        return false;
     }
+    if (res != nullptr) std::copy_n(hd->tier_res, n, res);
     const bool ok = hd->tier_ok != 0;
     hd->tier_err[sizeof(hd->tier_err) - 1] = '\0';
     const std::string why = ok ? std::string() : std::string(hd->tier_err);
@@ -792,7 +795,7 @@ bool RemoteExperts::seabraid_retier(const seabraid::TierWireOp* ops, int32_t n,
     // is stale and this engine is now routing experts to slots that no longer hold them -- say so loudly.
     if (cells > 0 && bl_held_.size() == cells) {
         uint8_t rr[seabraid::kTierMaxOps];
-        for (int32_t i = 0; i < n; ++i) rr[i] = i < got ? hd->tier_res[i] : (uint8_t) seabraid::kTierPending;
+        for (int32_t i = 0; i < n; ++i) rr[i] = hd->tier_res[i];
         std::string why2;
         if (!seabraid::tier_residency_consistent(bl_held_.data(), (int64_t) layers_present_.size(), n_expert_, ops, rr, n, why2)) {
             err = "seabraid retier: helper residency is STALE after an applied round (" + why2 + ")";
@@ -802,7 +805,7 @@ bool RemoteExperts::seabraid_retier(const seabraid::TierWireOp* ops, int32_t n,
         // A FAILED op (as opposed to REJECTED) started a copy into a slot that did not complete: the helper has
         // quarantined it and published it as holding nothing, but which other rows it may have shared a sync with is
         // not known here, so the card closes (N-card ladder contract: a failed sync fails CLOSED).
-        for (int32_t i = 0; i < got; ++i)
+        for (int32_t i = 0; i < n; ++i)
             if (hd->tier_res[i] == (uint8_t) seabraid::kTierFailed) {
                 err = "seabraid retier: op " + std::to_string(i) + " FAILED after its copy started" + (why.empty() ? std::string() : ": " + why);
                 seabraid_close(2, err);
