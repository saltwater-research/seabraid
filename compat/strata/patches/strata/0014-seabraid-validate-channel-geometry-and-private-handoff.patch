From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Seabraid <seabraid@example.invalid>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: [PATCH 14/16] seabraid: validate channel geometry and private handoff

Check shared region sizes before use and retain the validated bounds for
request handling. Keep the v7 layout and named transport. Provide a
Linux descriptor transport that seals the mapping extent before publish.

The include/strata/seabraid/channel.hpp (and expert_spec.hpp) half of this change lives in Seabraid's
adapters/strata/wire, the wire's one owner; this patch keeps only the engine side.
---
 include/strata/seabraid/prefill_wire.hpp | 16 ++++++++++------
 src/core/remote_experts.cpp              | 17 ++++++++++-------
 src/core/remote_prefill.cpp              | 18 ++++++++++--------
 3 files changed, 30 insertions(+), 21 deletions(-)

diff --git a/include/strata/seabraid/prefill_wire.hpp b/include/strata/seabraid/prefill_wire.hpp
index c33052104..dd6c62000 100644
--- a/include/strata/seabraid/prefill_wire.hpp
+++ b/include/strata/seabraid/prefill_wire.hpp
@@ -31,7 +31,9 @@ inline int64_t pack_prefill_request(const Channel& ch, int32_t layer, int64_t t0
                                     const void* rows, int32_t row_bytes, const float* w, const int32_t* ids,
                                     const uint8_t* remote_e, int64_t n_expert) {
     Header* h = ch.header();
-    if (n <= 0 || n > h->pf_tokens || k != h->pf_k || hidden != h->hidden || (row_bytes != kPfRowsF16 && row_bytes != kPfRowsF32)) return -1;
+    const auto& limits = ch.limits();
+    if (n <= 0 || n > limits.pf_tokens || k != limits.pf_k || hidden != limits.hidden ||
+        (row_bytes != kPfRowsF16 && row_bytes != kPfRowsF32)) return -1;
     std::memcpy(ch.pf_rows(), (const uint8_t*) rows + (size_t) (t0 * hidden) * (size_t) row_bytes, (size_t) (n * hidden) * (size_t) row_bytes);
     h->pf_row_bytes = row_bytes;
     int32_t* pick = ch.pf_pick();
@@ -139,11 +141,13 @@ inline bool serve_prefill(const Channel& ch, Backend& be, int64_t n_expert, int6
     Header* h = ch.header();
     const auto t_start = std::chrono::steady_clock::now();
     const int32_t layer = h->pf_layer;
-    const int64_t n = h->pf_ntok, k = h->pf_k;
-    bool ok = n >= 1 && n <= h->pf_tokens && layer >= 0 && layer < h->n_layers && h->pf_format == kPfFp16 &&
-              (h->pf_row_bytes == kPfRowsF16 || h->pf_row_bytes == kPfRowsF32);
+    const auto& limits = ch.limits();
+    const int64_t n = h->pf_ntok, k = limits.pf_k;
+    const int32_t row_bytes = h->pf_row_bytes;
+    bool ok = n >= 1 && n <= limits.pf_tokens && layer >= 0 && layer < limits.layers && h->pf_format == kPfFp16 &&
+              (row_bytes == kPfRowsF16 || row_bytes == kPfRowsF32);
     if (!ok) err = "prefill request: layer " + std::to_string(layer) + ", " + std::to_string((long long) n) + " tokens (region holds " +
-                   std::to_string((long long) h->pf_tokens) + ")";
+                   std::to_string((long long) limits.pf_tokens) + ")";
     int64_t picks = 0;
     std::vector<PrefillBatch> plan;
     if (ok) {
@@ -158,7 +162,7 @@ inline bool serve_prefill(const Channel& ch, Backend& be, int64_t n_expert, int6
         }
         ok = ok && plan_prefill_batches(pick, n, k, n_expert, max_entries, plan, err);
     }
-    ok = ok && be.begin(layer, ch.pf_rows(), h->pf_row_bytes, n, err);
+    ok = ok && be.begin(layer, ch.pf_rows(), row_bytes, n, err);
     for (size_t i = 0; ok && i < plan.size(); ++i) ok = be.batch(layer, plan[i], ch.pf_wt(), err);
     ok = ok && be.end(ch.pf_out16(), n, err);
     h->pf_picks = ok ? (int32_t) picks : -1;
diff --git a/src/core/remote_experts.cpp b/src/core/remote_experts.cpp
index eea6bce25..30a1dcfe5 100644
--- a/src/core/remote_experts.cpp
+++ b/src/core/remote_experts.cpp
