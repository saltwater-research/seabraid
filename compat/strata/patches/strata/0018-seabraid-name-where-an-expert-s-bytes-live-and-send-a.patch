             const uint64_t per = role_bytes_[i];
             const uint8_t* p = role_ptr_[i] + (size_t) ((uint64_t) expert * per);
             const size_t f = (size_t) role_file_[i];
-            out[r] = {p, per, f < io_fds_.size() ? io_fds_[f] : -1, (uint64_t) (p - maps_[f].base), at};
