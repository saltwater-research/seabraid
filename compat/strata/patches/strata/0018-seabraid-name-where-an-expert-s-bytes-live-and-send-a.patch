+bool FileExpertSource::file_extents(int64_t layer, int64_t expert, FileExtent out[3], int& n) const {
+    n = 0;
+    Span sp[3];
+    const int ns = out != nullptr ? spans(layer, expert, sp) : 0;
+    for (int i = 0; i < ns; ++i)   // refuse the whole blob if any piece cannot be named (a FileExtent length is 32 bits)
+        if (sp[i].n == 0 || sp[i].n > 0xFFFFFFFFull || sp[i].file >= paths_.size()) return false;
+    for (int i = 0; i < ns; ++i) out[i] = {(uint32_t) sp[i].file, (uint32_t) sp[i].n, sp[i].off};
+    n = ns;
+    return ns > 0;
+}
