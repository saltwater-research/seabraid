diff --git a/tests/core/file_expert_source_test.cpp b/tests/core/file_expert_source_test.cpp
index 1cd85ba0a..4663e35cd 100644
--- a/tests/core/file_expert_source_test.cpp
+++ b/tests/core/file_expert_source_test.cpp
@@ -1053,6 +1053,53 @@ void test_replace_resident(bool pin) {
 
 }  // namespace
 
+// seabraid file moves: file_extents names exactly the bytes copy_blob assembles (one owner of addressing), for every cell, and
+// refuses a cell outside the model.  A canonical experts.bin pack (one extent per blob); the GGUF in place (three) shares spans().
+void test_file_extents_canonical() {
+    using namespace strata::core;
+    using namespace strata::kernels::cpu;
+    constexpr int64_t layers = 2;
+    constexpr int64_t experts = 3;
+    TempDirectory dir;
+    std::string err;
+    require(expert_layout_load(dir.path.string(), layers, experts, err), "could not load canonical layout: " + err);
+    const uint64_t total = (uint64_t) layers * (uint64_t) experts * BLOB;
+    create_pack(dir.path, total);
+    {   // distinct bytes everywhere, so a wrong offset cannot read the right bytes by luck
+        std::vector<char> bytes((size_t) total);
+        for (size_t i = 0; i < bytes.size(); ++i) bytes[i] = (char) ((i * 131u) ^ (i >> 7) ^ (i >> 15));
+        std::ofstream out(dir.path / "experts.bin", std::ios::binary | std::ios::trunc);
+        out.write(bytes.data(), (std::streamsize) bytes.size());
+        require((bool) out, "could not fill synthetic experts.bin");
+    }
+    FileExpertSource source;
+    require(source.open(dir.path.string(), layers, experts, err), "could not map canonical pack: " + err);
+    require(source.file_paths().size() == 1 && fs::path(source.file_paths()[0]).filename() == "experts.bin",
+            "a canonical pack reads exactly one file, experts.bin");
+    std::ifstream file(source.file_paths()[0], std::ios::binary);
+    std::vector<char> assembled((size_t) BLOB), from_file((size_t) BLOB);
+    for (int64_t l = 0; l < layers; ++l)
+        for (int64_t e = 0; e < experts; ++e) {
+            FileExpertSource::FileExtent ex[3];
+            int n = -1;
+            require(source.file_extents(l, e, ex, n) && n == 1 && ex[0].file == 0 && ex[0].length == (uint32_t) BLOB,
+                    "a canonical blob is one extent of BLOB bytes in file 0");
+            require(source.copy_blob(l, e, (uint8_t*) assembled.data()), "copy_blob failed");
+            file.clear();
+            file.seekg((std::streamoff) ex[0].offset);
+            file.read(from_file.data(), (std::streamsize) from_file.size());
+            require((bool) file && assembled == from_file, "the bytes at file_extents are not the bytes copy_blob assembles");
+        }
+    FileExpertSource::FileExtent ex[3];
+    int n = 7;
+    require(!source.file_extents(-1, 0, ex, n) && n == 0 && !source.file_extents(0, -1, ex, n) &&
+                !source.file_extents(layers, 0, ex, n) && !source.file_extents(0, experts, ex, n) &&
+                !source.file_extents(0, 0, nullptr, n),
+            "file_extents accepted a cell outside the model or a null output");
+    source.close();
+    require(source.file_paths().empty() && !source.file_extents(0, 0, ex, n), "a closed source still names files");
+}
