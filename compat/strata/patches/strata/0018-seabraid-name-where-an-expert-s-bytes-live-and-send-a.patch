+bool RemoteExperts::seabraid_retier_file(const seabraid::TierWireOp& op, const seabraid::FileRef& ref, const uint64_t* file_size,
+                                        int32_t file_count, uint8_t& res, std::string& err) {
+    if (!bl_) { err = "seabraid retier: no helper channel is open"; return false; }
+    if (op.kind != seabraid::kTierSwap && op.kind != seabraid::kTierSwapFile) { err = "seabraid retier: a file round carries one swap"; return false; }
+    if (op.layer_old != op.layer_new || op.layer_new < 0 || (size_t) op.layer_new >= layers_present_.size()) {
+        err = "seabraid retier: a file swap is same-layer and inside the model"; return false;
+    }
+    if (bl_->header()->file_io == seabraid::kFileIoOff) { err = "seabraid retier: this helper serves no file moves (file_io 0)"; return false; }
+    // The same validation the helper runs, before anything is written: a ref the helper would refuse never reaches the channel.
+    std::string why;
+    const int64_t need = (int64_t) strata::kernels::cpu::expert_layout().blob_bytes(op.layer_new);
+    if (!seabraid::file_ref_valid(ref, file_size, file_count, need, bl_->limits().blob_max, why)) { err = "seabraid retier: " + why; return false; }
+    std::lock_guard<std::mutex> lock(read_mu_);   // slot 0 is also the prompt path's, as for a blob swap
+    seabraid::TierWireOp wire = op, plain = op;
+    wire.kind = seabraid::kTierSwapFile; wire.blob_slot = 0; wire.helper = 0;
+    plain.kind = seabraid::kTierSwap; plain.blob_slot = 0;
+    uint8_t r = seabraid::kTierPending;
+    if (bl_closed_.load(std::memory_order_relaxed) != 0) { err = "seabraid retier: this card is CLOSED (an earlier round timed out or tore a slot)"; return false; }
+    if (!seabraid::file_ref_to(bl_->blob(0), bl_->limits().blob_max, ref)) { err = "seabraid retier: a channel blob slot cannot hold a FileRef"; return false; }
+    const bool ok = seabraid_round(&wire, &plain, 1, &r, nullptr, err);
+    res = r;
+    return ok;
+}
