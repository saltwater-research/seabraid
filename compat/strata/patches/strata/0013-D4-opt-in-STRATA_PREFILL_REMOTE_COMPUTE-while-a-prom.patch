+    if (!card1.run(in.layer, in.x, in.T, in.experts.data(), ne, in.off, in.cnt, in.row_tok, in.Dm, files, in.stream, err)) return false;
+    d4_ref_sum(in.Dm, in.slot, in.w, in.from, ref_, in.T, in.stream);
+    // reference 2: the same on the fp16 image of the input, which is what the request carried
+    core::prefill_f16_to_f32(in.x16, xr_, (int64_t) n, in.stream);
+    if (!card1.run(in.layer, xr_, in.T, in.experts.data(), ne, in.off, in.cnt, in.row_tok, in.Dm, files, in.stream, err)) return false;
+    d4_ref_sum(in.Dm, in.slot, in.w, in.from, refh_, in.T, in.stream);
+    // the combine's own fp16 decode, executed on this device
+    d4_decode_f16(in.sum16, dec_, (int64_t) n, in.stream);
+    if (!cu(cudaMemcpyAsync(h_ref_.data(), ref_, n * 4, cudaMemcpyDeviceToHost, s), "ref down", err) ||
+        !cu(cudaMemcpyAsync(h_refh_.data(), refh_, n * 4, cudaMemcpyDeviceToHost, s), "refh down", err) ||
+        !cu(cudaMemcpyAsync(h_dec_.data(), dec_, n * 4, cudaMemcpyDeviceToHost, s), "dec down", err) ||
+        !cu(cudaStreamSynchronize(s), "sync", err)) return false;
+    std::vector<float> got(n), refh16(n);
+    size_t dec_bad = 0, got_ne_ref16 = 0;
+    for (size_t i = 0; i < n; ++i) {
+        got[i] = strata::kernels::f32_from_f16(in.sum16[i]);
+        refh16[i] = strata::kernels::f32_from_f16(strata::kernels::f16_from_f32(h_refh_[i]));
+        dec_bad += std::memcmp(&got[i], &h_dec_[i], 4) != 0 && !(std::isnan(got[i]) && std::isnan(h_dec_[i]));
+        got_ne_ref16 += std::memcmp(&got[i], &refh16[i], 4) != 0;
+    }
+    const Cmp e1 = compare(got.data(), h_ref_.data(), n), e2 = compare(got.data(), h_refh_.data(), n),
+              e3 = compare(h_refh_.data(), h_ref_.data(), n), e4 = compare(got.data(), refh16.data(), n);
+    const auto& f = strata::kernels::cpu::expert_layout().fmt[(size_t) in.layer];
+    double rms = 0;
+    for (size_t i = 0; i < n; ++i) rms += (double) h_ref_[i] * h_ref_[i];
+    std::fprintf(stderr,
+        "D4CHECK layer=%lld gu=%d d=%d had=%d%d experts=%d rms=%.4g"
+        " E1[nrmse=%.3e max=%.3e bias=%+.2e scale=%.5f] E2[%.3e %.3e %+.2e %.5f] E3[%.3e %.3e %+.2e %.5f]"
+        " E4[%.3e %.3e %+.2e %.5f] E4_bit_unequal=%.4f DEC_bad=%zu\n",
+        (long long) in.layer, f.gu_type, f.d_type, (int) f.had_gu, (int) f.had_d, ne, std::sqrt(rms / (double) n),
+        e1.nrmse, e1.maxrel, e1.bias, e1.scale, e2.nrmse, e2.maxrel, e2.bias, e2.scale, e3.nrmse, e3.maxrel, e3.bias, e3.scale,
+        e4.nrmse, e4.maxrel, e4.bias, e4.scale, (double) got_ne_ref16 / (double) n, dec_bad);
+    return true;
+}
