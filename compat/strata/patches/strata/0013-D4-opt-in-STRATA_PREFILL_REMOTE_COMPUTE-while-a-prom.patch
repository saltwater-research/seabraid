+// D4 (STRATA_PREFILL_REMOTE_COMPUTE): prompt reading with the other card computing the experts it holds.  OWNER of the
+// card-1 side of the request (RemoteExperts::prefill_*), the expert process's device side (prefill_serve + NativePicks)
+// and nothing else: the region's bytes are channel.hpp's, the request's host logic prefill_wire.hpp's, the reduction
+// remote_expert_opt.cu's, and the prompt path only calls in (prefill.cpp).  See remote_prefill.hpp for the cost model.
+#include "strata/core/remote_prefill.hpp"
+#include "strata/core/remote_experts.hpp"
+#include "strata/core/remote_expert_opt.hpp"
+#include "strata/seabraid/prefill_wire.hpp"
+
+#include "strata/kernels/cpu/expert_layout.hpp"
+#include "strata/kernels/cpu/hadamard.hpp"
+#include "strata/kernels/iq_kernels.hpp"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
