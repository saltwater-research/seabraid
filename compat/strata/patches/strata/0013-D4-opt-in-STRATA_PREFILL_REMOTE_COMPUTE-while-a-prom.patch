+// STRATA_D4_CHECK: see d4_check.hpp.  Diagnostic only - nothing here runs unless the variable is set, and the layer's output
+// is still the expert process's (the reference rows go to Dm rows the combine does not read: rows >= rem_at).
+#include "strata/prefill/d4_check.hpp"
+
+#include "strata/core/remote_expert_opt.hpp"
+#include "strata/kernels/cpu/expert_layout.hpp"
+#include "strata/kernels/f16_bits.hpp"
