+namespace strata::core {
+namespace {
+constexpr int64_t H = strata::kernels::cpu::H;
+constexpr int64_t FF = strata::kernels::cpu::FF;
+// The expert process's sub-batch: picks per kernel launch.  Its rows (2048 x H f32 = 21 MB) and the kernels' scratch
+// (~17 MB) are DEVICE memory on a card that is full of experts, so they are bounded by this constant, not by the request.
+constexpr int64_t kServeEntries = 2048;
+
+bool ok_cuda(cudaError_t r, const char* what, std::string& err) {
+    if (r == cudaSuccess) return true;
+    err = std::string("D4 ") + what + ": " + cudaGetErrorString(r);
+    return false;
+}
+double env_or(const char* name, double dflt) {
+    const char* v = std::getenv(name);
+    return v != nullptr && std::atof(v) > 0 ? std::atof(v) : dflt;
+}
+} // namespace
+
+// ---- NativePicks -------------------------------------------------------------------------------------------------------
+NativePicks::~NativePicks() { release(); }
+
+void NativePicks::release() {
+    for (void** p : {&q8_, &xr_, &scratch_, &meta_}) { if (*p) cudaFree(*p); *p = nullptr; }
+    q8_cap_ = xr_cap_ = scratch_cap_ = meta_cap_ = 0;
+}
+
+bool NativePicks::grow(void** p, size_t& cap, size_t want, std::string& err) {
+    if (want <= cap) return true;
+    if (*p) cudaFree(*p);
+    *p = nullptr;
+    cap = 0;
+    if (!ok_cuda(cudaMalloc(p, want), "device buffer", err)) { *p = nullptr; return false; }
+    cap = want;
+    return true;
+}
+
+bool NativePicks::input(int64_t layer, const float* x_dev, int64_t n_tok, void* stream, std::string& err) {
+    const auto& lay = strata::kernels::cpu::expert_layout();
+    if (!lay.native || layer < 0 || (size_t) layer >= lay.fmt.size()) { err = "D4: the expert kernels need a native pack"; return false; }
+    const auto& fmt = lay.fmt[(size_t) layer];
+    const float* xe = x_dev;
+    if (fmt.had_gu) {   // APR: Hadamard-folded gate/up take H (s * x), exactly as RemoteExperts::begin rotates
+        if (!grow(&xr_, xr_cap_, (size_t) (n_tok * H) * sizeof(float), err)) return false;
+        if (sx_ == nullptr) sx_ = strata::kernels::hadamard_device_signs(strata::kernels::cpu::hadamard_signs((int) H), (int) H);
+        strata::kernels::hadamard_rows(x_dev, (float*) xr_, n_tok, H, fmt.had_block, sx_, stream);
+        xe = (const float*) xr_;
+    }
+    if (!grow(&q8_, q8_cap_, (size_t) n_tok * (size_t) (H / 32) * 36, err)) return false;
+    strata::kernels::quantize_q8_1_rows(xe, n_tok, H, q8_, stream);
+    n_tok_ = n_tok;
+    return ok_cuda(cudaGetLastError(), "input", err);
+}
+
+bool NativePicks::run(int64_t layer, const unsigned long long* ptr, const int32_t* start, int32_t ng, const int32_t* ent_row,
+                      const int32_t* ent_tok, int32_t ne, float* out_dev, void* stream, std::string& err) {
+    if (ng <= 0 || ne <= 0) return true;
+    const auto& fmt = strata::kernels::cpu::expert_layout().fmt[(size_t) layer];
+    // one upload for the five tables: [ptr ng | start ng+1 | count | dst ne | tok ne]
+    const size_t b_ptr = (size_t) ng * 8, b_start = ((size_t) ng + 1) * 4, b_cnt = 4, b_ent = (size_t) ne * 4;
+    const size_t bytes = b_ptr + b_start + b_cnt + 2 * b_ent;
+    if (!grow(&meta_, meta_cap_, bytes, err) ||
+        !grow(&scratch_, scratch_cap_, strata::kernels::native_expert_scratch_bytes(ne, FF), err)) return false;
+    host_.resize(bytes);
+    uint8_t* hm = host_.data();
+    std::memcpy(hm, ptr, b_ptr);
+    std::memcpy(hm + b_ptr, start, b_start);
+    std::memcpy(hm + b_ptr + b_start, &ng, b_cnt);
+    std::memcpy(hm + b_ptr + b_start + b_cnt, ent_row, b_ent);
+    std::memcpy(hm + b_ptr + b_start + b_cnt + b_ent, ent_tok, b_ent);
+    if (!ok_cuda(cudaMemcpyAsync(meta_, hm, bytes, cudaMemcpyHostToDevice, (cudaStream_t) stream), "tables", err)) return false;
+    auto* d = (uint8_t*) meta_;
+    auto L = strata::kernels::native_expert_layout(fmt.gu_type, fmt.d_type, fmt.n_embd, fmt.n_ff);
+    if (fmt.had_d) {
+        if (sh_ == nullptr) sh_ = strata::kernels::hadamard_device_signs(strata::kernels::cpu::hadamard_signs((int) FF), (int) FF);
+        L.had_block = fmt.had_block;
+        L.d_signs = sh_;
+    }
+    strata::kernels::native_expert_grouped(L, (const unsigned long long*) d, (const int32_t*) (d + b_ptr),
+                                           (const int32_t*) (d + b_ptr + b_start), (const int32_t*) (d + b_ptr + b_start + b_cnt),
+                                           (const int32_t*) (d + b_ptr + b_start + b_cnt + b_ent), ng, ne, q8_, scratch_,
+                                           out_dev, stream);
+    return ok_cuda(cudaGetLastError(), "expert kernels", err);
+}
+
+// ---- card 1's failure path ---------------------------------------------------------------------------------------------
+Card1Rows::~Card1Rows() {
+    if (host_) cudaFreeHost(host_);
+    if (blob_) cudaFree(blob_);
+}
+
+bool Card1Rows::run(int64_t layer, const float* x_dev, int64_t T, const int32_t* experts, int n, const int32_t* off,
+                    const int32_t* cnt, const int32_t* row_tok, float* Dm, ExpertSource& files, void* stream, std::string& err) {
+    const auto& lay = strata::kernels::cpu::expert_layout();
+    const size_t bytes = (size_t) lay.blob_bytes(layer);
+    if (cap_ < bytes) {
+        if (host_) cudaFreeHost(host_);
+        if (blob_) cudaFree(blob_);
+        host_ = nullptr; blob_ = nullptr; cap_ = 0;
+        if (!ok_cuda(cudaHostAlloc((void**) &host_, bytes, cudaHostAllocDefault), "fallback staging", err) ||
+            !ok_cuda(cudaMalloc(&blob_, bytes), "fallback blob", err)) return false;
+        cap_ = bytes;
+    }
+    if (!np_.input(layer, x_dev, T, stream, err)) return false;
+    std::vector<int32_t> rows, toks;
+    for (int i = 0; i < n; ++i) {
+        const int32_t e = experts[i], c = cnt[e];
+        if (c <= 0) continue;
+        if (!files.copy_blob(layer, e, host_)) {
+            err = "D4 fallback: the files have no blob for layer " + std::to_string(layer) + " expert " + std::to_string(e);
+            return false;
+        }
+        rows.clear(); toks.clear();
+        for (int32_t r = off[e]; r < off[e] + c; ++r) { rows.push_back(r); toks.push_back(row_tok[r]); }
+        const unsigned long long ptr = (unsigned long long) blob_;
+        const int32_t start[2] = {0, c};
+        if (!ok_cuda(cudaMemcpyAsync(blob_, host_, bytes, cudaMemcpyHostToDevice, (cudaStream_t) stream), "fallback copy", err) ||
+            !np_.run(layer, &ptr, start, 1, rows.data(), toks.data(), c, Dm, stream, err) ||
+            // the staging and the device blob are the next expert's: this one must be done with them
+            !ok_cuda(cudaStreamSynchronize((cudaStream_t) stream), "fallback sync", err)) return false;
+    }
+    return true;
+}
+
+// ---- the expert process: serve one request on this card -----------------------------------------------------------------
+struct RemoteExperts::PrefillGpu {
+    NativePicks np;
+    uint16_t *x16 = nullptr, *out16 = nullptr;
+    float *x = nullptr, *rows = nullptr, *wt = nullptr;
+    int32_t *row_of = nullptr, *bad = nullptr;
+    int64_t tokens = 0, k = 0;
+    std::vector<unsigned long long> ptr;
+    ~PrefillGpu() {
+        for (void* p : {(void*) x16, (void*) out16, (void*) x, (void*) rows, (void*) wt, (void*) row_of, (void*) bad})
+            if (p) cudaFree(p);
+    }
+};
+void RemoteExperts::PrefillGpuDel::operator()(PrefillGpu* p) const { delete p; }
+
+namespace {
+/// serve_prefill's backend on this card: the request's rows up, NativePicks per batch, the reduction, the sums down.
+/// Pageable copies to and from the shm region, on purpose: registering /dev/shm with the GPU runtime would make it a KFD
+/// userptr on an AMD expert card - the very eviction hazard the region's token sizing exists to avoid.
+struct GpuBackend {
+    RemoteExperts::PrefillGpu& g;
+    const ExpertCache& cache;
+    cudaStream_t s;
+    bool holds(int32_t layer, int32_t e) const { return cache.slot_of(layer, e) >= 0; }
+    bool begin(int32_t layer, const void* rows, int32_t row_bytes, int64_t n, std::string& err) {
+        if (!ok_cuda(cudaMemsetAsync(g.bad, 0, sizeof(int32_t), s), "flag", err)) return false;
+        if (row_bytes == seabraid::kPfRowsF32) {   // card 1's own f32 rows: straight to the activation buffer, no rounding anywhere
+            if (!ok_cuda(cudaMemcpyAsync(g.x, rows, (size_t) (n * H) * 4, cudaMemcpyHostToDevice, s), "rows up", err)) return false;
+        } else {
+            if (!ok_cuda(cudaMemcpyAsync(g.x16, rows, (size_t) (n * H) * 2, cudaMemcpyHostToDevice, s), "rows up", err)) return false;
+            prefill_f16_to_f32(g.x16, g.x, n * H, s);
+        }
+        return g.np.input(layer, g.x, n, s, err);
+    }
+    bool batch(int32_t layer, const seabraid::PrefillBatch& b, const float* wt, std::string& err) {
+        const int32_t ng = (int32_t) b.grp_expert.size(), ne = (int32_t) b.ent_tok.size();
+        const int64_t nt = b.t1 - b.t0;
+        g.ptr.resize((size_t) ng);
+        for (int32_t i = 0; i < ng; ++i) {
+            const int32_t slot = cache.slot_of(layer, b.grp_expert[(size_t) i]);
+            if (slot < 0) { err = "D4: expert " + std::to_string(b.grp_expert[(size_t) i]) + " left the cache"; return false; }
+            g.ptr[(size_t) i] = (unsigned long long) cache.device_slot(slot);
+        }
+        return ok_cuda(cudaMemcpyAsync(g.row_of, b.row_of.data(), (size_t) (nt * g.k) * 4, cudaMemcpyHostToDevice, s), "row table", err) &&
+               ok_cuda(cudaMemcpyAsync(g.wt, wt + (size_t) b.t0 * (size_t) g.k, (size_t) (nt * g.k) * 4, cudaMemcpyHostToDevice, s),
+                       "weights", err) &&
+               g.np.run(layer, g.ptr.data(), b.grp_start.data(), ng, b.ent_row.data(), b.ent_tok.data(), ne, g.rows, s, err) &&
+               (prefill_reduce_f16(g.rows, g.row_of, g.wt, nt, g.k, g.out16 + (size_t) b.t0 * H, g.bad, s),
+                ok_cuda(cudaGetLastError(), "reduce", err));
+    }
+    bool end(uint16_t* out16, int64_t n, std::string& err) {
+        int32_t bad = 0;
+        if (!ok_cuda(cudaMemcpyAsync(&bad, g.bad, sizeof(bad), cudaMemcpyDeviceToHost, s), "flag down", err) ||
+            !ok_cuda(cudaMemcpyAsync(out16, g.out16, (size_t) (n * H) * 2, cudaMemcpyDeviceToHost, s), "sums down", err) ||
+            !ok_cuda(cudaStreamSynchronize(s), "sync", err)) return false;
+        if (bad) { err = "D4: a weighted sum is not finite in fp16"; return false; }
+        return true;
+    }
+};
+} // namespace
+
+bool RemoteExperts::prefill_serve(const seabraid::Channel& ch, std::string& err) {
+    const seabraid::Header* h = ch.header();
+    if (bl_ || device_ < 0) { err = "D4: prefill_serve runs in the expert process, on its own cache"; return false; }
+    int prev = -1;
+    if (!ok_cuda(cudaGetDevice(&prev), "cudaGetDevice", err) || !ok_cuda(cudaSetDevice(device_), "cudaSetDevice", err)) return false;
+    struct Back { int d; ~Back() { cudaSetDevice(d); } } back{prev};
+    if (!pf_gpu_ || pf_gpu_->tokens < h->pf_tokens || pf_gpu_->k != h->pf_k) {   // first request: size by the region's TOKENS
+        pf_gpu_.reset(new PrefillGpu);
+        PrefillGpu& g = *pf_gpu_;
+        g.tokens = h->pf_tokens; g.k = h->pf_k;
+        const size_t T = (size_t) g.tokens, K = (size_t) g.k;
+        if (!ok_cuda(cudaMalloc((void**) &g.x16, T * H * 2), "rows", err) || !ok_cuda(cudaMalloc((void**) &g.out16, T * H * 2), "sums", err) ||
+            !ok_cuda(cudaMalloc((void**) &g.x, T * H * 4), "rows f32", err) ||
+            !ok_cuda(cudaMalloc((void**) &g.rows, (size_t) kServeEntries * H * 4), "pick rows", err) ||
+            !ok_cuda(cudaMalloc((void**) &g.wt, T * K * 4), "weights", err) || !ok_cuda(cudaMalloc((void**) &g.row_of, T * K * 4), "row table", err) ||
+            !ok_cuda(cudaMalloc((void**) &g.bad, 4), "flag", err)) { pf_gpu_.reset(); return false; }
+    }
+    GpuBackend be{*pf_gpu_, cache_, stream_};
+    return seabraid::serve_prefill(ch, be, n_expert_, kServeEntries, err);
+}
+
+// ---- card 1 ----------------------------------------------------------------------------------------------------------------
+bool RemoteExperts::prefill_open(int64_t k, std::string& err) {
+    pf_open_ = pf_dead_ = pf_pending_ = false;
+    if (!bl_) { err = "D4: the expert tier is not a seabraid expert process"; return false; }
+    const seabraid::Header* h = bl_->header();
+    // Open-time mismatch fails fast, naming both sides: a region of another width or format would be read as shifted
+    // picks or as the wrong number type - wrong sums, never a crash.
+    if (h->pf_tokens <= 0) {
+        err = "D4: the expert process offers no prefill region (pf_tokens 0, channel v" + std::to_string(h->version) +
+              "); card 1 wants k " + std::to_string((long long) k) + " fp16 rows: start seabraid-helper with --prefill-tokens N";
+        return false;
+    }
+    if (h->pf_k != k || h->pf_format != seabraid::kPfFp16) {
+        err = "D4: prefill region mismatch: expert process k " + std::to_string(h->pf_k) + " format " + std::to_string(h->pf_format) +
+              ", card 1 k " + std::to_string((long long) k) + " format " + std::to_string((int) seabraid::kPfFp16) + " (fp16)";
+        return false;
+    }
+    const char* v = std::getenv("STRATA_PREFILL_REMOTE_COMPUTE");
+    pf_mode_ = v != nullptr && std::atoi(v) == 2 ? 2 : 1;
+    pf_lend_Bps_ = env_or("STRATA_D4_LEND_GBPS", kD4LendBps / 1e9) * 1e9;
+    pf_wire_Bps_ = env_or("STRATA_D4_WIRE_GBPS", kD4WireBps / 1e9) * 1e9;
+    pf_rate_ = env_or("STRATA_D4_PICK_RATE", kD4PickRate);
+    pf_layer_s_ = env_or("STRATA_D4_LAYER_US", kD4LayerS * 1e6) * 1e-6;
+    pf_k_ = k;
+    pf_open_ = true;
+    std::fprintf(stderr, "D4: prompt reading computes the experts %s holds on that card (%s): region %lld tokens/request "
+                         "(%.1f MiB), lend %.2f GB/s, wire %.2f GB/s, %.0f picks/s, %.0f us/layer\n",
+                 h->helper_name, pf_mode_ == 2 ? "every eligible chunk" : "per-chunk byte/time model", (long long) h->pf_tokens,
+                 (double) bl_->prefill_region().bytes / 1048576.0, pf_lend_Bps_ / 1e9, pf_wire_Bps_ / 1e9, pf_rate_, pf_layer_s_ * 1e6);
+    return true;
+}
+
+PrefillChoice RemoteExperts::prefill_choose(int64_t tokens, bool stream_all, int64_t layers, int64_t hidden, int64_t k, int row_bytes) {
+    PrefillChoice none;
+    if (!prefill_usable() || tokens <= 0) return none;
+    if (pf_pending_) {   // a prompt that failed between a request and its answer left it in flight: drain it, never read it
+        if (!seabraid::Channel::wait([&] { return pf_seq_ == 0 || bl_->pf_answered(pf_seq_); }, 60)) pf_dead_ = true;
+        pf_pending_ = false;
+        if (pf_dead_) return none;
+    }
+    if (const pid_t pid = (pid_t) bl_->header()->helper_pid; pid > 0 && ::kill(pid, 0) != 0 && errno == ESRCH) {
+        pf_dead_ = true;   // between chunks: this chunk (and every later one) lends
+        std::fprintf(stderr, "D4: the expert process (pid %d) is gone; the prompt lends\n", (int) pid);
+        return none;
+    }
+    const auto& lay = strata::kernels::cpu::expert_layout();
+    PrefillCostIn c;
+    c.tokens = tokens; c.layers = layers; c.k = k; c.n_expert = n_expert_; c.hidden = hidden; c.stream_all = stream_all;
+    int64_t held = 0;
+    for (size_t i = 0; i < bl_held_.size(); ++i)
+        if (bl_held_[i]) { ++held; c.remote_bytes += (double) lay.blob_bytes((int64_t) (i / (size_t) n_expert_)); }
+    // The pick share is MEASURED once requests have run (picks asked / pick slots offered); until then the held count's
+    // share, which overstates it (card 1 keeps the hottest experts) and so leans the first chunks towards lending.
+    c.pick_share = pf_slots_ > 0 ? (double) pf_picks_ / (double) pf_slots_
+                                 : (double) held / (double) std::max<int64_t>(1, layers * n_expert_);
+    c.row_bytes = row_bytes;
+    c.lend_Bps = pf_lend_Bps_; c.wire_Bps = pf_wire_Bps_; c.pick_rate = pf_rate_; c.layer_s = pf_layer_s_;
+    // Once 20k picks have been served, the expert process's own service time per pick replaces the pick rate AND the wire
+    // term (its service time includes its copies in and out): measured beats estimated.
+    const seabraid::Header* h = bl_->header();
+    if (pf_picks_ >= 20000 && h->pf_svc_ns > 0) {
+        c.pick_rate = (double) pf_picks_ / ((double) h->pf_svc_ns * 1e-9);
+        c.wire_Bps = 1e30;
+    }
+    PrefillChoice r = prefill_cost(c);
+    if (pf_mode_ == 2) r.compute = true;
+    std::fprintf(stderr, "D4 chunk %lld tokens (%s): %s - lend %.2f GB %.3f s vs compute %.0f picks + %.2f GB %.3f s "
+                         "(share %.3f, %.0f picks/s; crossover %.0f tokens)\n",
+                 (long long) tokens, stream_all ? "streamed" : "staged", r.compute ? "COMPUTE on the expert card" : "lend",
+                 r.lend_bytes / 1e9, r.t_lend, r.picks, r.wire_bytes / 1e9, r.t_compute, c.pick_share, c.pick_rate,
+                 prefill_crossover_tokens(c));
+    return r;
+}
+
+bool RemoteExperts::pf_range(std::string& err) {
+    pf_tn_ = std::min<int64_t>(pf_ntok_ - pf_t0_, bl_->header()->pf_tokens);
+    pf_asked_ = seabraid::pack_prefill_request(*bl_, (int32_t) pf_layer_, pf_t0_, pf_tn_, H, pf_k_, pf_rows_, pf_row_bytes_, pf_w_, pf_ids_,
+                                              pf_mask_, n_expert_);
+    if (pf_asked_ < 0) { err = "D4: the request does not fit the prefill region"; return false; }
+    // A range without a pick of the expert process's needs no round trip: its sums are zero (prefill_end writes them).
+    pf_seq_ = pf_asked_ > 0 ? bl_->pf_publish() : 0;
+    return true;
+}
+
+bool RemoteExperts::prefill_begin(int64_t layer, const void* rows, int32_t row_bytes, const float* w, const int32_t* ids,
+                                  int64_t n_tok, int64_t k, const uint8_t* remote_e, std::string& err) {
+    if (!prefill_usable()) { err = "D4: prompt reading on the expert card is off (closed or failed earlier)"; return false; }
+    if (pf_pending_ || k != pf_k_ || n_tok <= 0) { err = "D4: a request is in flight, or a wrong routing width"; pf_dead_ = true; return false; }
+    pf_rows_ = rows; pf_row_bytes_ = row_bytes; pf_w_ = w; pf_ids_ = ids; pf_mask_ = remote_e;
+    pf_layer_ = layer; pf_ntok_ = n_tok; pf_t0_ = 0;
+    if (!pf_range(err)) { pf_dead_ = true; return false; }
+    pf_pending_ = true;
+    return true;
+}
+
+bool RemoteExperts::prefill_end(uint16_t* sums16, std::string& err) {
+    if (!pf_pending_) { err = "D4: no request in flight"; return false; }
+    pf_pending_ = false;
+    seabraid::Header* h = bl_->header();
+    const pid_t pid = (pid_t) h->helper_pid;
+    auto fail = [&](const std::string& why) {
+        // WHAT BREAKS FIRST under a crash between send and receive: this wait.  The expert process's pid is checked every
+        // 0.5 s and the wait gives up after 60 s, so card 1 never sums a stale region; it marks prompt reading on that card
+        // dead (later chunks lend) and its caller computes this layer's picks itself.  Loud, once per failure.
+        err = why;
