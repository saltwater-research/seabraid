index 000000000..c33052104
--- /dev/null
+++ b/include/strata/seabraid/prefill_wire.hpp
@@ -0,0 +1,172 @@
+#pragma once
+// seabraid D4: the host-side logic of a prefill request over the channel's v7 prefill region (channel.hpp owns the bytes'
+// layout; this file owns what goes into them and how the expert process walks them).  Host only, no GPU runtime: card 1,
+// the expert process and the CPU test all include it, so the three run ONE definition of the request.
+//
+//   card 1  : pack_prefill_request()  - one token range of one layer: fp16 rows, pick ids (-1 = not the expert process's),
+//                                       router weights; then Channel::pf_publish()
+//   process : serve_prefill<Backend>() - validate, plan_prefill_batches(), Backend computes each batch's pick rows and
+//                                       reduces them to per-token weighted sums, writes out16 + the echo
+//   reference: prefill_reduce_ref()    - the reduction the GPU kernel (remote_expert_opt.cu prefill_reduce_f16) performs,
+//                                       written out in the same order, for the CPU test backend
+#include "strata/seabraid/channel.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace seabraid {
+
+/// Card 1: writes tokens [t0, t0 + n) of one layer into the prefill region.  `rows` (T x hidden, `row_bytes` per element: kPfRowsF16
+/// or kPfRowsF32 - the type this card's own expert path quantizes for the layer), `w` and `ids'
+/// (T x k, token-major, as Strata's router leaves them) are the WHOLE chunk's; `remote_e[e]` != 0 marks the experts card 1
+/// hands to the expert process for this layer (the same mask its grouping used to put their rows in the tail - one
+/// predicate, so a pick is never computed twice or not at all).  Returns the picks it asked for, -1 if it does not fit.
+inline int64_t pack_prefill_request(const Channel& ch, int32_t layer, int64_t t0, int64_t n, int64_t hidden, int64_t k,
+                                    const void* rows, int32_t row_bytes, const float* w, const int32_t* ids,
+                                    const uint8_t* remote_e, int64_t n_expert) {
+    Header* h = ch.header();
+    if (n <= 0 || n > h->pf_tokens || k != h->pf_k || hidden != h->hidden || (row_bytes != kPfRowsF16 && row_bytes != kPfRowsF32)) return -1;
+    std::memcpy(ch.pf_rows(), (const uint8_t*) rows + (size_t) (t0 * hidden) * (size_t) row_bytes, (size_t) (n * hidden) * (size_t) row_bytes);
+    h->pf_row_bytes = row_bytes;
+    int32_t* pick = ch.pf_pick();
+    float* wt = ch.pf_wt();
+    int64_t picks = 0;
+    for (int64_t i = 0; i < n * k; ++i) {
+        const int32_t e = ids[t0 * k + i];
+        const bool mine = e >= 0 && e < n_expert && remote_e[e] != 0;
+        pick[i] = mine ? e : -1;
+        wt[i] = mine ? w[t0 * k + i] : 0.0f;
+        picks += mine;
+    }
+    h->pf_layer = layer;
+    h->pf_ntok = (int32_t) n;
+    h->pf_ok = 0;
+    h->pf_picks = -1;   // a stale echo from the previous request must never pass card 1's check
+    h->pf_err[0] = '\0';
+    return picks;
+}
+
+/// One sub-batch of a request: a token block [t0, t1) whose picks are grouped by expert (ascending id; entries in token
+/// order inside a group).  Token blocks, not one batch per layer: the expert process's row buffer and kernel scratch are
+/// sized by `max_entries` (device memory), and a block's reduction is final - it never accumulates across batches.
+struct PrefillBatch {
+    int32_t t0 = 0, t1 = 0;
+    std::vector<int32_t> grp_expert, grp_start;   // groups; grp_start has one entry more (the end)
+    std::vector<int32_t> ent_tok, ent_row;        // per entry: token (request-relative) and its row in the batch's rows
+    std::vector<int32_t> row_of;                  // (t1 - t0) x k: the row holding pick (t, k), or -1
+};
+
+/// Splits a request's picks into token blocks of at most `max_entries` picks.  False with `why` on an id out of range or a
+/// width that cannot hold one token's picks.
+inline bool plan_prefill_batches(const int32_t* pick, int64_t n_tok, int64_t k, int64_t n_expert, int64_t max_entries,
+                                 std::vector<PrefillBatch>& out, std::string& why) {
+    out.clear();
+    if (k <= 0 || max_entries < k) { why = "prefill plan: max_entries " + std::to_string(max_entries) + " < k"; return false; }
+    std::vector<int32_t> cnt((size_t) n_expert, 0), at((size_t) n_expert, 0);
+    int64_t t = 0;
+    while (t < n_tok) {
+        PrefillBatch b;
+        b.t0 = (int32_t) t;
+        int64_t ents = 0;
+        for (; t < n_tok; ++t) {
+            int64_t mine = 0;
+            for (int64_t j = 0; j < k; ++j) mine += pick[t * k + j] >= 0;
+            if (ents + mine > max_entries) break;
+            ents += mine;
+        }
+        b.t1 = (int32_t) t;
+        std::fill(cnt.begin(), cnt.end(), 0);
+        for (int64_t i = (int64_t) b.t0 * k; i < (int64_t) b.t1 * k; ++i) {
+            const int32_t e = pick[i];
+            if (e < -1 || e >= n_expert) { why = "prefill plan: pick " + std::to_string(e) + " out of range"; return false; }
+            if (e >= 0) ++cnt[(size_t) e];
+        }
+        int32_t r = 0;
+        for (int32_t e = 0; e < (int32_t) n_expert; ++e) {
+            if (cnt[(size_t) e] == 0) continue;
+            b.grp_expert.push_back(e);
+            b.grp_start.push_back(r);
+            at[(size_t) e] = r;
+            r += cnt[(size_t) e];
+        }
+        b.grp_start.push_back(r);
+        b.ent_tok.assign((size_t) r, 0);
+        b.ent_row.assign((size_t) r, 0);
+        b.row_of.assign((size_t) (b.t1 - b.t0) * (size_t) k, -1);
+        for (int64_t i = (int64_t) b.t0 * k; i < (int64_t) b.t1 * k; ++i) {   // token order inside each group
+            const int32_t e = pick[i];
+            if (e < 0) continue;
+            const int32_t row = at[(size_t) e]++;
+            b.ent_tok[(size_t) row] = (int32_t) (i / k);
+            b.ent_row[(size_t) row] = row;
+            b.row_of[(size_t) (i - (int64_t) b.t0 * k)] = row;
+        }
+        out.push_back(std::move(b));
+    }
+    return true;
+}
+
+/// The per-token reduction of one batch, exactly as the GPU kernel performs it: for each token and column, the picks in k
+/// order, fmaf(weight, row, s) from s = 0.  `rows` is the batch's rows (H floats each); `sum` gets (t1 - t0) x hidden.
+inline void prefill_reduce_ref(const PrefillBatch& b, const float* rows, const float* wt, int64_t k, int64_t hidden,
+                               float* sum) {
+    for (int32_t t = b.t0; t < b.t1; ++t)
+        for (int64_t d = 0; d < hidden; ++d) {
+            float s = 0.0f;
+            for (int64_t j = 0; j < k; ++j) {
+                const int32_t r = b.row_of[(size_t) ((t - b.t0) * k + j)];
+                if (r >= 0) s = std::fmaf(wt[(size_t) (t * k + j)], rows[(size_t) r * (size_t) hidden + (size_t) d], s);
+            }
+            sum[(size_t) (t - b.t0) * (size_t) hidden + (size_t) d] = s;
+        }
+}
+
+/// The expert process: serve the request now in the region.  Backend (GPU in RemoteExperts, CPU in the test):
+///   bool holds(int32_t layer, int32_t expert);
+///   bool begin(int32_t layer, const void* rows, int32_t row_bytes, int64_t n_tok, std::string& err);   // rows in (fp16 or f32), ready
+///   bool batch(int32_t layer, const PrefillBatch& b, const float* wt, std::string& err); // rows + their per-token sums
+///   bool end(uint16_t* out16, int64_t n_tok, std::string& err);                         // sums out; false on non-finite
+/// Never answers a pick it does not hold with zeros: a pick it cannot compute fails the whole request, and card 1
+/// computes the layer's remote experts itself (prefill.cpp, the fallback), so no contribution is ever silently missing.
+template <class Backend>
+inline bool serve_prefill(const Channel& ch, Backend& be, int64_t n_expert, int64_t max_entries, std::string& err) {
+    Header* h = ch.header();
+    const auto t_start = std::chrono::steady_clock::now();
+    const int32_t layer = h->pf_layer;
+    const int64_t n = h->pf_ntok, k = h->pf_k;
+    bool ok = n >= 1 && n <= h->pf_tokens && layer >= 0 && layer < h->n_layers && h->pf_format == kPfFp16 &&
+              (h->pf_row_bytes == kPfRowsF16 || h->pf_row_bytes == kPfRowsF32);
+    if (!ok) err = "prefill request: layer " + std::to_string(layer) + ", " + std::to_string((long long) n) + " tokens (region holds " +
+                   std::to_string((long long) h->pf_tokens) + ")";
+    int64_t picks = 0;
+    std::vector<PrefillBatch> plan;
+    if (ok) {
+        const int32_t* pick = ch.pf_pick();
+        for (int64_t i = 0; ok && i < n * k; ++i) {
+            if (pick[i] < 0) continue;
+            ++picks;
+            if (pick[i] >= n_expert || !be.holds(layer, pick[i])) {
+                err = "prefill request: layer " + std::to_string(layer) + " expert " + std::to_string(pick[i]) + " is not held here";
+                ok = false;
+            }
+        }
+        ok = ok && plan_prefill_batches(pick, n, k, n_expert, max_entries, plan, err);
+    }
+    ok = ok && be.begin(layer, ch.pf_rows(), h->pf_row_bytes, n, err);
+    for (size_t i = 0; ok && i < plan.size(); ++i) ok = be.batch(layer, plan[i], ch.pf_wt(), err);
+    ok = ok && be.end(ch.pf_out16(), n, err);
+    h->pf_picks = ok ? (int32_t) picks : -1;
+    h->pf_ok = ok ? 1 : 0;
+    if (!ok) std::snprintf(h->pf_err, sizeof(h->pf_err), "%s", err.c_str());
+    h->pf_svc_ns += (uint64_t) std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t_start).count();
+    h->pf_svc_n += 1;
+    return ok;
+}
+
+} // namespace seabraid
