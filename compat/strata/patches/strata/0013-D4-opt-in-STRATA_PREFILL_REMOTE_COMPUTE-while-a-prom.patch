+// without its weight cannot cancel out.
+static float expert_val(int e, const float* x, int j) {
+    return (0.3f + 0.1f * (float) e) * x[j] + 0.05f * (float) (e % 3 - 1) * std::tanh(x[(j + 7 * e) % H]);
+}
+
+// What the last request's rows looked like when they reached the expert process (decoded to f32), and in which type: the test
+// compares them with what card 1 sent, so a row type that silently re-rounds (or is read as the wrong type) cannot pass.
+static std::vector<float> g_recv;
+static int32_t g_recv_row_bytes = 0;
+
+struct CpuBackend {   // serve_prefill's backend, on the CPU
+    const uint8_t* held;
+    std::vector<float> x, rows, sum;
+    bool fail = false;
+    bool holds(int32_t l, int32_t e) const { return held[(size_t) l * NE + (size_t) e] != 0; }
+    bool begin(int32_t, const void* rows, int32_t row_bytes, int64_t n, std::string&) {
+        x.resize((size_t) n * H); sum.assign((size_t) n * H, 0.0f);
+        for (size_t i = 0; i < x.size(); ++i)
+            x[i] = row_bytes == bl::kPfRowsF32 ? ((const float*) rows)[i] : f32_from_f16(((const uint16_t*) rows)[i]);
+        g_recv = x; g_recv_row_bytes = row_bytes;
+        return true;
+    }
+    bool batch(int32_t, const bl::PrefillBatch& b, const float* wt, std::string& err) {
+        if (fail) { err = "injected failure"; return false; }
+        rows.assign(b.ent_tok.size() * (size_t) H, 0.0f);
+        for (size_t g = 0; g + 1 < b.grp_start.size(); ++g)
+            for (int32_t i = b.grp_start[g]; i < b.grp_start[g + 1]; ++i)
+                for (int j = 0; j < H; ++j)
+                    rows[(size_t) b.ent_row[(size_t) i] * H + j] = expert_val(b.grp_expert[g], &x[(size_t) b.ent_tok[(size_t) i] * H], j);
+        bl::prefill_reduce_ref(b, rows.data(), wt, K, H, &sum[(size_t) b.t0 * H]);
+        return true;
+    }
+    bool end(uint16_t* out16, int64_t n, std::string& err) {
+        for (int64_t i = 0; i < n * H; ++i) {
+            out16[i] = f16_from_f32(sum[(size_t) i]);
+            if ((out16[i] & 0x7C00u) == 0x7C00u) { err = "non-finite"; return false; }
+        }
+        return true;
+    }
+};
+
+struct Fixture {
+    bl::Channel ch;
+    std::thread th;
+    RemoteExperts re;
+    strata::core::ExpertCache primary;
+    strata::core::FileExpertSource src;
+    std::atomic<int> requests{0};
+    std::atomic<bool> fail{false}, lie{false};
+    std::string err;
+
+    Fixture(const char* tag, int64_t pf_tokens = PF_TOK, int32_t pf_k = K) {
+        const std::string name = std::string("/d4pf") + std::to_string(getpid()) + tag;
+        std::string e;
+        if (!ch.create(name, H, (int64_t) MAXT * K, NL, NE, (uint32_t) MAXT, (int64_t) strata::kernels::cpu::expert_layout().max_blob, e,
+                       pf_tokens, pf_k)) { std::printf("create failed: %s\n", e.c_str()); std::exit(2); }
+        ch.header()->free_gib = 8.0;
+        ch.header()->helper_pid = (int32_t) getpid();   // alive: card 1's liveness checks run and pass
+        std::strcpy(ch.header()->helper_name, "fake-expert-process");
+        ch.header()->state.store(bl::kHelperUp, std::memory_order_release);
+        th = std::thread([this] { serve(); });
+        setenv("SEABRAID_STRATA_SHM", name.c_str(), 1);
+        std::vector<std::pair<int32_t, int32_t>> ranked;
+        for (int x : kHeld) ranked.emplace_back(LAYER, x);
+        std::vector<uint8_t> claimed((size_t) NL * NE, 0);
+        if (!re.open(bl::kDeviceBase, 5, NL, NE, ranked, primary, src, claimed, err, false)) { std::printf("open failed: %s\n", err.c_str()); std::exit(2); }
+    }
+    ~Fixture() {
+        re.close();
+        ch.header()->state.store(bl::kShutdown, std::memory_order_release);
+        th.join();
+    }
+    void serve() {
+        bl::Header* hd = ch.header();
+        while (hd->state.load(std::memory_order_acquire) != bl::kPlanReady) {
+            if (hd->state.load() == bl::kShutdown) return;
+            usleep(200);
+        }
+        for (int64_t i = 0; i < hd->plan_count; ++i) ch.held()[(size_t) ch.plan()[2 * i] * NE + (size_t) ch.plan()[2 * i + 1]] = 1;
+        hd->resident = hd->plan_count; hd->gib = 0.1;
+        hd->state.store(bl::kLoaded, std::memory_order_release);
+        CpuBackend be{ch.held(), {}, {}, {}};
+        while (hd->state.load(std::memory_order_acquire) != bl::kShutdown) {
+            const uint64_t seq = ch.pf_pending();
+            if (seq == 0) { usleep(50); continue; }
+            be.fail = fail.load();
+            std::string e;
+            bl::serve_prefill(ch, be, NE, MAXE, e);
+            if (lie.load()) hd->pf_picks -= 1;   // a dishonest echo: one contribution silently missing
+            ++requests;
+            ch.pf_answer(seq);
+        }
+    }
+};
+
+struct Chunk {   // T tokens of routing, as Strata's router leaves them (token-major ids and weights)
+    int T;
+    std::vector<float> x, w;
+    std::vector<uint16_t> x16;
+    std::vector<int32_t> ids;
+    const void* rows(int32_t row_bytes) const { return row_bytes == bl::kPfRowsF32 ? (const void*) x.data() : (const void*) x16.data(); }
+    explicit Chunk(int t, bool foreign_only = false) : T(t), x((size_t) t * H), w((size_t) t * K), x16((size_t) t * H), ids((size_t) t * K) {
+        for (size_t i = 0; i < x.size(); ++i) x[i] = std::sin(0.37f * (float) i) * (1.0f + (float) (i % 11) * 0.2f);
+        for (size_t i = 0; i < x.size(); ++i) x16[i] = f16_from_f32(x[i]);   // card 1 downloads mixed_h: the fp16 of its rows
+        const int pool[K] = {2, 11, 3, 5, 12, 7, 9, 13, 14, 15};
+        const int foreign[K] = {0, 1, 4, 6, 8, 10, 11, 12, 13, 14};
+        for (int tk = 0; tk < t; ++tk)
+            for (int i = 0; i < K; ++i) {
+                ids[(size_t) tk * K + i] = foreign_only ? foreign[i] : pool[(i + tk) % K];
+                w[(size_t) tk * K + i] = 0.03f + 0.011f * (float) ((tk * 7 + i * 3) % 13);
+            }
+    }
+};
+
+static bool held(int e) { for (int x : kHeld) if (x == e) return true; return false; }
+
+int main() {
+    // ---- 1. sizing by tokens
+    {
+        const int64_t hid = 2560, k = 10, toks = 16384;
+        const auto r = bl::PrefillRegion::of(hid, k, toks);
+        auto up = [](size_t v) { return (v + 4095) & ~(size_t) 4095; };
+        const size_t want = up((size_t) toks * hid * 4) + up((size_t) toks * hid * 2) + 2 * up((size_t) toks * k * 4);   // rows (room for f32), sums, picks, weights
+        CHECK(r.bytes == want);
+        CHECK(r.bytes <= (size_t) toks * bl::PrefillRegion::token_bytes(hid, k, bl::kPfRowsF32) + 4 * 4096);
+        CHECK(r.bytes < (size_t) 300 << 20);   // room for f32 rows (~250 MB at 16K tokens); a pairs-sized region (one H-float row per pick) would be ~3.4 GB here
+        CHECK(bl::PrefillRegion::of(hid, k, 2 * toks).bytes == 2 * r.bytes);   // linear in tokens
+        Fixture f("s");
+        struct stat st{};
+        const std::string path = std::string("/dev/shm") + std::getenv("SEABRAID_STRATA_SHM");
+        CHECK(::stat(path.c_str(), &st) == 0);
+        const auto lay = bl::Layout::of(H, (int64_t) MAXT * K, NL, NE, (int64_t) strata::kernels::cpu::expert_layout().max_blob);
+        CHECK((size_t) st.st_size == lay.total + bl::PrefillRegion::of(H, K, PF_TOK).bytes);
+        CHECK(f.ch.header()->pf_tokens == PF_TOK && f.ch.header()->pf_k == K && f.ch.header()->pf_format == bl::kPfFp16);
+    }
+    // ---- 2 + 3. equality across three ranges (21 tokens, 8 per request), then a range without a handed-over pick
+    {
+        Fixture f("e");
+        CHECK(f.re.prefill_open(K, f.err));
+        const Chunk c(21);
+        std::vector<uint8_t> mask(NE, 0);
+        for (int e = 0; e < NE; ++e) mask[(size_t) e] = f.re.holds(LAYER, e) ? 1 : 0;
+        for (int e = 0; e < NE; ++e) CHECK((mask[(size_t) e] != 0) == held(e));
+        std::vector<uint16_t> sums((size_t) c.T * H, 0xFFFF);
+        CHECK(f.re.prefill_begin(LAYER, c.x16.data(), bl::kPfRowsF16, c.w.data(), c.ids.data(), c.T, K, mask.data(), f.err));
+        CHECK(f.re.prefill_end(sums.data(), f.err));
+        CHECK(f.requests.load() == 3);
+        double worst = 0;
+        for (int t = 0; t < c.T; ++t) {
+            std::vector<double> ref(H, 0.0), d4(H, 0.0);
+            double scale = 1e-6;
+            for (int j = 0; j < H; ++j) {
+                for (int i = 0; i < K; ++i) {
+                    const int e = c.ids[(size_t) t * K + i];
+                    const double v = (double) c.w[(size_t) t * K + i] * expert_val(e, &c.x[(size_t) t * H], j);
+                    ref[(size_t) j] += v;                       // card 1 computing every pick itself
+                    if (!mask[(size_t) e]) d4[(size_t) j] += v;  // card 1's own picks under D4 ...
+                }
+                d4[(size_t) j] += f32_from_f16(sums[(size_t) t * H + j]);   // ... plus the expert process's sum
+                scale = std::max(scale, std::fabs(ref[(size_t) j]));
+            }
+            for (int j = 0; j < H; ++j) worst = std::max(worst, std::fabs(d4[(size_t) j] - ref[(size_t) j]) / scale);
+        }
+        std::printf("equality: worst |D4 - card 1 alone| / max|row| = %.3e (tolerance %.0e)\n", worst, kTol);
+        CHECK(worst <= kTol);
+        const int before = f.requests.load();
+        const Chunk none(PF_TOK, true);
+        std::vector<uint16_t> zs((size_t) none.T * H, 0x1234);
+        CHECK(f.re.prefill_begin(LAYER, none.x16.data(), bl::kPfRowsF16, none.w.data(), none.ids.data(), none.T, K, mask.data(), f.err));
+        CHECK(f.re.prefill_end(zs.data(), f.err));
+        CHECK(f.requests.load() == before);   // no round trip
+        CHECK(std::all_of(zs.begin(), zs.end(), [](uint16_t v) { return v == 0; }));
+        CHECK(f.re.prefill_usable());
+    }
+    // ---- 2b. the row type is declared per request: fp16 rows arrive as the fp16 rounding of card 1's rows, f32 rows bit for bit,
+    //          and both in one session (an engine runs fused layers and MMQ layers in the same chunk)
+    {
+        Fixture f("rt");
+        CHECK(f.re.prefill_open(K, f.err));
+        const Chunk c(PF_TOK);   // one request: the last request's rows are all of them
+        std::vector<uint8_t> mask(NE, 0);
+        for (int e : kHeld) mask[(size_t) e] = 1;
+        std::vector<uint16_t> sums((size_t) c.T * H);
+        for (const int32_t rb : {bl::kPfRowsF32, bl::kPfRowsF16, bl::kPfRowsF32}) {
+            CHECK(f.re.prefill_begin(LAYER, c.rows(rb), rb, c.w.data(), c.ids.data(), c.T, K, mask.data(), f.err));
+            CHECK(f.re.prefill_end(sums.data(), f.err));
+            CHECK(g_recv_row_bytes == rb && g_recv.size() == c.x.size());
+            size_t unequal = 0;
+            for (size_t i = 0; i < c.x.size() && i < g_recv.size(); ++i) {
+                const float want = rb == bl::kPfRowsF32 ? c.x[i] : f32_from_f16(c.x16[i]);
+                unequal += std::memcmp(&want, &g_recv[i], 4) != 0;
+            }
+            CHECK(unequal == 0);
+            // WHY the type is declared per request (the D4 precision loss, reproduced on the host): a path that quantizes card 1's
+            // f32 rows to int8 blocks and an expert card that quantizes what it RECEIVED agree on every code only when it received
+            // the f32 rows; fp16-rounded rows flip a few percent of the codes (one quantization step each, ~0.5% nrmse on an
+            // expert's output - measured per layer on the GPUs by STRATA_D4_CHECK, E3).
+            size_t flips = 0;
+            for (size_t b = 0; b + 32 <= c.x.size() && b + 32 <= g_recv.size(); b += 32) {
+                float a = 0, ar = 0;
+                for (int i = 0; i < 32; ++i) { a = std::max(a, std::fabs(c.x[b + i])); ar = std::max(ar, std::fabs(g_recv[b + i])); }
+                for (int i = 0; i < 32; ++i)
+                    flips += std::lrintf(c.x[b + i] / (a / 127.0f)) != std::lrintf(g_recv[b + i] / (ar / 127.0f));
+            }
+            std::printf("row type %d bytes: int8 codes that differ from card 1's own f32 quantization: %.2f%%\n", rb, 100.0 * (double) flips / (double) c.x.size());
+            if (rb == bl::kPfRowsF32) CHECK(flips == 0);
+            else CHECK(flips > c.x.size() / 500);   // > 0.2%: fp16 rows are a real re-rounding for a path that quantizes f32
+        }
+        CHECK(!f.re.prefill_begin(LAYER, c.rows(3), 3, c.w.data(), c.ids.data(), c.T, K, mask.data(), f.err));   // no such row type
+    }
+    // ---- 4. failure contract: an error reply, then a dishonest echo
+    for (int lie = 0; lie < 2; ++lie) {
+        Fixture f(lie ? "l" : "f");
+        CHECK(f.re.prefill_open(K, f.err));
+        (lie ? f.lie : f.fail).store(true);
+        const Chunk c(5);
+        std::vector<uint8_t> mask(NE, 0);
+        for (int e : kHeld) mask[(size_t) e] = 1;
+        std::vector<uint16_t> sums((size_t) c.T * H);
+        CHECK(f.re.prefill_begin(LAYER, c.x16.data(), bl::kPfRowsF16, c.w.data(), c.ids.data(), c.T, K, mask.data(), f.err));
+        CHECK(!f.re.prefill_end(sums.data(), f.err));
+        CHECK(!f.re.prefill_usable());
+        CHECK(!f.re.prefill_begin(LAYER, c.x16.data(), bl::kPfRowsF16, c.w.data(), c.ids.data(), c.T, K, mask.data(), f.err));
+        CHECK(!f.re.prefill_choose(4, false, NL, H, K).compute);   // later chunks lend
+    }
+    // ---- 5. open-time refusals name both sides
+    {
+        Fixture f0("z", 0, 0);
+        CHECK(!f0.re.prefill_open(K, f0.err) && f0.err.find("--prefill-tokens") != std::string::npos);
+    }
+    {
+        Fixture f8("k", PF_TOK, 8);
+        CHECK(!f8.re.prefill_open(K, f8.err) && f8.err.find("expert process k 8") != std::string::npos &&
+              f8.err.find("card 1 k 10") != std::string::npos);
+    }
+    // ---- 6. the cost model
+    {
+        strata::core::PrefillCostIn c;
+        c.layers = 48; c.k = 10; c.n_expert = 512; c.hidden = 2560; c.stream_all = true;
+        c.remote_bytes = 14e9; c.pick_share = 0.35;
+        c.lend_Bps = strata::core::kD4LendBps; c.wire_Bps = strata::core::kD4WireBps;
+        c.pick_rate = strata::core::kD4PickRate; c.layer_s = strata::core::kD4LayerS;
+        const double x = strata::core::prefill_crossover_tokens(c);
+        std::printf("model: crossover %.0f tokens (32 GB AMD GPU-first placement, 14 GB held, share 0.35, default rates)\n", x);
+        CHECK(x > 1000 && x < 100000);
+        c.tokens = (int64_t) (x * 0.9); CHECK(strata::core::prefill_cost(c).compute);
+        c.tokens = (int64_t) (x * 1.1) + 1; CHECK(!strata::core::prefill_cost(c).compute);
+        c.stream_all = false; c.tokens = 64;   // a short staged chunk touches few blobs: the model must still be sane
+        const auto s = strata::core::prefill_cost(c);
+        CHECK(s.lend_bytes < c.remote_bytes && s.lend_bytes > 0);
+    }
+    if (g_fail) { std::printf("remote_prefill_test: %d FAILED\n", g_fail); return 1; }
+    std::printf("remote_prefill_test: all checks passed\n");
+    return 0;
+}
diff --git a/tests/prefill/d4_plan_test.cpp b/tests/prefill/d4_plan_test.cpp
new file mode 100644
index 000000000..60cbef7b1
--- /dev/null
+++ b/tests/prefill/d4_plan_test.cpp
@@ -0,0 +1,82 @@
+// d4_plan_test: D4's host-side layer plan (include/strata/prefill/d4_plan.hpp), CPU only.
+//
+//   1 path   : handing experts to the expert process must not change the path card 1's own experts take (fused int8 kernels or
+//              MMQ).  This is the D4 precision root cause: the first D4 forced MMQ on every layer it touched, which on a HIP
+//              gfx12 engine (fused by default) changed card 1's own experts, KL ~0.03 against the fused path.
+//   2 split  : every routed pick is exactly one of card 1's or the expert process's; the masked ids keep card 1's picks and
+//              nothing else; the rows of the handed-over picks are distinct, inside [local_rows, valid), one contiguous block per
+//              expert in (token, k) order, and row_tok names the pick's token (the failure path computes them from these).
+//   3 limits : nothing handed over (a plan equal to the unmasked routing); everything handed over; ids out of range ignored.
+#include <algorithm>
+#include <cstdio>
+#include <cstdint>
+#include <random>
+#include <set>
+#include <vector>
+
+#include "strata/prefill/d4_plan.hpp"
+
+using strata::prefill::D4Split;
+using strata::prefill::ExpertPath;
+using strata::prefill::d4_split;
+using strata::prefill::expert_path;
+
+static int g_fail = 0;
+#define CHECK(c) do { if (!(c)) { std::printf("FAIL line %d: %s\n", __LINE__, #c); ++g_fail; } } while (0)
+
+static void check_path() {
+    for (const bool fused_ok : {false, true})
+        CHECK(expert_path(fused_ok, true) == expert_path(fused_ok, false));   // D4 never changes card 1's own path
+    CHECK(expert_path(true, true) == ExpertPath::kFused);                      // a fused-capable layer stays fused under D4
+    CHECK(expert_path(false, true) == ExpertPath::kMmq);
+}
+
+static void check_split(int64_t T, int64_t K, int32_t E, uint32_t seed, int holds_mode) {
+    std::mt19937 rng(seed);
+    std::vector<int32_t> ids((size_t) (T * K));
+    for (auto& v : ids) v = (int32_t) (rng() % (uint32_t) (E + 2)) - 1 + ((rng() % 50 == 0) ? E : 0);   // includes -1 and E.. (out of range)
+    std::vector<uint8_t> hold((size_t) E), res((size_t) E);
+    for (int32_t e = 0; e < E; ++e) {
+        hold[(size_t) e] = holds_mode == 0 ? 0 : holds_mode == 2 ? 1 : (rng() % 3 == 0);
+        res[(size_t) e] = holds_mode == 2 ? 0 : (rng() % 4 == 0);
+    }
+    D4Split s;
+    d4_split(ids.data(), T, K, E, [&](int32_t e) { return hold[(size_t) e] != 0; }, [&](int32_t e) { return res[(size_t) e] != 0; }, s);
+
+    int64_t valid = 0, rem = 0;
+    std::set<int32_t> rows;
+    std::vector<int32_t> seen_rows_of((size_t) E, 0);
+    for (int64_t i = 0; i < T * K; ++i) {
+        const int32_t e = ids[(size_t) i];
+        const bool in_range = e >= 0 && e < E;
+        valid += in_range;
+        const bool remote = in_range && hold[(size_t) e] && !res[(size_t) e];
+        rem += remote;
+        CHECK((s.ids_local[(size_t) i] == -1) == (remote || e == -1));                 // masked iff handed over (or already -1)
+        if (!remote) CHECK(s.ids_local[(size_t) i] == e && s.remote_slot[(size_t) i] == -1);
+        if (remote) {
+            const int32_t row = s.remote_slot[(size_t) i];
+            CHECK(row >= s.local_rows && row < s.local_rows + s.rows_rem);
+            CHECK(rows.insert(row).second);                                             // distinct rows
+            CHECK(row >= s.off[(size_t) e] && row < s.off[(size_t) e] + s.cnt[(size_t) e]);
+            CHECK(s.row_tok[(size_t) row] == (int32_t) (i / K));                        // the row's token
+            CHECK(row == s.off[(size_t) e] + seen_rows_of[(size_t) e]++);               // (token, k) order inside the expert
+        }
+    }
+    CHECK(s.rows_rem == rem);
+    CHECK(s.local_rows == valid - rem);
+    CHECK((int64_t) rows.size() == rem);
+    if (rem > 0) CHECK(*rows.begin() == s.local_rows && *rows.rbegin() == valid - 1);   // one dense block after card 1's rows
+    for (int32_t e = 0; e < E; ++e) CHECK((s.mask[(size_t) e] != 0) == (s.cnt[(size_t) e] > 0 && hold[(size_t) e] && !res[(size_t) e]));
+    if (holds_mode == 0) CHECK(rem == 0 && s.local_rows == valid);
+}
+
+int main() {
+    check_path();
+    for (uint32_t seed = 1; seed <= 40; ++seed) check_split(37, 10, 64, seed, (int) (seed % 3));
+    check_split(1, 10, 512, 7, 1);
+    check_split(4188, 10, 512, 9, 1);
+    if (g_fail) { std::printf("d4_plan_test: %d FAILED\n", g_fail); return 1; }
+    std::printf("d4_plan_test: ok\n");
+    return 0;
+}
