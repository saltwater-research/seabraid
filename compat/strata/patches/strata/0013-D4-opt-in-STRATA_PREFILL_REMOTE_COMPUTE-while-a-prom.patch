+// D4: one thread per (token, column); the picks in k order, fmaf from 0 - prefill_reduce_ref's order exactly.
+__global__ void prefill_reduce_kernel(const float* rows, const int32_t* row_of, const float* wt, int64_t n_tok, int k,
+                                      uint16_t* out16, int32_t* bad) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n_tok * H) return;
+    const int64_t t = i / H, c = i % H;
+    float s = 0.0f;
+    for (int j = 0; j < k; ++j) {
+        const int32_t r = row_of[t * k + j];
+        if (r >= 0) s = fmaf(wt[t * k + j], rows[(int64_t) r * H + c], s);
+    }
+    const uint16_t h = strata::kernels::f16_from_f32(s);
+    if ((h & 0x7C00u) == 0x7C00u) atomicOr(bad, 1);   // inf or NaN in fp16: card 1 must not add it
+    out16[i] = h;
+}
+
+__global__ void prefill_f16_to_f32_kernel(const uint16_t* x16, float* x, int64_t n) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < n) x[i] = strata::kernels::f32_from_f16(x16[i]);
+}
+
 // Like the upstream mapped-row copy, also skip rows returned in the remote sum.
 __global__ void copy_cpu_rows(float4* dst, const volatile float4* src, const int32_t* mask,
                               const int32_t* hit_rows, const int32_t* count) {
@@ -49,6 +71,19 @@ __global__ void copy_cpu_rows(float4* dst, const volatile float4* src, const int
 }
 } // namespace
 
+void prefill_reduce_f16(const float* rows, const int32_t* row_of, const float* wt, int64_t n_tok, int64_t k,
+                        uint16_t* out16, int32_t* bad, void* stream) {
+    if (n_tok <= 0) return;
+    const int64_t n = n_tok * H;
+    prefill_reduce_kernel<<<(unsigned) ((n + 255) / 256), 256, 0, (cudaStream_t) stream>>>(rows, row_of, wt, n_tok, (int) k,
+                                                                                          out16, bad);
+}
+
+void prefill_f16_to_f32(const uint16_t* x16, float* x, int64_t n, void* stream) {
+    if (n <= 0) return;
+    prefill_f16_to_f32_kernel<<<(unsigned) ((n + 255) / 256), 256, 0, (cudaStream_t) stream>>>(x16, x, n);
+}
+
