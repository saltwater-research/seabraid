+namespace strata::prefill {
+namespace {
+constexpr int64_t N = strata::kernels::cpu::H;
+
+struct Cmp { double nrmse = 0, maxrel = 0, bias = 0, scale = 1; };
+Cmp compare(const float* a, const float* b, size_t n) {
+    double ee = 0, bb = 0, ab = 0, sd = 0, maxd = 0, maxb = 0;
+    for (size_t i = 0; i < n; ++i) {
+        const double d = (double) a[i] - (double) b[i];
+        ee += d * d; bb += (double) b[i] * b[i]; ab += (double) a[i] * b[i]; sd += d;
+        maxd = std::max(maxd, std::fabs(d)); maxb = std::max(maxb, std::fabs((double) b[i]));
+    }
+    Cmp c;
+    if (bb > 0 && n > 0) {
+        c.nrmse = std::sqrt(ee / bb); c.maxrel = maxb > 0 ? maxd / maxb : 0;
+        c.bias = (sd / (double) n) / std::sqrt(bb / (double) n); c.scale = ab / bb;
+    }
+    return c;
+}
+bool cu(cudaError_t r, const char* what, std::string& err) {
+    if (r == cudaSuccess) return true;
+    err = std::string("D4 check ") + what + ": " + cudaGetErrorString(r);
+    return false;
+}
+} // namespace
+
+bool D4Check::enabled() {
+    static const bool on = [] { const char* v = std::getenv("STRATA_D4_CHECK"); return v != nullptr && std::atoi(v) != 0; }();
+    return on;
+}
+
+bool D4Check::use_reference() {
+    static const bool on = [] { const char* v = std::getenv("STRATA_D4_CHECK"); return v != nullptr && std::atoi(v) == 2; }();
+    return on;
+}
+
+D4Check::~D4Check() {
+    for (void* p : {(void*) ref_, (void*) refh_, (void*) xr_, (void*) dec_}) if (p) cudaFree(p);
+}
+
+bool D4Check::run(core::Card1Rows& card1, core::ExpertSource& files, const D4CheckIn& in, std::string& err) {
+    const size_t n = (size_t) (in.T * N);
+    auto s = (cudaStream_t) in.stream;
+    if (cap_ < n) {
+        for (void* p : {(void*) ref_, (void*) refh_, (void*) xr_, (void*) dec_}) if (p) cudaFree(p);
+        ref_ = refh_ = xr_ = dec_ = nullptr; cap_ = 0;
+        if (!cu(cudaMalloc((void**) &ref_, n * 4), "ref", err) || !cu(cudaMalloc((void**) &refh_, n * 4), "refh", err) ||
+            !cu(cudaMalloc((void**) &xr_, n * 4), "xr", err) || !cu(cudaMalloc((void**) &dec_, n * 4), "dec", err)) return false;
+        cap_ = n;
+        h_ref_.resize(n); h_refh_.resize(n); h_dec_.resize(n);
+    }
