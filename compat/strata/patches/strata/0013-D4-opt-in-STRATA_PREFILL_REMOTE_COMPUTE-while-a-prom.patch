diff --git a/include/strata/core/remote_prefill.hpp b/include/strata/core/remote_prefill.hpp
new file mode 100644
index 000000000..2b0041651
--- /dev/null
+++ b/include/strata/core/remote_prefill.hpp
@@ -0,0 +1,122 @@
+#pragma once
+// D4 (STRATA_PREFILL_REMOTE_COMPUTE): while a prompt is read, the experts the other card holds are computed ON that card
+// (its expert process, over the seabraid channel's prefill region) instead of card 1 copying their weights across PCIe.
+// This header holds the two pieces both sides and the tests share:
+//   * the per-chunk byte/time model that chooses compute vs lend (pure: unit-tested without a GPU)
+//   * NativePicks: "compute these (token, expert) picks' rows on this device" - the native grouped expert kernels the
+//     decode path already runs on both cards, used by the expert process to serve a request AND by card 1 to compute a
+//     failed request's experts itself (one definition of that call sequence, two callers).
+#include <cmath>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace strata::core {
+
+// ---- the cost model ----------------------------------------------------------------------------------------------------
+/// What one prompt chunk would cost each way.  Rates are bytes or picks per second.
+struct PrefillCostIn {
+    int64_t tokens = 0, layers = 0, k = 0, n_expert = 0, hidden = 0;
+    double remote_bytes = 0;   ///< blob bytes of every expert the other card holds (all layers)
+    double pick_share = 0;     ///< share of (token, k) picks routed to those experts (measured, seeded by their count share)
+    bool stream_all = false;   ///< the chunk streams every non-resident expert whatever its routing (T >= stream_all_min)
+    double lend_Bps = 0;       ///< lending: other card VRAM -> host -> card 1, end to end
+    double wire_Bps = 0;       ///< compute: the prefill region's rows and sums through host memory and the other card's link
+    double pick_rate = 0;      ///< compute: picks per second the other card's expert kernels sustain
+    double layer_s = 0;        ///< compute: fixed cost per layer request (publish, wake, launch, answer)
+    int row_bytes = 2;         ///< compute: bytes per row element on the wire (2 fp16, 4 f32)
+};
+struct PrefillChoice {
+    bool compute = false;
+    double t_lend = 0, t_compute = 0, lend_bytes = 0, wire_bytes = 0, picks = 0;
+};
+
+/// Defaults, each a measurement or a stated estimate (STRATA_D4_* environment variables override them):
+///   lend 1.8 GB/s   MEASURED 2026-11-09: 13 GiB lent for a 3.5k prompt in the 75-85% of its 9.7 s spent in `wait copy`
+///   pick 2.0e5/s    MEASURED (D8 SEABRAID_STRATA_CARD_BENCH, 16 rows/expert): 24 GB NVIDIA GPU 226k, 32 GB AMD GPU 270k, 12 GB NVIDIA GPU 167k rows/s; the 24 GB NVIDIA GPU's, rounded down
+///   wire 3.0 GB/s   ESTIMATE: half of PCIe 3.0 x8 (the 24 GB NVIDIA GPU's link), pageable copies both ways; not measured yet
+///   layer 100 us    MEASURED: a decode layer request's round trip is 65-78 us (helper zero-copy off, 2026-11-06)
+inline constexpr double kD4LendBps = 1.8e9, kD4PickRate = 2.0e5, kD4WireBps = 3.0e9, kD4LayerS = 1.0e-4;
+
+/// The model.  WHY THESE TERMS: they are the costs that DIFFER between the two modes; card 1's attention, router and own
+/// experts are the same work either way.  Lending moves every held blob a chunk touches over the other card's link once per
+/// chunk (all of them when the chunk streams, else the share a uniform routing of T tokens touches); computing moves a
+/// fixed 4H + 8K bytes per token per layer (PrefillRegion::token_bytes) and runs the picks there.  Lending saturates
+/// with T, computing grows with T, so computing wins below a crossover and the model picks per chunk.
+inline PrefillChoice prefill_cost(const PrefillCostIn& c) {
+    PrefillChoice r;
+    const double T = (double) c.tokens, L = (double) c.layers, K = (double) c.k;
+    const double touched = c.stream_all ? 1.0 : 1.0 - std::pow(1.0 - K / (double) c.n_expert, T);
+    r.lend_bytes = c.remote_bytes * touched;
+    r.t_lend = c.lend_Bps > 0 ? r.lend_bytes / c.lend_Bps : 1e30;
+    r.picks = T * K * L * c.pick_share;
+    r.wire_bytes = T * L * ((double) (c.row_bytes + 2) * (double) c.hidden + 8.0 * K);
+    r.t_compute = (c.pick_rate > 0 ? r.picks / c.pick_rate : 1e30) + (c.wire_Bps > 0 ? r.wire_bytes / c.wire_Bps : 1e30) +
+                  L * c.layer_s;
+    r.compute = r.t_compute < r.t_lend;
+    return r;
+}
+
+/// The chunk size where the two are equal in the streamed (saturated) regime: below it computing wins.  A function of the
+/// model's inputs only (the report line and the tests read it); +inf when computing always wins, 0 when it never does.
+inline double prefill_crossover_tokens(const PrefillCostIn& c) {
+    const double L = (double) c.layers, K = (double) c.k;
+    const double per_tok = K * L * c.pick_share / c.pick_rate + L * ((double) (c.row_bytes + 2) * (double) c.hidden + 8.0 * K) / c.wire_Bps;
+    const double fixed = c.remote_bytes / c.lend_Bps - L * c.layer_s;
+    if (fixed <= 0) return 0;
+    return per_tok > 0 ? fixed / per_tok : INFINITY;
+}
+
+// ---- NativePicks: the expert process's (and card 1's fallback's) device runner ----------------------------------------
+/// Device buffers and the call sequence for "rows of these picks on this device": optional Hadamard rotation (APR), q8_1
+/// activations, the native grouped expert kernels.  Capacities grow on first use (cudaMalloc on the CURRENT device) and are
+/// kept; nothing here is allocated by a process that never reads a prompt this way.  Not thread-safe; one stream.
+class NativePicks {
+public:
+    NativePicks() = default;
+    ~NativePicks();
+    NativePicks(const NativePicks&) = delete;
+    NativePicks& operator=(const NativePicks&) = delete;
+    /// The activations of `n_tok` tokens (f32, device, n_tok x H) for `layer`: rotated if its gate/up is Hadamard-folded,
+    /// then q8_1.  Valid for run() until the next call.
+    bool input(int64_t layer, const float* x_dev, int64_t n_tok, void* stream, std::string& err);
+    /// Rows of `ng` groups (blob `ptr[g]` on this device, entries [start[g], start[g+1])) into `out_dev` (row ent_row[e]
+    /// gets token ent_tok[e]'s product, H floats).  Host tables, uploaded here.
+    bool run(int64_t layer, const unsigned long long* ptr, const int32_t* start, int32_t ng, const int32_t* ent_row,
+             const int32_t* ent_tok, int32_t ne, float* out_dev, void* stream, std::string& err);
+    void release();
+
+private:
+    bool grow(void** p, size_t& cap, size_t want, std::string& err);
+    void *q8_ = nullptr, *xr_ = nullptr, *scratch_ = nullptr, *meta_ = nullptr;
+    size_t q8_cap_ = 0, xr_cap_ = 0, scratch_cap_ = 0, meta_cap_ = 0;
+    const float *sx_ = nullptr, *sh_ = nullptr;   // APR sign vectors on this device (hadamard_device_signs: process-wide)
+    int64_t n_tok_ = 0;
+    std::vector<uint8_t> host_;                   // run()'s tables before their one upload
+};
+
+class ExpertSource;
+
+/// D4's failure path on CARD 1: when the expert process could not answer a layer, card 1 computes that layer's handed-over
+/// picks itself - each expert's blob read from `files`, copied to this device and run through NativePicks into the
+/// prompt path's own rows (row r of `Dm` gets token row_tok[r]'s product), after which the plain combine sums every row.
+/// Slow (one expert at a time, synchronous) and only ever run after a loud failure; correctness, not speed, is its job.
+/// It reads the FILES, never the expert card: the card that just failed is the last place to ask for bytes.
+class Card1Rows {
+public:
+    Card1Rows() = default;
+    ~Card1Rows();
+    Card1Rows(const Card1Rows&) = delete;
+    Card1Rows& operator=(const Card1Rows&) = delete;
+    /// `experts` (n of them) of `layer`: rows [off[e], off[e] + cnt[e]) of Dm.  `x_dev`: the layer's f32 input, T x H.
+    bool run(int64_t layer, const float* x_dev, int64_t T, const int32_t* experts, int n, const int32_t* off,
+             const int32_t* cnt, const int32_t* row_tok, float* Dm, ExpertSource& files, void* stream, std::string& err);
+
+private:
+    NativePicks np_;
+    uint8_t* host_ = nullptr;   // pinned staging for one blob
+    void* blob_ = nullptr;      // the blob on this device
+    size_t cap_ = 0;
+};
+
+} // namespace strata::core
diff --git a/include/strata/prefill/d4_check.hpp b/include/strata/prefill/d4_check.hpp
new file mode 100644
index 000000000..0ab8a6943
--- /dev/null
+++ b/include/strata/prefill/d4_check.hpp
@@ -0,0 +1,51 @@
+#pragma once
+// STRATA_D4_CHECK=1 (diagnostic, off by default): for every D4 layer, compare what the expert process returned with what this
+// card computes for the SAME picks, and say where the two differ.  Reports per layer and per quant type:
+//   E1  returned sums vs this card's exact-input product   (the whole D4 error: fp16 rows + fp16 sums + the two cards' kernels)
+//   E2  returned sums vs this card's product of the fp16 rows (removes the row rounding: kernels + sum rounding)
+//   E3  fp16-row product vs exact-input product              (the row rounding alone)
+//   E4  returned sums vs fp16(E2's reference)                (removes the sum rounding too: kernel disagreement only)
+//   DEC the combine's fp16 decode on this device vs the exact bit decode (a wrong decode would be invisible to E1-E4)
+// Each is nrmse = |a-b|/|b|, max|a-b|/max|b|, signed bias = mean(a-b)/rms(b), scale = <a,b>/<b,b> (1 = no gain error).
+#include "strata/core/remote_prefill.hpp"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace strata::prefill {
+
+struct D4CheckIn {
+    int64_t layer = 0, T = 0, from = 0;     ///< the handed-over picks are the (token, k) whose `slot` is >= from
+    const float* x = nullptr;               ///< the layer's f32 input (T x H, device)
+    const uint16_t* x16 = nullptr;          ///< its fp16 image (what the request carried), device
+    const int32_t* slot = nullptr;          ///< device (token, k) -> Dm row of the pick's product (see `from`)
+    const float* w = nullptr;               ///< device router weights
+    float* Dm = nullptr;
+    const uint16_t* sum16 = nullptr;        ///< the expert process's sums (mapped host)
+    std::vector<int32_t> experts;           ///< the handed-over experts of this layer
+    const int32_t *off = nullptr, *cnt = nullptr, *row_tok = nullptr;
+    void* stream = nullptr;
+};
+
+class D4Check {
+public:
+    D4Check() = default;
+    ~D4Check();
+    D4Check(const D4Check&) = delete;
+    D4Check& operator=(const D4Check&) = delete;
+    static bool enabled();   ///< STRATA_D4_CHECK is set and non-zero
+    /// STRATA_D4_CHECK=2 (a CONTROL, not a mode to run in): after the comparison the layer uses THIS card's own product of the
+    /// handed-over picks instead of the expert process's sums - the failure path, forced.  An arm run this way shows what the
+    /// engine does when D4's remote arithmetic is replaced by the arithmetic of the path D4 is compared against.
+    static bool use_reference();
+    /// Computes the reference on `card1` and prints one line to stderr.  False with `err` when the reference cannot be run.
+    bool run(core::Card1Rows& card1, core::ExpertSource& files, const D4CheckIn& in, std::string& err);
+
+private:
+    float *ref_ = nullptr, *refh_ = nullptr, *xr_ = nullptr, *dec_ = nullptr;
+    size_t cap_ = 0;   // elements per buffer
+    std::vector<float> h_ref_, h_refh_, h_dec_;
+};
+
+} // namespace strata::prefill
diff --git a/include/strata/prefill/d4_plan.hpp b/include/strata/prefill/d4_plan.hpp
new file mode 100644
index 000000000..ad95b9656
--- /dev/null
+++ b/include/strata/prefill/d4_plan.hpp
@@ -0,0 +1,74 @@
+#pragma once
+// D4 (STRATA_PREFILL_REMOTE_COMPUTE): the host-side plan of one MoE layer of a prompt chunk - which picks go to the expert
+// process, what card 1 keeps, and where the expert card's picks land if card 1 has to compute them itself.  Host only (no GPU
+// runtime, no engine state), so prefill.cpp and tests/prefill/d4_plan_test.cpp run ONE definition of it.
+//
+// WHY THIS EXISTS (the D4 precision root cause).  D4 first took the host-grouped MMQ expert path on every layer it touched,
+// because that path has the host's routing in hand.  On an engine whose default prompt path is the fused int8 kernels
+// (HIP gfx12) that silently changed card 1's OWN experts from the fused to the MMQ kernels for the whole chunk - a
+// kernel change worth KL ~0.03 against the fused path (the engine's own gfx12 MMQ note), unrelated to the experts D4 moved.
+// The plan below needs only the routed ids, so the fused path can serve a D4 layer too: remote picks are masked out of the
+// ids the fused grouping sees (`ids_local`), and card 1's failure path knows their rows (`off`/`cnt`/`row_tok`/`remote_slot`).
+#include <cstdint>
+#include <vector>
+
+namespace strata::prefill {
+
+/// The path card 1's own experts take for a layer.  D4 must never change it (one rule, one place; d4_plan_test pins it).
+enum class ExpertPath { kMmq, kFused };
+
+/// `fused_ok`: the layer would take the fused kernels without D4.  `d4`: this layer hands experts to the expert process.
+/// The answer does not depend on `d4` - that independence is the point: D4 moves picks, it does not change how the
+/// picks card 1 keeps are computed.
+inline ExpertPath expert_path(bool fused_ok, bool d4) {
+    (void) d4;
+    return fused_ok ? ExpertPath::kFused : ExpertPath::kMmq;
+}
+
+struct D4Split {
+    std::vector<uint8_t> mask;          ///< per expert: handed to the expert process this layer (routed, held there, not on card 1)
+    int64_t rows_rem = 0;               ///< picks handed over
+    int64_t local_rows = 0;             ///< picks card 1 keeps (rows [0, local_rows) of Dm); ids outside [0, n_expert) are in neither
+    std::vector<int32_t> ids_local;     ///< T*K: the router's ids with every handed-over pick replaced by -1 (what the grouping sees)
+    std::vector<int32_t> remote_slot;   ///< T*K: the Dm row of a handed-over pick if card 1 computes it, else -1
+    std::vector<int32_t> off, cnt;      ///< per expert (n_expert + 1 offsets): rows [off[e], off[e] + cnt[e]) of Dm hold expert e's picks
+    std::vector<int32_t> row_tok;       ///< per Dm row (absolute index, as Card1Rows reads it): the token of a handed-over row
+};
+
+/// `holds(e)`: the expert process holds expert e of this layer.  `on_card1(e)`: card 1 has it resident (it keeps those: no copy
+/// needed).  Rows of handed-over experts go after card 1's own, expert id ascending, picks in (token, k) order inside one.
+template <class Holds, class OnCard1>
+inline void d4_split(const int32_t* ids, int64_t T, int64_t K, int32_t n_expert, Holds holds, OnCard1 on_card1, D4Split& s) {
+    const int64_t n = T * K;
+    s.mask.assign((size_t) n_expert, 0);
+    s.cnt.assign((size_t) n_expert + 1, 0);
+    s.off.assign((size_t) n_expert + 1, 0);
+    s.ids_local.assign((size_t) n, -1);
+    s.remote_slot.assign((size_t) n, -1);
+    for (int64_t i = 0; i < n; ++i)
+        if (ids[i] >= 0 && ids[i] < n_expert) ++s.cnt[(size_t) ids[i]];
+    int64_t rem = 0, valid = 0;
+    for (int32_t e = 0; e < n_expert; ++e) {
+        valid += s.cnt[(size_t) e];
+        s.mask[(size_t) e] = s.cnt[(size_t) e] > 0 && holds(e) && !on_card1(e) ? 1 : 0;
+        if (s.mask[(size_t) e]) rem += s.cnt[(size_t) e];
+    }
+    s.rows_rem = rem;
+    s.local_rows = valid - rem;
+    int32_t r = (int32_t) s.local_rows;
+    for (int32_t e = 0; e < n_expert; ++e)
+        if (s.mask[(size_t) e]) { s.off[(size_t) e] = r; r += s.cnt[(size_t) e]; }
+    s.row_tok.assign((size_t) valid, 0);
+    std::vector<int32_t> next(s.off.begin(), s.off.begin() + n_expert);
+    for (int64_t i = 0; i < n; ++i) {
+        const int32_t e = ids[i];
+        const bool mine = e >= 0 && e < n_expert && s.mask[(size_t) e];
+        s.ids_local[(size_t) i] = mine ? -1 : e;
+        if (!mine) continue;
+        const int32_t row = next[(size_t) e]++;
+        s.remote_slot[(size_t) i] = row;
+        s.row_tok[(size_t) row] = (int32_t) (i / K);
+    }
+}
+
+} // namespace strata::prefill
