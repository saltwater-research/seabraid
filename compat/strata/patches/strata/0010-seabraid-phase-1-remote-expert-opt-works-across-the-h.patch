@@ -0,0 +1,261 @@
+// remote_experts_seabraid_opt_test: --remote-expert-opt across a seabraid helper process (RemoteExperts::seabraid_helper_begin/finish
+// + RemoteExpertOpt::accumulate), against an in-process FAKE helper on a real POSIX shm channel.  CPU only: no GPU is
+// touched (RemoteExpertOpt::init_host_only keeps its sums in this process's memory, so no CUDA context is created).
+//
+// What it pins: main writes the router weight of every helper-owned pick into the channel `weights` region and asks for
+// kOutPerToken; the helper's n_tok weighted rows land in h_sum_ exactly as an in-process remote's would, with h_mask_ set
+// for the helper's picks only; a helper that answers per-pick, or with the wrong row count, is an ERROR; without an active
+// RemoteExpertOpt the request is the old per-pick one, and a wrong row count there is an ERROR too.
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <thread>
+#include <unistd.h>
+#include <vector>
+
+#include "strata/seabraid/channel.hpp"
+#include "strata/core/expert_cache.hpp"
+#include "strata/core/expert_source.hpp"
+#include "strata/core/remote_expert_opt.hpp"
+#include "strata/core/remote_experts.hpp"
+#include "strata/kernels/cpu/expert.hpp"
+#include "strata/kernels/cpu/expert_layout.hpp"
+#include "strata/kernels/window_limits.hpp"
+
+namespace bl = seabraid;
+using strata::core::RemoteExperts;
+using strata::core::RemoteExpertOpt;
+
+static int g_fail = 0;
+#define CHECK(c) do { if (!(c)) { std::printf("FAIL line %d: %s\n", __LINE__, #c); ++g_fail; } } while (0)
+
+constexpr int H = strata::kernels::cpu::H, K = 10, MAXT = strata::kernels::kWindowMaxT, NL = 3, NE = 16, LAYER = 1;
+enum Mode { kNormal, kAnswerPerPick, kWrongRows };
+
+// The fake helper's expert: expert e on activation x gives (e + 1) * x.  Known, so every merged value is predictable.
+static float expert_val(int e, float xj) { return (float) (e + 1) * xj; }
+
+struct Fixture {
+    bl::Channel ch;
+    std::atomic<int> mode{kNormal};
+    std::atomic<int> last_req_mode{-1};     // the out_mode main asked for on the last request
+    std::vector<float> last_weights;        // the channel's weights region as the helper saw it
+    std::thread th;
+    RemoteExperts re;
+    std::unique_ptr<RemoteExpertOpt> opt;
+    std::vector<float> sum_mem = std::vector<float>((size_t) MAXT * (H + K), 0.0f);
+    strata::core::ExpertCache primary;
+    strata::core::FileExpertSource src;
+    std::string err;
+
+    Fixture(const char* tag, bool with_opt) {
+        const std::string name = std::string("/rebl") + std::to_string(getpid()) + tag;
+        std::string e;
+        if (!ch.create(name, H, (int64_t) MAXT * K, NL, NE, (uint32_t) MAXT, (int64_t) strata::kernels::cpu::expert_layout().max_blob, e)) {
+            std::printf("create failed: %s\n", e.c_str()); std::exit(2);
+        }
+        ch.header()->free_gib = 8.0;
+        std::strcpy(ch.header()->helper_name, "fake-helper");
+        ch.header()->state.store(bl::kHelperUp, std::memory_order_release);
+        th = std::thread([this] { serve(); });
+        setenv("SEABRAID_STRATA_SHM", name.c_str(), 1);
+        if (with_opt) { opt = std::make_unique<RemoteExpertOpt>(); opt->attach(re); opt->init_host_only(sum_mem.data()); }
+        std::vector<std::pair<int32_t, int32_t>> ranked;
+        for (int e2 : {2, 3, 5, 7, 9}) ranked.emplace_back(LAYER, e2);
+        std::vector<uint8_t> claimed((size_t) NL * NE, 0);
+        if (!re.open(bl::kDeviceBase, 5, NL, NE, ranked, primary, src, claimed, err, false)) {
+            std::printf("open failed: %s\n", err.c_str()); std::exit(2);
+        }
+    }
+    ~Fixture() {
+        re.close();   // sets kShutdown, which ends the helper loop
+        ch.header()->state.store(bl::kShutdown, std::memory_order_release);
+        th.join();
+    }
+    void serve() {
+        bl::Header* hd = ch.header();
+        while (hd->state.load(std::memory_order_acquire) != bl::kPlanReady) {
+            if (hd->state.load() == bl::kShutdown) return;
+            usleep(200);
+        }
+        for (int64_t i = 0; i < hd->plan_count; ++i) ch.held()[(size_t) ch.plan()[2 * i] * NE + (size_t) ch.plan()[2 * i + 1]] = 1;
+        hd->resident = hd->plan_count; hd->gib = 0.1;
+        hd->resp_seq.store(hd->req_seq.load(), std::memory_order_release);
+        hd->state.store(bl::kLoaded, std::memory_order_release);
+        uint64_t seen = hd->req_seq.load();
+        while (hd->state.load(std::memory_order_acquire) != bl::kShutdown) {
+            if (hd->req_seq.load(std::memory_order_acquire) == seen) { usleep(50); continue; }
+            seen = hd->req_seq.load(std::memory_order_acquire);
+            const int T = (int) hd->n_tok;
+            const bool per_token = hd->out_mode == bl::kOutPerToken;
+            last_req_mode = (int) hd->out_mode;
+            last_weights.assign(ch.weights(), ch.weights() + T * K);
+            float* out = ch.out();
+            if (per_token) {
+                for (int i = 0; i < T * H; ++i) out[i] = 0.0f;
+                for (int t = 0; t < T; ++t)
+                    for (int i = 0; i < K; ++i) {
+                        const int e = ch.ids()[t * K + i];
+                        if (e < 0) continue;
+                        for (int j = 0; j < H; ++j) out[t * H + j] += ch.weights()[t * K + i] * expert_val(e, ch.x()[t * H + j]);
+                    }
+            } else {   // per-pick: one UNWEIGHTED row per owned pick, at its pick index
+                for (int p = 0; p < T * K; ++p) {
+                    const int e = ch.ids()[p];
+                    if (e < 0) continue;
+                    for (int j = 0; j < H; ++j) out[(size_t) p * H + j] = expert_val(e, ch.x()[(p / K) * H + j]);
+                }
+            }
+            hd->ok = 1;
+            // A dishonest echo is how the mismatch tests make the helper misbehave.
+            hd->out_mode = mode == kAnswerPerPick ? bl::kOutPerPick : (per_token ? bl::kOutPerToken : bl::kOutPerPick);
+            hd->out_rows = mode == kWrongRows ? T + 1 : (per_token ? T : T * K);
+            hd->resp_seq.store(seen, std::memory_order_release);
+        }
+    }
+};
+
+struct Window {
+    int T;
+    std::vector<float> x, w;
+    std::vector<int32_t> ids;
+    explicit Window(int t) : T(t), x((size_t) t * H), w((size_t) t * K), ids((size_t) t * K) {
+        for (size_t i = 0; i < x.size(); ++i) x[i] = 0.25f + (float) (i % 5) * 0.5f;
+        // held by the helper: 2 3 5 7 9; the others (11..15) are foreign picks that the primary serves.
+        const int pool[K] = {2, 11, 3, 5, 12, 7, 9, 13, 14, 15};
+        for (int tk = 0; tk < t; ++tk)
+            for (int i = 0; i < K; ++i) {
+                ids[(size_t) tk * K + i] = tk == 1 ? pool[(i + 3) % K] : pool[i];
+                w[(size_t) tk * K + i] = 0.05f + 0.07f * (float) ((tk * K + i) % 9);   // distinct, nonzero, like a normalised router
+            }
+    }
+    static bool held(int e) { return e == 2 || e == 3 || e == 5 || e == 7 || e == 9; }
+};
+
+static double rel_err(const float* a, const std::vector<double>& ref) {
+    double worst = 0.0;
+    for (size_t i = 0; i < ref.size(); ++i) {
+        const double d = std::fabs((double) a[i] - ref[i]) / std::max(1.0, std::fabs(ref[i]));
+        worst = std::max(worst, d);
+    }
+    return worst;
+}
+
+int main() {
+    const int TB = 2, T = 3;   // a window of 3 tokens that starts at token 2 of the verify batch (token_begin != 0)
+    // ---- 1. per-token round trip with a token_begin offset
+    {
+        Fixture f("a", true);
+        Window win(T);
+        f.opt->begin(win.w.data(), TB, T);
+        std::string err;
+        CHECK(f.re.begin(LAYER, win.x.data(), win.ids.data(), T, K, nullptr, nullptr, err));
+        std::vector<float> rows((size_t) T * K * H, -7.0f);
+        CHECK(f.re.finish(rows.data(), err));
+        if (!err.empty()) std::printf("  err: %s\n", err.c_str());
+        f.opt->end();
+        CHECK(f.last_req_mode.load() == (int) bl::kOutPerToken);
+        // the weights region carries each HELPER-OWNED pick's router weight and 0 for the rest
+        bool wt_ok = f.last_weights.size() == (size_t) T * K;
+        for (int i = 0; wt_ok && i < T * K; ++i) wt_ok = f.last_weights[(size_t) i] == (Window::held(win.ids[(size_t) i]) ? win.w[(size_t) i] : 0.0f);
+        CHECK(wt_ok);
+        // the sum equals sum over the helper's picks of w * expert(x_t)
+        std::vector<double> ref((size_t) T * H, 0.0);
+        for (int t = 0; t < T; ++t)
+            for (int i = 0; i < K; ++i) {
+                const int e = win.ids[(size_t) t * K + i];
+                if (!Window::held(e)) continue;
+                for (int j = 0; j < H; ++j) ref[(size_t) t * H + j] += (double) win.w[(size_t) t * K + i] * expert_val(e, win.x[(size_t) t * H + j]);
+            }
+        CHECK(f.opt->sum_rows() == f.sum_mem.data() + (size_t) TB * H);
+        CHECK(rel_err(f.opt->sum_rows(), ref) < 1e-6);
+        // h_mask_ is set for exactly the helper's picks
+        const int32_t* mask = reinterpret_cast<const int32_t*>(f.sum_mem.data() + (size_t) MAXT * H) + TB * K;
+        bool mask_ok = true;
+        for (int i = 0; i < T * K; ++i) mask_ok = mask_ok && ((mask[i] != 0) == Window::held(win.ids[(size_t) i]));
+        CHECK(mask_ok);
+        CHECK(rows[0] == -7.0f);   // the per-pick destination is untouched in per-token mode
+    }
+    // ---- 2. the helper reports the wrong row count: an error, not partial data
+    {
+        Fixture f("b", true);
+        Window win(T);
+        f.mode = kWrongRows;
+        f.opt->begin(win.w.data(), TB, T);
+        std::string err;
+        CHECK(f.re.begin(LAYER, win.x.data(), win.ids.data(), T, K, nullptr, nullptr, err));
+        std::vector<float> rows((size_t) T * K * H);
+        CHECK(!f.re.finish(rows.data(), err));
+        CHECK(err.find("per-token request") != std::string::npos);
+        f.opt->end();
+        bool zero = true;   // nothing was accumulated
+        for (int i = 0; i < T * H; ++i) zero = zero && f.opt->sum_rows()[i] == 0.0f;
+        CHECK(zero);
+    }
+    // ---- 3. the helper answers per-pick to a per-token request: an error
+    {
+        Fixture f("c", true);
+        Window win(T);
+        f.mode = kAnswerPerPick;
+        f.opt->begin(win.w.data(), TB, T);
+        std::string err;
+        CHECK(f.re.begin(LAYER, win.x.data(), win.ids.data(), T, K, nullptr, nullptr, err));
+        std::vector<float> rows((size_t) T * K * H);
+        CHECK(!f.re.finish(rows.data(), err));
+        CHECK(err.find("out_mode") != std::string::npos);
+        f.opt->end();
+        bool zero = true;   // and nothing was accumulated from the wrong-shaped rows
+        for (int i = 0; i < T * H; ++i) zero = zero && f.opt->sum_rows()[i] == 0.0f;
+        CHECK(zero);
+    }
+    // ---- 4. no active RemoteExpertOpt window: the request is the old per-pick one and rows land at the pick indices
+    {
+        Fixture f("d", true);
+        Window win(T);
+        std::string err;
+        CHECK(f.re.begin(LAYER, win.x.data(), win.ids.data(), T, K, nullptr, nullptr, err));   // (no opt->begin: inactive)
+        std::vector<float> rows((size_t) T * K * H, -7.0f);
+        CHECK(f.re.finish(rows.data(), err));
+        CHECK(f.last_req_mode.load() == (int) bl::kOutPerPick);
+        bool ok = true;
+        for (int p = 0; p < T * K; ++p) {
+            const int e = win.ids[(size_t) p];
+            const float want = Window::held(e) ? expert_val(e, win.x[(size_t) (p / K) * H]) : -7.0f;
+            ok = ok && rows[(size_t) p * H] == want;
+        }
+        CHECK(ok);
+    }
+    // ---- 5. no RemoteExpertOpt at all (today's engine): per-pick, unchanged
+    {
+        Fixture f("e", false);
+        Window win(T);
+        std::string err;
+        CHECK(f.re.begin(LAYER, win.x.data(), win.ids.data(), T, K, nullptr, nullptr, err));
+        std::vector<float> rows((size_t) T * K * H, -7.0f);
+        CHECK(f.re.finish(rows.data(), err));
+        CHECK(f.last_req_mode.load() == (int) bl::kOutPerPick);
+        CHECK(rows[0] == (Window::held(win.ids[0]) ? expert_val(win.ids[0], win.x[0]) : -7.0f));
+    }
+    // ---- 6. per-pick request, wrong row count echoed: an ERROR, and the per-pick destination is left untouched
+    {
+        Fixture f("g", false);
+        f.mode = kWrongRows;
+        Window win(T);
+        std::string err;
+        CHECK(f.re.begin(LAYER, win.x.data(), win.ids.data(), T, K, nullptr, nullptr, err));
+        std::vector<float> rows((size_t) T * K * H, -7.0f);
+        CHECK(!f.re.finish(rows.data(), err));
+        CHECK(err.find("per-pick request") != std::string::npos);
+        bool untouched = true;
+        for (const float v : rows) untouched = untouched && v == -7.0f;
+        CHECK(untouched);
+    }
+    if (g_fail == 0) { std::printf("ALL OK\n"); return 0; }
+    std::printf("FAILED: %d\n", g_fail);
+    return 1;
+}
