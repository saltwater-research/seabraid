+    /// D7 call site (seabraid/retier_loop.hpp) reads these at a window boundary to snapshot the helper's residency for
+    /// the planner.  ENGINE THREAD ONLY: seabraid_retier rewrites bl_held_ on that thread, unsynchronised.
+    /// What the helper holds as this engine last adopted it: n_layers * n_expert, layer-major, nonzero = held.
+    const std::vector<uint8_t>& seabraid_held() const { return bl_held_; }
+    /// Helper slots a kTierLoad can still take: the slots the plan filled (the cache never grows past them) minus what
+    /// is held now, never negative.  Every SWAP keeps the count, so on a full helper this is 0 for good.
+    int64_t seabraid_free_slots() const;
+
 private:
     friend class RemoteExpertOpt;
