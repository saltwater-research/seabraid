diff --git a/src/core/remote_experts.cpp b/src/core/remote_experts.cpp
index 91bb382..50c3a7c 100644
--- a/src/core/remote_experts.cpp
+++ b/src/core/remote_experts.cpp
@@ -728,6 +728,12 @@ bool RemoteExperts::seabraid_retier(const seabraid::TierWireOp* ops, int32_t n,
     return true;
 }
 
+int64_t RemoteExperts::seabraid_free_slots() const {
+    int64_t held = 0;
+    for (const uint8_t v : bl_held_) held += v != 0;
+    return bl_resident_ > held ? bl_resident_ - held : 0;
+}
