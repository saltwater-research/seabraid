--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -11,6 +11,19 @@
 # the worst of both outcomes.
 cmake_minimum_required(VERSION 3.24)
 project(strata VERSION 0.1.61 LANGUAGES CXX)
+# seabraid: the helper wire (strata/seabraid/channel.hpp, channel_layout.hpp, expert_spec.hpp) is owned by Seabraid's
+# Strata adapter (adapters/strata/wire) and included from there, never copied into this tree: the engine's remote tier,
+# the helper and the adapter then compile one definition of the bytes they share.  Set before any target is defined.
+set(SEABRAID_WIRE_INCLUDE "" CACHE PATH "Seabraid adapters/strata/wire (empty: derived from SEABRAID_STRATA_SOURCE_DIR)")
+set(_seabraid_wire "${SEABRAID_WIRE_INCLUDE}")
+if(NOT _seabraid_wire AND SEABRAID_STRATA_SOURCE_DIR)
+  get_filename_component(_seabraid_wire "${SEABRAID_STRATA_SOURCE_DIR}/../../adapters/strata/wire" ABSOLUTE)
+endif()
+if(NOT EXISTS "${_seabraid_wire}/strata/seabraid/channel.hpp")
+  message(FATAL_ERROR "The seabraid channel header lives in Seabraid: set SEABRAID_STRATA_SOURCE_DIR (<seabraid>/compat/strata) "
+                      "or SEABRAID_WIRE_INCLUDE (<seabraid>/adapters/strata/wire)")
+endif()
+include_directories("${_seabraid_wire}")
 include(${CMAKE_CURRENT_SOURCE_DIR}/cmake/strata_geometry.cmake)   # -DSTRATA_GEOMETRY=<name>: the model shape the kernels are compiled for (default flash_next, no flag added)
 # The build is cut by backend (cleanup 5.4): each file below only DEFINES macros (strata_<part>()), which run here, in this scope, at the place their
 # block used to be - so this file reads in the order the old single CMakeLists.txt evaluated.
@@ -815,3 +828,11 @@ if(STRATA_BUILD_TESTS)
 else()
   message(STATUS "strata tests: OFF (STRATA_BUILD_TESTS=OFF)")
 endif()
+
+# External expert helpers (seabraid): an out-of-process helper serves the remote expert tier over a
+# shared-memory channel (include/strata/seabraid/channel.hpp), so a GPU of another vendor can hold experts.  The helper's own
+# sources live in the seabraid checkout; empty = not built.
+set(SEABRAID_STRATA_SOURCE_DIR "" CACHE PATH "seabraid checkout that provides the external expert helper (empty: none)")
+if(SEABRAID_STRATA_SOURCE_DIR AND TARGET strata)
+  add_subdirectory("${SEABRAID_STRATA_SOURCE_DIR}/strata-ext" "${CMAKE_BINARY_DIR}/seabraid-strata-ext")
+endif()
