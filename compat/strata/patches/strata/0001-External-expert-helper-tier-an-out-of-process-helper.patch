+
+// ---- v4 live re-tiering (D7): the helper applies the main engine's LOAD / SWAP ops to its own cache --------
+bool RemoteExperts::tier_apply(const seabraid::TierWireOp& op, ExpertSource& source, std::string& err) {
+    if (bl_ != nullptr) {
+        err = "tier_apply is the HELPER side: the main engine drives re-tiering over the channel, not here";
+        return false;
+    }
+    // A sealed cache refuses admits silently and ABORTS on a fill (sealed_write is [[noreturn]]), so it is
+    // checked here rather than discovered by taking the helper process down.  Nothing seals the helper's
+    // cache today -- the seal() calls are the main engine's -- and this keeps it that way loudly.
+    if (cache_.sealed()) {
+        err = "tier_apply: this cache is sealed; nothing can be admitted or filled after the startup fill";
+        return false;
+    }
+    // Free capacity is reported to the policy as ONE number.  Per-layer admission would make it per layer,
+    // and a single count would silently mis-plan, so refuse rather than plan against a fiction.
+    if (cache_.per_layer_admission()) {
+        err = "tier_apply: per-layer admission is on, so free capacity is per layer and a single free-slot "
+              "count cannot describe it";
+        return false;
+    }
+    const auto& lay = strata::kernels::cpu::expert_layout();
+    DeviceScope scope(device_);
+    if (!scope.ok) { err = scope.error(device_); return false; }
+
+    int32_t slot = kNotResident;
+    if (op.kind == seabraid::kTierLoad) {
+        slot = cache_.admit(op.layer_new, op.expert_new);
+        if (slot < 0) {
+            err = "tier_apply: LOAD but the cache is full; ExpertCache never evicts, so there is no slot to take";
+            return false;
+        }
+    } else if (op.kind == seabraid::kTierSwap) {
+        // Cross-layer is representable on the wire and refused here: replace() moves a residency entry
+        // WITHIN one layer, and a cross-layer move needs a relocate() the cache does not have.
+        if (op.layer_old != op.layer_new) {
+            err = "tier_apply: cross-layer SWAP is not implemented (ExpertCache::replace is same-layer)";
+            return false;
+        }
+        slot = cache_.slot_of(op.layer_old, op.expert_old);
+        if (slot < 0) { err = "tier_apply: SWAP but the displaced expert is not resident here"; return false; }
+    } else {
+        err = "tier_apply: unknown op kind " + std::to_string((int) op.kind);
+        return false;
+    }
+
+    // Size the copy against THIS SLOT.  With open_sized each slot is the blob size of the layer that claimed
+    // it, so a bigger layer's expert would overrun into the next slot's weights -- silent corruption rather
+    // than a fault.  Checked here independently of whatever the fill path does with its own clamp.
+    const int64_t need = (int64_t) lay.blob_bytes(op.layer_new);
+    const int64_t room = (int64_t) cache_.slot_room(slot);
+    if (need > room) {
+        err = "tier_apply: layer " + std::to_string(op.layer_new) + " needs " + std::to_string(need) +
+              " bytes but slot " + std::to_string(slot) + " has room for " + std::to_string(room);
+        return false;
+    }
+    const uint8_t* blob = source.blob(op.layer_new, op.expert_new);
+    if (blob == nullptr) {
+        err = "tier_apply: the source has no blob for layer " + std::to_string(op.layer_new) + " expert " +
+              std::to_string(op.expert_new);
+        return false;
+    }
+    if (!cache_.fill_slot(slot, blob, stream_, err, need)) return false;
+    source.note_async_read(blob, stream_);   // #1237: the source must not free the host buffer mid-DMA
+    // A LOAD's residency is already published by admit().  A SWAP's is not, and must not be until the bytes
+    // have landed: a lookup in between would find the slot still holding the displaced expert's data.
+    if (op.kind == seabraid::kTierSwap) tier_queued_.push_back(op);
+    return true;
+}
+
+bool RemoteExperts::tier_sync(std::string& err) {
+    DeviceScope scope(device_);
+    if (!scope.ok) { err = scope.error(device_); tier_queued_.clear(); return false; }
+    // Always drain, even with nothing queued: a LOAD leaves a fill in flight with no deferred replace, and
+    // acking before it lands lets the main engine route to an expert whose bytes have not arrived.
+    if (!check(cudaStreamSynchronize(stream_), "cudaStreamSynchronize", err, device_)) {
+        // The copies did not complete, so publishing would point residency at bytes that may never arrive.
+        // Leaving the displaced experts resident is the safe side: their data is still there.
+        tier_queued_.clear();
+        return false;
+    }
+    for (const auto& op : tier_queued_) cache_.replace(op.layer_old, op.expert_old, op.expert_new);
+    tier_queued_.clear();
+    return true;
+}
+
+// ---- seabraid: the tier lives in a helper process (another GPU vendor), reached over shared memory -------------
+bool RemoteExperts::seabraid_open(int slots, int64_t layers, int64_t experts,
+                                 const std::vector<std::pair<int32_t, int32_t>>& ranked, const ExpertCache& primary,
+                                 std::vector<uint8_t>& claimed, std::string& err, bool auto_size) {
+    if (remote_opt_) { err = "seabraid: --remote-expert-opt is not supported with a helper process"; device_ = -1; return false; }
+    if (slots <= 0 || ranked.empty() || layers <= 0 || experts <= 0 ||
+        claimed.size() != (size_t) layers * (size_t) experts) {
+        err = "seabraid: need ranked experts and a positive slot count"; device_ = -1; return false;
+    }
+    const char* name = std::getenv("SEABRAID_STRATA_SHM");
+    auto ch = std::make_unique<seabraid::Channel>();
+    if (!ch->connect(name ? name : "/seabraid0", H, CAP, layers, experts, (uint32_t) strata::kernels::kWindowMaxT, err)) {
+        device_ = -1; return false;
+    }
+    seabraid::Header* hd = ch->header();
+    {   // kHelperUp: fresh.  kLoaded / kFailed: an earlier engine died without kShutdown; the helper reloads on a new plan.
+        const uint32_t st = hd->state.load(std::memory_order_acquire);
+        if (st != seabraid::kHelperUp && st != seabraid::kLoaded && st != seabraid::kFailed) {
+            err = "seabraid: the helper is not ready for a plan (state " + std::to_string(st) + "); restart seabraid-helper";
+            device_ = -1; return false;
+        }
+        if (st != seabraid::kHelperUp) std::fprintf(stderr, "seabraid: the helper still held an earlier engine's plan; replacing it\n");
+    }
+    // The same selection as the in-process tier: ranked order, nothing the primary or another tier holds.
+    const auto& lay = strata::kernels::cpu::expert_layout();
+    const uint64_t free_bytes = (uint64_t) (hd->free_gib * 1073741824.0);
+    uint64_t needed = 0;
+    std::vector<uint8_t> picked(claimed.size(), 0);
+    int32_t* plan = ch->plan();
+    int64_t count = 0;
+    for (const auto& pair : ranked) {
+        if (pair.first < 0 || pair.first >= layers || pair.second < 0 || pair.second >= experts) continue;
+        const size_t index = (size_t) pair.first * (size_t) experts + (size_t) pair.second;
+        if (primary.slot_of(pair.first, pair.second) >= 0 || claimed[index] || picked[index]) continue;
+        const uint64_t bytes = lay.native ? (lay.blob_bytes(pair.first) + 255) / 256 * 256 : lay.max_blob;
+        if (auto_size && needed + bytes + (512ull << 20) > free_bytes) break;
+        plan[2 * count] = pair.first;
+        plan[2 * count + 1] = pair.second;
+        ++count;
+        needed += bytes;
+        picked[index] = 1;
+        if (count >= slots) break;
+    }
+    if (count == 0) { err = "seabraid: no unclaimed expert fits the helper"; device_ = -1; return false; }
+    hd->plan_count = count;
+    hd->plan_slots = count;
+    hd->plan_auto = auto_size ? 1 : 0;
+    hd->state.store(seabraid::kPlanReady, std::memory_order_release);
+    std::fprintf(stderr, "seabraid: sent a plan of %lld experts (%.2f GiB) to %s; waiting for it to load\n",
+                 (long long) count, (double) needed / 1073741824.0, hd->helper_name);
+    if (!seabraid::Channel::wait([&] { const uint32_t st = hd->state.load(std::memory_order_acquire);
+                                       return st == seabraid::kLoaded || st == seabraid::kFailed; }, 1800)) {
+        err = "seabraid: the helper did not finish loading in 30 minutes"; device_ = -1; return false;
+    }
+    if (hd->state.load() == seabraid::kFailed) { err = std::string("seabraid helper: ") + hd->msg; device_ = -1; return false; }
+    bl_held_.assign(ch->held(), ch->held() + (size_t) layers * (size_t) experts);
+    bl_resident_ = hd->resident;
+    bl_gib_ = hd->gib;
+    layers_present_.assign((size_t) layers, 0);
+    for (int64_t l = 0; l < layers; ++l)
+        for (int64_t e = 0; e < experts; ++e)
+            if (bl_held_[(size_t) l * (size_t) experts + (size_t) e]) {
+                layers_present_[(size_t) l] = 1;
+                claimed[(size_t) l * (size_t) experts + (size_t) e] = 1;
+            }
+    owned_.resize(CAP);
+    original_row_.reserve(CAP);
+    computed_ = 0; launched_layers_ = 0; returned_bytes_ = full_row_bytes_ = 0;
+    bl_seq_ = hd->req_seq.load(std::memory_order_acquire);
+    bl_blob_seq_ = hd->blob_req_seq.load(std::memory_order_acquire);
+    bl_pending_ = false;
+    {   // the channel's blob slots must hold this engine's largest blob
+        int64_t need = 0;
+        for (int64_t l = 0; l < layers; ++l) need = std::max<int64_t>(need, (int64_t) lay.blob_bytes(l));
+        if (hd->blob_max < need) { err = "seabraid: the helper's blob slots are smaller than this model's blobs"; device_ = -1; return false; }
+    }
+    bl_thread_ = std::this_thread::get_id();   // the fence asserts against this
+    bl_ = std::move(ch);
+    return true;
+}
+
+bool RemoteExperts::seabraid_helper_begin(int64_t layer, const float* x, const int32_t* ids, int64_t n_tok, int64_t k,
+                                  const int32_t* kind, const int32_t* primary_res, std::string& err) {
+    const int64_t n = n_tok * k;
+    if (n <= 0 || n > CAP || n_tok > strata::kernels::kWindowMaxT || k != 10 || layer < 0 ||
+        (size_t) layer >= layers_present_.size()) {
+        err = "seabraid experts: invalid layer, routing width or window size";
+        return false;
+    }
+    if (bl_fenced_) {   // a tier round is moving experts between slots; see seabraid_retier
+        err = "seabraid experts: a layer request was published during a tier round";
+        return false;
+    }
+    if (bl_pending_ && !seabraid_helper_finish(nullptr, err)) return false;   // never overwrite a request in flight
+    std::fill(owned_.begin(), owned_.begin() + n, 0);
+    original_row_.clear();
+    if (!layers_present_[(size_t) layer]) return true;
+    int32_t* sid = bl_->ids();
+    for (int64_t i = 0; i < n; ++i) {
+        const int32_t e = ids[i];
+        sid[i] = -1;
+        if ((kind && kind[i] != -1) || e < 0 || e >= n_expert_ ||
+            (primary_res && primary_res[(size_t) layer * (size_t) n_expert_ + (size_t) e] >= 0)) continue;
+        if (!holds(layer, e)) continue;
+        owned_[(size_t) i] = 1;
+        sid[i] = e;
+        original_row_.push_back((int32_t) i);
+    }
+    if (original_row_.empty()) return true;
+    std::memcpy(bl_->x(), x, (size_t) n_tok * H * sizeof(float));
+    seabraid::Header* hd = bl_->header();
+    hd->layer = layer; hd->n_tok = n_tok; hd->k = k;
+    hd->req_seq.store(++bl_seq_, std::memory_order_release);
+    bl_pending_ = true;
+    computed_ += (int64_t) original_row_.size();
+    ++launched_layers_;
+    returned_bytes_ += (uint64_t) original_row_.size() * H * sizeof(float);
+    full_row_bytes_ += (uint64_t) n * H * sizeof(float);
+    return true;
+}
+
+bool RemoteExperts::seabraid_helper_finish(float* out, std::string& err) {
+    if (!bl_pending_) return true;
+    const auto w0 = std::chrono::steady_clock::now();
+    seabraid::Header* hd = bl_->header();
+    if (!seabraid::Channel::wait([&] { return hd->resp_seq.load(std::memory_order_acquire) == bl_seq_; }, 30)) {
+        err = "seabraid: the helper did not answer layer " + std::to_string(hd->layer) + " within 30 s";
+        return false;
+    }
+    bl_pending_ = false;
+    ms_wait_ += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - w0).count();
+    if (!hd->ok) { err = std::string("seabraid helper: ") + hd->err; return false; }
+    if (out == nullptr) return true;
+    const float* src = bl_->out();
+    for (const int32_t row : original_row_)
+        std::memcpy(out + (size_t) row * H, src + (size_t) row * H, (size_t) H * sizeof(float));
+    return true;
+}
+
+
+bool RemoteExperts::seabraid_retier(const seabraid::TierWireOp* ops, int32_t n, uint8_t* res,
+                                   std::vector<uint8_t>* claimed, std::string& err) {
+    if (!bl_) { err = "seabraid retier: no helper channel is open"; return false; }
+    if (ops == nullptr || n <= 0 || n > seabraid::kTierMaxOps) {
+        err = "seabraid retier: " + std::to_string((long long) n) + " ops, but a round carries 1.." +
+              std::to_string((long long) seabraid::kTierMaxOps);
+        return false;
+    }
+    // ENGINE THREAD ONLY.  This reads and clears bl_pending_, which is a plain bool with no synchronisation,
+    // and it is CHECKED rather than commented because a comment has no way to fail.
+    if (std::this_thread::get_id() != bl_thread_) {
+        err = "seabraid retier: called off the engine thread, whose request state it modifies unsynchronised";
+        return false;
+    }
+    if (bl_fenced_) { err = "seabraid retier: re-entered while a tier round was already open"; return false; }
+
+    // (1) Drain.  A request still in flight would be answered out of a slot that is about to move, and that
+    // reply is well-formed and numerically wrong -- nothing in the protocol can detect it.
+    if (bl_pending_ && !seabraid_helper_finish(nullptr, err)) return false;
+
+    // (2) Close admission for the duration, on every exit path including the error ones.
+    bl_fenced_ = true;
+    struct Reopen { bool* flag; ~Reopen() { *flag = false; } } reopen{&bl_fenced_};
+
+    const uint64_t seq = bl_->tier_submit(ops, n);
+    bl_tier_seq_ = seq;
+    if (!seabraid::Channel::wait([&] { return bl_->tier_done(seq); }, 60)) {
+        err = "seabraid retier: the helper did not finish tier round " +
+              std::to_string((unsigned long long) seq) + " within 60 s";
+        return false;
+    }
+
+    // (3) Per-op results first, before anything is believed about residency.
+    seabraid::Header* hd = bl_->header();
+    const int32_t got = hd->tier_n < n ? hd->tier_n : n;
+    if (res != nullptr) {
+        for (int32_t i = 0; i < got; ++i) res[i] = hd->tier_res[i];
+        for (int32_t i = got; i < n; ++i) res[i] = (uint8_t) seabraid::kTierPending;
+    }
+    const bool ok = hd->tier_ok != 0;
+    hd->tier_err[sizeof(hd->tier_err) - 1] = '\0';
+    const std::string why = ok ? std::string() : std::string(hd->tier_err);
+
+    // (4) Refresh the local view from the helper's, WHATEVER the outcome: a partly applied round still moved
+    // experts, so bailing out early would leave this engine routing to slots that no longer hold them.
+    const size_t cells = layers_present_.size() * (size_t) n_expert_;
+    if (cells > 0 && bl_held_.size() == cells) {
+        const std::vector<uint8_t> prev = bl_held_;
+        std::memcpy(bl_held_.data(), bl_->held(), cells);
+        const bool publish = claimed != nullptr && claimed->size() == cells;
+        for (size_t l = 0; l < layers_present_.size(); ++l) {
+            uint8_t any = 0;
+            for (size_t e = 0; e < (size_t) n_expert_; ++e) {
+                const size_t i = l * (size_t) n_expert_ + e;
+                any |= bl_held_[i];
+                // Publish only the DELTA.  `claimed` also carries the primary's own claims, so assigning the
+                // helper's residency over it would silently release experts this engine still holds.  This
+                // is the seam the adaptive layer reads (STRATA_DISJOINT_ADAPT); it was written when the
+                // helper plan was static, and left stale both cards claim the same expert after one swap.
+                if (publish && prev[i] != bl_held_[i]) (*claimed)[i] = bl_held_[i];
+            }
+            layers_present_[l] = any;
+        }
+    }
+
+    // (5) Only now move the epoch.  It advertises a placement this engine has already adopted, so a request
+    // published after it cannot be describing the old one.
+    bl_->bump_epoch();
+
+    if (!ok) {
+        err = "seabraid retier: the helper refused at least one op" +
+              (why.empty() ? std::string() : ": " + why);
+        return false;
+    }
+    return true;
+}
